type P
    a: text
task g(p: P) -> P
    var x = p
    x.a = "{x.a}!"
    return x
var v = P(a: "s")
v = g(g(v))
print v.a
print g(v).a.len()
choice E
    A
    B
var e = A
match e
    A ->
        e = B
        match e
            B -> print "b"
            A -> print "a"
    B -> print "x"
task none_arm(e: E)
    match e
        A -> return
        B -> print "b"
none_arm(A)
none_arm(B)
let u = match e
    A -> 1
    B -> 2
print u
task inf(e: E) -> int
    let u = match e
        A -> return 1
        B -> return 2
print inf(A)
