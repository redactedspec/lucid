# The Lucid compiler, written in Lucid, by decision 214. It ports the Rust
# front end one stage at a time, and each stage is checked against the Rust
# one by its dump, by decision 215. It runs `check`, also with `--costs`,
# `--unsafe`, and `LUCID_DUMP`, `run`, and `build`, which hand the program to
# the Rust backend through its C ABI, by decision 217. See "Self-hosting" in
# docs/compiler.md.

use std.args
use std.env
use std.fs
use ./ast
use ./backend
use ./check
use ./diag
use ./dump
use ./lexer
use ./mir
use ./mono
use ./ownership
use ./parser
use ./resolve

## Why the compiler stops with exit code 1: the text it prints to stderr.
type Stop
    message: text

task error_message(self: Stop) -> text
    return self.message

task usage() -> Stop
    return Stop(message: "usage: lucid run [PATH [ARGUMENTS]]\n       lucid build [--target web] [--json] [PATH]\n       lucid check [--json] [--costs | --unsafe] [PATH]\nPATH is a file or a package directory, by default the current directory.")

task main() -> none or Stop
    let words = args.all()
    if words.len() == 0
        return usage()
    let command = words[0]
    var rest = words[1..words.len()]
    # What follows the path of `lucid run` belongs to the program.
    var program_args: list[text] = []
    if command == "run" and rest.len() > 0 and not rest[0].starts_with("-")
        program_args = rest[1..rest.len()]
        rest = rest[0..1]
    var path = "."
    if rest.len() > 0 and not rest[rest.len() - 1].starts_with("-")
        path = rest[rest.len() - 1]
        rest = rest[0..rest.len() - 1]
    let build = command == "build"
    # `--target web` comes first, so the flags below match as they do
    # without it.
    var web = false
    if build and rest.len() >= 2 and rest[0] == "--target" and rest[1] == "web"
        web = true
        rest = rest[2..rest.len()]
    let flags = join_flags(rest)
    var run = false
    var json = false
    var costs = false
    if command == "check" and (flags == "--unsafe" or flags == "--json --unsafe")
        try unsafe_sites(path, flags != "--unsafe")
        return none
    if (command == "run" or build) and flags is empty
        run = true
    else if build and flags == "--json"
        run = true
        json = true
    else if command == "check" and flags is empty
        json = false
    else if command == "check" and flags == "--json"
        json = true
    else if command == "check" and flags == "--costs"
        costs = true
    else if command == "check" and flags == "--json --costs"
        json = true
        costs = true
    else
        return usage()
    if costs
        try check_costs(path, json)
        return none
    var stage = ""
    if command == "check"
        stage = env.get("LUCID_DUMP") else ""
    if stage == "tokens" or stage == "ast"
        try dump_syntax(path, stage, json)
        return none
    if not (stage is empty or stage == "resolved" or stage == "checked" or stage == "mir" or stage == "owned")
        return Stop(message: "lucid: LUCID_DUMP must be tokens, ast, resolved, checked, mir, or owned")
    let found = resolve.load(path, run)
    if stage == "resolved"
        print dump.resolved(found)
        try finish(found.source, found.diags, json)
        return none
    var diags = found.diags
    let file = found.file
    if diags is empty and file is ast.File
        let checked = check.check(file, found, not run)
        diags = checked.diags
        var program = checked.program
        if stage == "checked"
            # The stage ends with the checker, as `resolved` ends with
            # loading.
            if diags is empty
                print dump.program(program)
            try finish(found.source, without_unbuilt(diags), json)
            return none
        if diags is empty
            diags = mono.run(change program, not run)
        if diags is empty and stage == "mir"
            print dump.program(program)
        if diags is empty and (run or stage == "owned")
            ownership.run(change program, env.get("LUCID_NAIVE") is none)
        if diags is empty and stage == "owned"
            print dump.owned(program, found)
        let web_only = found.web_only
        if run and not web and diags is empty and web_only is diag.Span
            let note = "build the program with `lucid build --target web`"
            diags.push(resolve.with_note("E0906", "`std.dom` works only in a browser", web_only, note))
        let host_only = found.host_only
        if web and diags is empty and host_only is resolve.TargetUse
            let note = "a page cannot reach the system, so build this program without `--target web`"
            let message = "`{host_only.module}` cannot run on the web"
            diags.push(resolve.with_note("E0907", message, host_only.span, note))
        if run and diags is empty
            let owned = dump.owned(program, found)
            var result = 0
            if web
                result = backend.build(owned, json, true, out_name(path, "js"))
            else if build
                result = backend.build(owned, json, false, out_name(path, exe_extension()))
            else
                result = backend.run(owned, false, program_args)
            # The backend has reported any problem.
            if result != 0
                backend.stop(1)
            return none
        if not run
            # `check` reports errors in the program. An unbuilt feature is
            # not one.
            diags = without_unbuilt(diags)
    try finish(found.source, diags, json)

task join_flags(flags: list[text]) -> text
    var out = ""
    for flag in flags
        out = if out is empty then flag else "{out} {flag}"
    return out

task without_unbuilt(diags: list[diag.Diagnostic]) -> list[diag.Diagnostic]
    var kept: list[diag.Diagnostic] = []
    for d in diags
        if d.code != "E0901"
            kept.push(d)
    return kept

# The extension of a built program: `exe` on Windows, none on Linux.
task exe_extension() -> text
    return if resolve.on_windows() then "exe" else ""

# What `lucid build` writes to the current directory: named after the file,
# or after the directory of the package, with this extension, if any.
task out_name(path: text, extension: text) -> text
    let windows = resolve.on_windows()
    var stem = ""
    if resolve.is_dir(path)
        let root = fs.real_path("{resolve.package_root(path, windows)}.") else ""
        var start = root.len()
        while start > 0 and not (root[start - 1..start] == "/" or (windows and root[start - 1..start] == "\\"))
            start -= 1
        stem = root[start..root.len()]
    else
        stem = resolve.file_stem(path, windows)
    if stem is empty
        stem = "main"
    if extension is empty
        return stem
    return "{stem}.{extension}"

# `lucid check --costs`: each place where the program pays for a count or a
# copy. It needs the ownership pass, so an unbuilt feature stays an error.
task check_costs(path: text, json: bool) -> none or Stop
    let found = resolve.load(path, false)
    var diags = found.diags
    let file = found.file
    if diags is empty and file is ast.File
        let checked = check.check(file, found, true)
        diags = checked.diags
        var program = checked.program
        if diags is empty
            diags = mono.run(change program, true)
        if diags is empty
            ownership.run(change program, env.get("LUCID_NAIVE") is none)
            show(ownership.render_costs(found.source, ownership.costs(program), json))
            return none
    try finish(found.source, diags, json)

# `lucid check --unsafe`: each `unsafe` block and `extern` task, in file
# order.
task unsafe_sites(path: text, json: bool) -> none or Stop
    let found = resolve.load(path, false)
    var diags = found.diags
    var sites: list[mir.UnsafeSite] = []
    let file = found.file
    if diags is empty and file is ast.File
        let checked = check.check(file, found, true)
        # As in `check`: an unbuilt feature is not an error in the program.
        for d in checked.diags
            if d.code != "E0901"
                diags.push(d)
        sites = checked.program.unsafe_sites
    if diags is empty
        show(ownership.render_unsafe(found.source, sites, json))
        return none
    try finish(found.source, diags, json)

# Prints text that ends with a line break, if it is not empty.
task show(out: text)
    if out is not empty
        print out[0..out.len() - 1]

# `LUCID_DUMP=tokens` or `ast` under `lucid check`: one file, with no imports.
task dump_syntax(path: text, stage: text, json: bool) -> none or Stop
    var source = diag.one(path, [])
    var diags: list[diag.Diagnostic] = []
    let read = fs.read_bytes(path)
    match read
        bytes: list[byte] ->
            let valid = valid_up_to(bytes)
            if valid < bytes.len()
                source = diag.one(path, bytes[0..valid])
                let at = diag.span(valid, valid)
                diags.push(diag.new("E0002", "file is not valid UTF-8", at))
            else
                source = diag.one(path, bytes)
                let content = fs.read_text(path) else ""
                let lexed = lexer.lex(bytes, content)
                diags = lexed.diags
                let parsed = parser.parse(lexed.tokens)
                diag.add_unless_same_line(source, change diags, parsed.diags)
                if stage == "tokens"
                    print dump.tokens(lexed.tokens)
                else
                    print dump.tree(parsed.file)
        e: fs.FileError ->
            let at = diag.span(0, 0)
            diags.push(diag.new("E0001", "cannot read `{path}`: {e.error_message()}", at))
    try finish(source, diags, json)

# Reports the diagnostics: with `--json` on stdout, and else as the message
# of the `Stop` that ends the compiler.
task finish(source: diag.Source, diags: list[diag.Diagnostic], json: bool) -> none or Stop
    report_errors(source, diags, json)
    if diags is not empty
        let shown = if json then "" else diag.render_text(source, diags)
        # The message ends without the last line break, which stderr adds.
        let message = if shown is empty then shown else shown[0..shown.len() - 1]
        return Stop(message: message)

task report_errors(source: diag.Source, diags: list[diag.Diagnostic], json: bool)
    if json
        let rendered = diag.render_json(source, diags)
        print rendered[0..rendered.len() - 1]

# How many bytes at the start of `bytes` are valid UTF-8, as Rust's
# `Utf8Error::valid_up_to` counts them.
task valid_up_to(bytes: list[byte]) -> int
    var at = 0
    let size = bytes.len()
    while at < size
        let b = bytes[at].to_int()
        var need = 0
        var low = 128
        var high = 191
        if b < 128
            need = 0
        else if b >= 194 and b <= 223
            need = 1
        else if b == 224
            need = 2
            low = 160
        else if (b >= 225 and b <= 236) or b == 238 or b == 239
            need = 2
        else if b == 237
            need = 2
            high = 159
        else if b == 240
            need = 3
            low = 144
        else if b >= 241 and b <= 243
            need = 3
        else if b == 244
            need = 3
            high = 143
        else
            return at
        for i in 1..need + 1
            if at + i >= size
                return at
            let next = bytes[at + i].to_int()
            if next < low or next > high
                return at
            low = 128
            high = 191
        at += need + 1
    return at

try main()
