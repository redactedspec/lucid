# Binds names, checks types, and lowers the syntax tree to MIR in one pass.
# Ports check.rs. A generic body is checked once, with its parameters as
# opaque types, and the monomorphizer makes the concrete tasks. The resolver
# has already joined the modules into one tree.

use ./ast
use ./diag
use ./mir
use ./resolve
use std.json

let JOIN_TEXT = "join text with interpolation: \"{{a}}{{b}}\""
let SQL_TEXT = "only a text literal with no `{{...}}` is a `sql` query: pass each value through a `?` mark"
let JOIN_SQL = "a `sql` query joins only text literals and other queries: pass each value through a `?` mark"
let TEST_UNION = "test it first, as in `if x is not none`. Only a name narrows, so name a field or call with `let`"

## The traits that the prelude declares, which no module can redefine.
public task prelude_traits() -> list[text]
    return ["Error"]

# Built-in type names with one form of their own, which `named` checks.
task later_types() -> list[text]
    return ["pointer"]

# Type names that a program cannot define for itself, beyond `number_type`.
task built_in_types() -> list[text]
    return ["bool", "text", "sql", "list", "map", "set", "spawned", "channel", "lock"]

# The same limit as nesting in the parser, for a chain of aliases.
task max_aliases() -> int
    return 128

# How many instances of generic types the E0315 check follows, and how many
# questions one trait check asks.
task max_finite_check() -> int
    return 256

## Traits that the compiler knows, and that a bound can name.
public task built_in_traits() -> list[text]
    return ["Equal", "Order", "Show", "Hash", "Add", "Sub", "Mul", "Div", "Json"]

# Traits in the spec that are not built yet.
task later_traits() -> list[text]
    return ["Copy"]

# Dot calls that change their receiver, so they only work as statements, or
# for `pop`, as the whole value of one.
task changing_calls() -> list[text]
    return ["push", "swap", "add", "remove", "pop"]

# Dot calls on a channel or a lock that must be statements.
task thread_calls() -> list[text]
    return ["send", "receive", "close", "update"]

task skip()
    return

task json_holds(ty: mir.Ty) -> bool
    return match ty
        MapTy(key, _) -> key == mir.TextTy
        AnyTy(_) -> false
        TaskTy(_, _) -> false
        _ -> not ty.is_handle()

task is_alias(named: Named) -> bool
    return match named
        AliasNamed(_, _) -> true
        _ -> false

task is_literal_top(top: Top) -> bool
    return match top
        LiteralTop(_, _) -> true
        _ -> false

task has_text(items: list[text], item: text) -> bool
    for known in items
        if known == item
            return true
    return false

task has_int(items: list[int], item: int) -> bool
    for known in items
        if known == item
            return true
    return false

## Type parameters in scope, with the type that each one stands for.
type EnvEntry
    name: text
    ty: mir.Ty

# A written type name.
choice Named
    KnownNamed(ty: mir.Ty)
    # A `type` or `choice` with type parameters.
    GenericNamed(id: int)
    # Replaced by `KnownNamed` once resolved, unless it has type parameters.
    AliasNamed(target: ast.Type, params: list[ast.TypeParam])

type SigParam
    name: text
    ty: mir.Ty
    default: mir.Expr?
    # "Read", "Change", or "Take".
    mode: text

type Signature
    name: ast.Name
    is_public: bool
    type_params: list[EnvEntry]
    bounds: list[list[text]]
    # A task of a trait: it has no body, and `self` has no type here.
    in_trait: bool
    params: list[SigParam]
    returns: mir.Ty

# A `type`, which has one variant with its own name, or a `choice`.
type Data
    name: ast.Name
    # With its own parameters as type arguments.
    ty: mir.Ty
    type_params: list[EnvEntry]
    bounds: list[list[text]]
    is_choice: bool
    variants: list[DataVariant]

type DataVariant
    name: text
    # In written order, which is what a pattern binds.
    fields: list[DataField]

type DataField
    name: text
    # Uses the type parameters of its `type` or `choice`.
    ty: mir.Ty
    default: mir.Expr?

task shape(self: Data) -> mir.Shape
    var variants: list[mir.ShapeVariant] = []
    for variant in self.variants
        var fields: list[mir.ShapeField] = []
        var defaults: list[mir.Expr?] = []
        for field in variant.fields
            fields.push(mir.ShapeField(name: field.name, ty: field.ty))
            defaults.push(field.default)
        variants.push(mir.ShapeVariant(name: variant.name, fields: fields, defaults: defaults))
    return mir.Shape(variants: variants, is_choice: self.is_choice)

# A field as written: its name, type, default, and whether it has the plain
# form. A variant's fields use the task parameter grammar, which allows more.
type WrittenField
    name: ast.Name
    ty: ast.Type?
    default: ast.Expr?
    plain: bool

type WrittenVariant
    data: int
    variant: int
    fields: list[WrittenField]

type AliasDecl
    name: text
    target: ast.Type
    params: list[ast.TypeParam]
    span: diag.Span

# What the arms of a `match` have covered so far.
type Covered
    # An arm matches anything.
    all: bool = false
    # An arm is already reported, so a gap may be its doing.
    failed: bool = false
    # The variants of a `choice`, or the type ids of a union.
    variants: list[int] = []
    literals: list[text] = []

# What a task can see of a top-level `let` or `var`.
choice Top
    VarTop
    # A `let` with a literal value, which is known before any statement
    # runs, and its annotation.
    LiteralTop(value: ast.Expr, ty: ast.Type?)
    LetTop

type Deferred
    ty: mir.Ty
    name: text
    span: diag.Span
    bounds: list[list[text]]

type VariantRef
    data: int
    variant: int

type ForeignForm
    params: list[mir.Ty]
    returns: mir.Ty

# A path that a `for` visits. A plain `for` lets the body read it. `for
# change` has taken it out, so the body cannot touch it at all.
type Busy
    local: int
    path: list[text]
    exclusive: bool

# A path passed as `change`, and the code that may use it in that statement.
type Changed
    root: text
    path: list[text]
    span: diag.Span
    peers: list[diag.Span]

type KeptError
    local: int
    span: diag.Span

type LoopScope
    depth: int
    # The loop name, or -1.
    keep: int
    held: int

type Narrowed
    local: int
    ty: mir.Ty

type CaptureEntry
    name: text
    value: mir.Expr

type Opened
    local: int
    slot: int
    held: int

type SpawnSite
    local: int
    span: diag.Span

# What belongs to one task while it is checked. A lambda or nested task gets
# a new one, and the one around it waits in `Checker.frames`.
type Frame
    scopes: list[map[text, int]] = []
    locals: list[mir.Ty] = []
    # Where each local's name is written. A hidden local has an empty span.
    spans: list[diag.Span] = []
    mutable: list[bool] = []
    # The return type, or `none` at top level.
    returns: mir.Ty? = none
    in_unsafe: bool = false
    in_test: bool = false
    open_result: bool = false
    held: list[int] = []
    kept_errors: list[KeptError] = []
    loop_scopes: list[LoopScope] = []
    narrowed: list[Narrowed] = []
    captures: list[CaptureEntry] = []
    own_name: text? = none
    params: int = 0
    busy: list[Busy] = []
    changed: list[Changed] = []
    opening: bool = false
    opened: list[Opened] = []
    spawns: SpawnSite? = none

type Checker
    src: list[byte]
    files: list[diag.SourceFile]
    no_unsafe: list[resolve.NoUnsafe]
    packages: list[resolve.FilePackage]
    diags: list[diag.Diagnostic] = []
    # The ids of `extern` tasks.
    foreign: list[int] = []
    unsafe_sites: list[mir.UnsafeSite] = []
    task_ids: map[text, int] = {}
    signatures: list[Signature] = []
    types: map[text, Named] = {}
    type_params: list[EnvEntry] = []
    bounds: list[list[text]] = []
    methods: map[text, list[int]] = {}
    traits: map[text, list[int]] = {}
    trait_spans: map[text, diag.Span] = {}
    ready: bool = false
    deferred: list[Deferred] = []
    datas: list[Data] = []
    constructors: map[text, VariantRef] = {}
    constructor_names: map[text, bool] = {}
    symbols: map[text, ForeignForm] = {}
    written_hashes: list[mir.Ty] = []
    resolving: list[text] = []
    top: map[text, Top] = {}
    table: mir.Types
    frame: Frame
    frames: list[Frame] = []
    lifted: list[mir.Task] = []
    first_lifted: int = 0
    task_values: map[int, int] = {}

## What `check` gives: the program, and the diagnostics.
public type Checked
    program: mir.Program
    diags: list[diag.Diagnostic]

## Checks a program. A program using an unbuilt feature gets only E0901,
## because names and types that feature would supply make any other error
## unreliable. With `keep_tests` false, `test` blocks are dropped unread.
public task check(file: ast.File, found: resolve.Resolved, keep_tests: bool) -> Checked
    var c = Checker(src: found.source.bytes, files: found.source.files, no_unsafe: found.no_unsafe, packages: found.packages, table: mir.Types(ids: []), frame: Frame())
    c.declare_types(file)
    c.declare(file)
    var written: list[ast.Stmt] = []
    var blocks: list[ast.Stmt] = []
    for item in file.stmts
        match item.kind
            TaskStmt(_) -> written.push(item)
            TestStmt(_, _) ->
                if keep_tests
                    blocks.push(item)
            _ ->
                continue
    let first_test = written.len()
    c.first_lifted = first_test + blocks.len()
    var tasks: list[mir.Task] = []
    for id in 0..written.len()
        let item = written[id]
        match item.kind
            TaskStmt(def) ->
                let body = def.body
                if body is list[ast.Stmt]
                    tasks.push(c.check_task(id, def, body, item.span))
                else
                    tasks.push(c.foreign_task(id, def, item.span))
            _ ->
                continue
    var tests: list[mir.TestCase] = []
    for item in blocks
        match item.kind
            TestStmt(name, body) ->
                let text = c.test_name(name, tests)
                let id = first_test + tests.len()
                tasks.push(c.check_test(text, body, item.span))
                tests.push(mir.TestCase(name: text, id: id, span: item.span))
            _ ->
                continue
    let main = c.main(file)
    for t in c.lifted
        tasks.push(t)
    var datas: list[mir.Shape] = []
    for data in c.datas
        datas.push(data.shape())
    var diags = c.diags
    var unbuilt = false
    for d in diags
        if d.code == "E0901"
            unbuilt = true
    if unbuilt
        var kept: list[diag.Diagnostic] = []
        for d in diags
            if d.code == "E0901"
                kept.push(d)
        diags = kept
    let program = mir.Program(tasks: tasks, tests: tests, unsafe_sites: c.unsafe_sites, main: main, types: c.table, datas: datas, methods: c.methods)
    return Checked(program: program, diags: diags)

# The parameters that a declaration brings into scope, by position.
task own_params(params: list[ast.TypeParam]) -> list[EnvEntry]
    var out: list[EnvEntry] = []
    for i in 0..params.len()
        let name = params[i].name.text
        out.push(EnvEntry(name: name, ty: mir.ParamTy(name: name, index: i)))
    return out

task env_types(env: list[EnvEntry]) -> list[mir.Ty]
    var out: list[mir.Ty] = []
    for entry in env
        out.push(entry.ty)
    return out

# The number type of a written name. `i64` and `u8` are other names for
# `int` and `byte`, so each size has one type. See decision 79.
task number_type(name: text) -> mir.Ty?
    if name == "int" or name == "i64"
        return mir.IntTy
    if name == "float"
        return mir.FloatTy
    if name == "byte" or name == "u8"
        return mir.ByteTy
    if name == "i8"
        return mir.I8Ty
    if name == "i16"
        return mir.I16Ty
    if name == "i32"
        return mir.I32Ty
    if name == "u16"
        return mir.U16Ty
    if name == "u32"
        return mir.U32Ty
    if name == "u64"
        return mir.U64Ty
    if name == "f32"
        return mir.F32Ty
    return none

# The number type that a task such as `to_i32` gives, on another number type.
task conversion(ty: mir.Ty, name: text) -> mir.Ty?
    if not name.starts_with("to_") or not ty.is_number()
        return none
    let target = number_type(name[3..name.len()])
    if target is mir.Ty and target != ty
        return target
    return none

# The operator of a task such as `wrapping_add`, on an integer type.
task wrapping_op(ty: mir.Ty, name: text) -> text
    if not ty.is_integer()
        return ""
    if name == "wrapping_add"
        return "Add"
    if name == "wrapping_sub"
        return "Sub"
    if name == "wrapping_mul"
        return "Mul"
    return ""

# True for a task that the language builds in for this type.
task builtin_method(ty: mir.Ty, name: text) -> bool
    if ty.is_float() and name == "sqrt"
        return true
    if ty.is_number()
        return conversion(ty, name) is not none or wrapping_op(ty, name) is not empty
    match ty
        TextTy -> return has_text(["len", "is_empty", "bytes", "split", "upper", "lower", "to_int", "starts_with", "ends_with", "contains", "find", "trim"], name)
        ListTy(item) ->
            if item == mir.ByteTy and name == "pointer"
                return true
            return has_text(["len", "is_empty", "get", "push", "pop", "swap"], name)
        MapTy(_, _) -> return has_text(["len", "is_empty", "get", "remove"], name)
        SetTy(_) -> return has_text(["len", "is_empty", "add", "remove"], name)
        SpawnedTy(_) -> return name == "wait"
        ChannelTy(_) -> return has_text(["send", "receive", "close"], name)
        LockTy(_) -> return has_text(["read", "update"], name)
        _ -> return false

task ex(kind: mir.ExprKind, ty: mir.Ty, span: diag.Span) -> mir.Expr
    return mir.Expr(kind: kind, ty: ty, span: span)

task poisoned(span: diag.Span) -> mir.Expr
    return ex(mir.NoneExpr, mir.ErrorTy, span)

task with_note(code: text, message: text, span: diag.Span, note: text) -> diag.Diagnostic
    var d = diag.new(code, message, span)
    d.notes.push(note)
    return d

## True for a name that means a built-in type or trait everywhere.
public task is_built_in(name: text) -> bool
    return has_text(built_in_types(), name) or number_type(name) is not none or has_text(later_types(), name) or has_text(built_in_traits(), name) or has_text(later_traits(), name)

public task is_literal(value: ast.Expr) -> bool
    match value.kind
        IntExpr(_) -> return true
        FloatExpr(_) -> return true
        BoolExpr(_) -> return true
        NoneExpr -> return true
        TextExpr(parts) ->
            for part in parts
                match part
                    ExprText(_) -> return false
                    LiteralText(_) ->
                        continue
            return true
        _ -> return false

# One step of a place: a field, or the local that holds an index or key.
choice Step
    SlotStep(slot: int)
    KeyStep(local: int)

# A place to write through, such as `x[i]` in `x[i][j] = 1`. `local` holds
# the value, and `setup` fills it. `take` empties its slot in the container,
# so that the local holds the only count and the write needs no copy.
# `finish` stores it back. Nothing may read the container between `take` and
# `finish`.
type Place
    root: int
    path: list[Step]
    local: int
    setup: list[mir.Stmt]
    take_out: list[mir.Stmt]
    finish: list[mir.Stmt]

task place_at(local: int) -> Place
    return Place(root: local, path: [], local: local, setup: [], take_out: [], finish: [])

# The whole write. `write` holds the value that the write changes.
task place_stmts(self: Place, write: mir.Stmt) -> mir.Stmt
    var out = self.setup
    for s in self.take_out
        out.push(s)
    out.push(write)
    for s in self.finish
        out.push(s)
    return mir.BlockStmt(body: out)

# True if two written values are the same names and fields.
task same_path(a: ast.Expr, b: ast.Expr) -> bool
    match a.kind
        NameExpr(x) ->
            match b.kind
                NameExpr(y) -> return x == y
                _ -> return false
        SelfExpr ->
            match b.kind
                SelfExpr -> return true
                _ -> return false
        FieldExpr(base_a, x) ->
            match b.kind
                FieldExpr(base_b, y) -> return x.text == y.text and same_path(base_a, base_b)
                _ -> return false
        _ -> return false

# True if `value` is a text whose first part is the field `base.name`, as in
# `b.t = "{b.t}x"`. Only names and fields, so reading it twice is the same.
task starts_with_field(value: ast.Expr, base: ast.Expr, name: ast.Name) -> bool
    match value.kind
        TextExpr(parts) ->
            if parts is empty
                return false
            match parts[0]
                ExprText(first) ->
                    match first.kind
                        FieldExpr(b, n) -> return n.text == name.text and same_path(b, base)
                        _ -> return false
                _ -> return false
        _ -> return false

# True if `outer` holds all of `inner`.
task holds_span(outer: diag.Span, inner: diag.Span) -> bool
    return outer.start <= inner.start and inner.end <= outer.end

# True if control never reaches the end of `stmts`. With `jumps`, leaving
# through `break` or `continue` counts.
task ends(stmts: list[mir.Stmt], jumps: bool) -> bool
    for s in stmts
        if stmt_ends(s, jumps)
            return true
    return false

task stmt_ends(s: mir.Stmt, jumps: bool) -> bool
    match s
        ReturnStmt(_) -> return true
        PlaceholderStmt(_) -> return true
        UnreachableStmt -> return true
        BreakStmt -> return jumps
        ContinueStmt -> return jumps
        BlockStmt(body) -> return ends(body, jumps)
        IfStmt(branches, otherwise) ->
            for branch in branches
                if not ends(branch.body, jumps)
                    return false
            return ends(otherwise, jumps)
        _ -> return false

# True if the line of `start` ends in a comment, or the line above it is one.
# `src` is one file's bytes, and `start` is an offset in it.
task has_comment(src: list[byte], start: int) -> bool
    var line_start = start
    while line_start > 0 and src[line_start - 1].to_int() != 10
        line_start -= 1
    var at = start
    while at < src.len() and src[at].to_int() != 10
        if src[at].to_int() == 35
            return true
        at += 1
    if line_start == 0
        return false
    # The line above, as `str::lines` reads it: without its line break, and
    # without a carriage return before it.
    var above_start = line_start - 1
    while above_start > 0 and src[above_start - 1].to_int() != 10
        above_start -= 1
    var i = above_start
    while i < line_start - 1
        let b = src[i].to_int()
        if b == 35
            return true
        if b != 32 and b != 9 and b != 13 and b != 11 and b != 12
            return false
        i += 1
    return false

# One side of a failed `expect`. Text has quotes, so that a space shows.
task shown_side(value: mir.Expr) -> mir.Expr
    return ex(mir.TextQuoteExpr(inner: value), mir.TextTy, value.span)

# A union value as a narrower type.
task view(value: mir.Expr, ty: mir.Ty) -> mir.Expr
    if ty == value.ty or ty == mir.ErrorTy
        var out = value
        out.ty = ty
        return out
    return ex(mir.ViewExpr(inner: value), ty, value.span)

# True if reading `value` twice costs nothing and changes nothing.
task repeatable(value: mir.Expr) -> bool
    match value.kind
        LocalExpr(_) -> return true
        CaptureExpr(_) -> return true
        IntExpr(_) -> return true
        BoolExpr(_) -> return true
        MemberExpr(inner, _, _) -> return repeatable(inner)
        ViewExpr(inner) -> return repeatable(inner)
        ListGetExpr(base, key) -> return repeatable(base) and repeatable(key)
        MapGetExpr(base, key) -> return repeatable(base) and repeatable(key)
        _ -> return false

# True for a text literal with no interpolation, or `+` of such literals,
# which become `sql` next to a query, as in `"a" + "b" + query`.
task literal_text(value: ast.Expr) -> bool
    match value.kind
        TextExpr(_) -> return is_literal(value)
        BinaryExpr(op, left, right) -> return op == "Add" and literal_text(left) and literal_text(right)
        _ -> return false

# True for a number with no other value in it, which takes its type from the
# other side of an operator. So `2 * 3 + x` works for any number type of `x`.
task literal_math(value: ast.Expr) -> bool
    match value.kind
        IntExpr(_) -> return true
        FloatExpr(_) -> return true
        UnaryExpr(op, inner) -> return (op == "Neg" or op == "BitNot") and literal_math(inner)
        BinaryExpr(op, left, right) -> return is_math(op) and literal_math(left) and literal_math(right)
        _ -> return false

task is_math(op: text) -> bool
    return has_text(["Add", "Sub", "Mul", "Div", "FloorDiv", "Rem", "BitAnd", "BitOr", "BitXor", "Shl", "Shr"], op)

task want_name(want: mir.Ty?) -> text
    return if want is mir.Ty then want.name() else ""

# The operator of a compound assignment, or empty text for `=`.
task compound(op: text) -> text
    return if op == "Set" then "" else op

task symbol(op: text) -> text
    let ops = ["Add", "Sub", "Mul", "Div", "FloorDiv", "Rem", "BitAnd", "BitOr", "BitXor", "Shl", "Shr", "Eq", "Ne", "Lt", "Le", "Gt", "Ge", "And", "Or"]
    let symbols = ["+", "-", "*", "/", "//", "%", "&", "|", "^", "<<", ">>", "==", "!=", "<", "<=", ">", ">=", "and", "or"]
    for i in 0..ops.len()
        if ops[i] == op
            return symbols[i]
    return op

## The edit distance of two names, with a swap of two neighbors as one edit.
public task edit_distance(a_text: text, b_text: text) -> int
    var a: list[text] = []
    for c in a_text
        a.push(c)
    var b: list[text] = []
    for c in b_text
        b.push(c)
    var before: list[int] = []
    var last: list[int] = []
    for j in 0..b.len() + 1
        last.push(j)
    for i in 1..a.len() + 1
        var row: list[int] = []
        for j in 0..b.len() + 1
            row.push(i)
        for j in 1..b.len() + 1
            let replace = last[j - 1] + (if a[i - 1] != b[j - 1] then 1 else 0)
            var best = replace
            if last[j] + 1 < best
                best = last[j] + 1
            if row[j - 1] + 1 < best
                best = row[j - 1] + 1
            if i > 1 and j > 1 and a[i - 1] == b[j - 2] and a[i - 2] == b[j - 1]
                if before[j - 2] + 1 < best
                    best = before[j - 2] + 1
            row[j] = best
        before = last
        last = row
    return last[b.len()]

# Reports, and gives a poisoned value at the diagnostic's span.
task report(change self: Checker, d: diag.Diagnostic) -> mir.Expr
    self.diags.push(d)
    return poisoned(d.span)

task fail(change self: Checker, code: text, message: text, span: diag.Span) -> mir.Expr
    return self.report(diag.new(code, message, span))

task note(change self: Checker, code: text, message: text, span: diag.Span, note: text) -> mir.Expr
    return self.report(with_note(code, message, span, note))

task unsupported(change self: Checker, what: text, span: diag.Span) -> mir.Expr
    let note = "see docs/roadmap.md for the milestone that adds it"
    return self.note("E0901", "{what} parses, but cannot run yet", span, note)

task later(change self: Checker, what: text, span: diag.Span) -> mir.Stmt?
    let poison = self.unsupported(what, span)
    return none

# The tag of a member of a union.
task type_id(self: Checker, ty: mir.Ty) -> int
    return self.table.id(ty)

task union(change self: Checker, members: list[mir.Ty]) -> mir.Ty
    return self.table.union(members)

task wrap(value: mir.Expr, want: mir.Ty) -> mir.Expr
    return ex(mir.WrapExpr(inner: value), want, value.span)

# Makes `value` a `want`, if `want` is a union or an `any` that accepts it.
# Any other value comes back as it was, for `expect` to report.
task widen(change self: Checker, value: mir.Expr, want: mir.Ty) -> mir.Expr
    if value.ty == want or value.ty == mir.ErrorTy
        return value
    match want
        AnyTy(_) ->
            if self.fits_any(value.ty, want)
                return wrap(value, want)
            return value
        UnionTy(members) ->
            var all = true
            for member in value.ty.members_of()
                if not mir.holds(members, member)
                    all = false
            if all
                return wrap(value, want)
            # A union stays out: a probe could not then find the members it
            # holds.
            let single = not is_union(value.ty)
            if single
                for member in members
                    if self.fits_any(value.ty, member)
                        return wrap(wrap(value, member), want)
            return value
        _ -> return value

task is_union(ty: mir.Ty) -> bool
    return match ty
        UnionTy(_) -> true
        _ -> false

task is_any(ty: mir.Ty) -> bool
    return match ty
        AnyTy(_) -> true
        _ -> false

task is_task_ty(ty: mir.Ty) -> bool
    return match ty
        TaskTy(_, _) -> true
        _ -> false

task is_data(ty: mir.Ty) -> bool
    return match ty
        DataTy(_, _, _) -> true
        _ -> false

# True if a value of type `ty` can go in `target`, which must be an `any`.
# One `any` does not go in another.
task fits_any(change self: Checker, ty: mir.Ty, target: mir.Ty) -> bool
    match target
        AnyTy(name) -> return not is_any(ty) and self.satisfies(ty, name)
        _ -> return false

## What a probe splits a union into.
type Split
    found: mir.Ty
    rest: mir.Ty

# Splits a union by a probe for `want`: what a true probe leaves, then what a
# false one leaves. `none` if the answer never depends on the value.
task split(change self: Checker, have: mir.Ty, want: mir.Ty) -> Split?
    if not is_union(have)
        return none
    let members = have.members_of()
    for member in want.members_of()
        if not mir.holds(members, member)
            return none
    var rest: list[mir.Ty] = []
    for ty in members
        if not mir.holds(want.members_of(), ty)
            rest.push(ty)
    if rest is empty
        return none
    let left = self.union(rest)
    return Split(found: want, rest: left)

# The one member of an expected union that a literal can build, as with
# `list[int]?` for `[]`. Any other expected type comes back as it was.
# `kind` is "list", "map", "set", or "task".
task literal_want(want: mir.Ty?, kind: text) -> mir.Ty?
    if want is none
        return want
    match want
        UnionTy(members) ->
            var found: list[mir.Ty] = []
            for member in members
                if fits_kind(member, kind)
                    found.push(member)
            if found.len() == 1
                return found[0]
            return want
        _ -> return want

task fits_kind(ty: mir.Ty, kind: text) -> bool
    if kind == "number"
        return ty.is_number()
    if kind == "sql"
        return ty == mir.SqlTy
    return match ty
        ListTy(_) -> kind == "list"
        MapTy(_, _) -> kind == "map"
        SetTy(_) -> kind == "set"
        TaskTy(_, _) -> kind == "task"
        ChannelTy(_) -> kind == "channel"
        LockTy(_) -> kind == "lock"
        _ -> false


# The type that this local holds here.
task current(self: Checker, local: int) -> mir.Ty
    var i = self.frame.narrowed.len() - 1
    while i >= 0
        if self.frame.narrowed[i].local == local
            return self.frame.narrowed[i].ty
        i -= 1
    return self.frame.locals[local]

# Ends what tests proved about a local that was assigned. Entries stay on
# the stack, so that a block can still cut it back to its own length.
task forget(change self: Checker, local: int)
    let declared = self.frame.locals[local]
    for change entry in self.frame.narrowed
        if entry.local == local
            entry.ty = declared

task truncate_narrowed(change self: Checker, length: int)
    while self.frame.narrowed.len() > length
        self.frame.narrowed.pop()

task push_facts(change self: Checker, facts: list[Narrowed])
    for fact in facts
        self.frame.narrowed.push(fact)

# Runs before a loop: its body runs again after its own assignments, and
# after each name it passes whole as `change`.
task forget_assigned(change self: Checker, stmts: list[ast.Stmt])
    for item in stmts
        var uses: list[ast.Use] = []
        for group in item.values()
            for value in group
                value.uses(change uses)
        for found in uses
            if found.whole
                let local = self.lookup(found.root)
                if local >= 0
                    self.forget(local)
        match item.kind
            AssignStmt(target, _, value) ->
                let name = match target.kind
                    NameExpr(name) -> name
                    SelfExpr -> "self"
                    _ -> ""
                if name is not empty
                    let local = self.lookup(name)
                    if local >= 0
                        self.forget(local)
                self.forget_in_arms(value)
            IfStmt(branches, otherwise) ->
                for branch in branches
                    self.forget_assigned(branch.body)
                if otherwise is list[ast.Stmt]
                    self.forget_assigned(otherwise)
            WhileStmt(_, body) -> self.forget_assigned(body)
            ForStmt(_, _, _, body) -> self.forget_assigned(body)
            UnsafeStmt(body) -> self.forget_assigned(body)
            ExprStmt(value) -> self.forget_in_arms(value)
            LetStmt(_, _, _, value) -> self.forget_in_arms(value)
            ReturnStmt(value) ->
                if value is ast.Expr
                    self.forget_in_arms(value)
            _ ->
                continue

# Does the same for the statements in the arms of a `match`.
task forget_in_arms(change self: Checker, value: ast.Expr)
    match value.kind
        MatchExpr(_, arms) ->
            for arm in arms
                match arm.body
                    ArmBlock(body) -> self.forget_assigned(body)
                    ArmStmt(item) -> self.forget_assigned([item])
                    ArmExpr(inner) -> self.forget_in_arms(inner)
        _ -> return

# What is true of names when `condition` gives `truth`. Only a plain name
# narrows, since nothing else is sure to hold the same value when read
# again. See decision 60.
task facts(change self: Checker, condition: ast.Expr, truth: bool) -> list[Narrowed]
    match condition.kind
        UnaryExpr(op, inner) ->
            if op == "Not"
                return self.facts(inner, not truth)
            return []
        BinaryExpr(op, left, right) ->
            let joined = if truth then "And" else "Or"
            if op != joined
                return []
            # The right side runs knowing the left, so it splits what is left.
            var found = self.facts(left, truth)
            let start = self.frame.narrowed.len()
            self.push_facts(found)
            let more = self.facts(right, truth)
            self.truncate_narrowed(start)
            for fact in more
                found.push(fact)
            return found
        IsExpr(value, negated, target) ->
            let name = match value.kind
                NameExpr(name) -> name
                SelfExpr -> "self"
                _ -> ""
            if name is empty
                return []
            let local = self.lookup(name)
            if local < 0
                return []
            let reported = self.diags.len()
            let want = self.is_target(target)
            while self.diags.len() > reported
                self.diags.pop()
            if want is none
                return []
            let have = self.current(local)
            let parts = self.split(have, want)
            if parts is none
                return []
            let ty = if truth != negated then parts.found else parts.rest
            return [Narrowed(local: local, ty: ty)]
        _ -> return []

# The type that an `is` tests, or `none` for `empty`.
task is_target(change self: Checker, target: ast.IsTarget) -> mir.Ty?
    match target
        IsNone -> return mir.NoneTy
        IsEmpty -> return none
        IsType(ty) -> return self.ty(ty)

# Reports E0303 unless `value` has type `want`.
task expect_type(change self: Checker, value: mir.Expr, want: mir.Ty, what: text)
    if value.ty == want or value.ty == mir.ErrorTy or want == mir.ErrorTy
        return
    let message = "{what} needs `{want.name()}`, found `{value.ty.name()}`"
    var d = diag.new("E0303", message, value.span)
    if want.is_number() and value.ty.is_number()
        d.notes.push("conversions are explicit: use `.to_{want.name()}()`")
    else if want == mir.SqlTy and value.ty == mir.TextTy
        d.notes.push(SQL_TEXT)
    let poison = self.report(d)

task ty(change self: Checker, written: ast.Type) -> mir.Ty
    match written.kind
        NoneType -> return mir.NoneTy
        UnionType(terms) ->
            var members: list[mir.Ty] = []
            for term in terms
                members.push(self.ty(term))
            return self.union(members)
        OptionalType(inner) ->
            let found = self.ty(inner)
            return self.union([found, mir.NoneTy])
        NamedType(path, args) ->
            if path.len() == 1
                var found: list[mir.Ty] = []
                for arg in args
                    found.push(self.ty(arg))
                return self.named(path[0].text, found, written.span)
            var names: list[text] = []
            for name in path
                names.push(name.text)
            return self.fail("E0302", "type `{mir.join_texts(names, ".")}` is not defined", written.span).ty
        AnyType(held) -> return self.any_type(held, written.span)
        TaskType(params, returns) ->
            var found: list[mir.Ty] = []
            for param in params
                found.push(self.ty(param))
            var result = mir.NoneTy
            if returns is ast.Type
                result = self.ty(returns)
            return mir.TaskTy(params: found, returns: result)
        _ -> return self.unsupported("this type", written.span).ty

# `any Trait`. A built-in trait other than `Show` asks for two values of one
# type, which two boxes may not be.
task any_type(change self: Checker, held: ast.Type, span: diag.Span) -> mir.Ty
    let name = self.trait_named(held)
    if name is none
        return mir.ErrorTy
    if not has_text(built_in_traits(), name) or name == "Show"
        return mir.AnyTy(name: name)
    let note = "its tasks need two values of one type, so use a bound"
    return self.note("E0303", "`any {name}` cannot be a type", span, note).ty

# Reads a type argument, which the parser kept as an expression. See
# decision 65.
task expr_type(change self: Checker, value: ast.Expr) -> mir.Ty
    let span = value.span
    match value.kind
        NoneExpr -> return mir.NoneTy
        NameExpr(name) -> return self.named(name, [], span)
        IndexExpr(base, indices) ->
            var args: list[mir.Ty] = []
            for index in indices
                args.push(self.expr_type(index))
            match base.kind
                NameExpr(name) -> return self.named(name, args, span)
                _ -> return self.fail("E0322", "this is not a type", span).ty
        BinaryExpr(op, left, right) ->
            if op != "Or"
                return self.fail("E0322", "this is not a type", span).ty
            let a = self.expr_type(left)
            let b = self.expr_type(right)
            return self.union([a, b])
        OptionalExpr(inner) ->
            let found = self.expr_type(inner)
            return self.union([found, mir.NoneTy])
        TypeExpr(ty) -> return self.ty(ty)
        _ -> return self.fail("E0322", "this is not a type", span).ty

task file_path(self: Checker, offset: int) -> text
    return self.files[diag.file_index(self.files, offset)].path

# The type that a written name means, with its type arguments.
task named(change self: Checker, name: text, args: list[mir.Ty], span: diag.Span) -> mir.Ty
    if mir.holds(args, mir.ErrorTy)
        return mir.ErrorTy
    let env = self.type_params
    for entry in env
        if entry.name == name
            return if self.arity(name, 0, args.len(), span) then entry.ty else mir.ErrorTy
    if has_text(["list", "map", "set", "spawned", "channel", "lock"], name)
        return self.collection_type(name, args, span)
    var plain: mir.Ty? = none
    if name == "bool"
        plain = mir.BoolTy
    else if name == "text"
        plain = mir.TextTy
    else if name == "sql"
        plain = mir.SqlTy
    else if (name == "socket" or name == "database") and self.file_path(span.start).starts_with("@std/")
        plain = if name == "socket" then mir.SocketTy else mir.DatabaseTy
    else
        plain = number_type(name)
    if plain is mir.Ty
        return if self.arity(name, 0, args.len(), span) then plain else mir.ErrorTy
    if has_text(later_types(), name)
        if args.len() == 1 and args[0] == mir.ByteTy
            return mir.PointerTy
        return self.note("E0331", "this pointer type does not exist", span, "the only one is `pointer[byte]`").ty
    if self.is_trait(name)
        return self.note("E0303", "`{name}` is a trait, not a type", span, "use it as a bound, as in `[T: {name}]`").ty
    if name not in self.types
        return self.fail("E0302", "type `{name}` is not defined", span).ty
    let found = self.types[name]
    match found
        KnownNamed(known) ->
            return if self.arity(name, 0, args.len(), span) then known else mir.ErrorTy
        GenericNamed(id) ->
            let want = self.datas[id].type_params.len()
            if not self.arity(name, want, args.len(), span)
                return mir.ErrorTy
            self.check_data_bounds(id, args, span)
            match self.datas[id].ty
                DataTy(data_name, _, _) -> return mir.DataTy(name: data_name, id: id, args: args)
                _ -> return mir.ErrorTy
        AliasNamed(target, params) ->
            if not self.arity(name, params.len(), args.len(), span)
                return mir.ErrorTy
            return self.alias(name, target, params, args, span)

# Reports E0321 unless a name gets as many type arguments as it declares.
task arity(change self: Checker, name: text, want: int, given: int, span: diag.Span) -> bool
    if want != given
        let plural = if want == 1 then "" else "s"
        let poison = self.fail("E0321", "`{name}` takes {want} type argument{plural}, found {given}", span)
    return want == given

task alias(change self: Checker, name: text, target: ast.Type, params: list[ast.TypeParam], args: list[mir.Ty], span: diag.Span) -> mir.Ty
    if has_text(self.resolving, name)
        return self.fail("E0315", "alias `{name}` is defined by itself", span).ty
    if self.resolving.len() == max_aliases()
        return self.fail("E0205", "aliases are nested too deep", span).ty
    var env: list[EnvEntry] = []
    for i in 0..params.len()
        if i < args.len()
            env.push(EnvEntry(name: params[i].name.text, ty: args[i]))
    let outer = self.type_params
    self.type_params = env
    self.resolving.push(name)
    let found = self.ty(target)
    self.resolving.pop()
    self.type_params = outer
    if params is empty
        self.types[name] = KnownNamed(ty: found)
    return found

task collection_type(change self: Checker, name: text, args: list[mir.Ty], span: diag.Span) -> mir.Ty
    if args.len() == 1
        let item = args[0]
        if name == "list"
            return mir.ListTy(item: item)
        if name == "spawned"
            return mir.SpawnedTy(item: item)
        if name == "channel"
            return mir.ChannelTy(item: item)
        if name == "lock"
            return mir.LockTy(item: item)
        if name == "set"
            self.check_key(item, span)
            return mir.SetTy(item: item)
    if args.len() == 2 and name == "map"
        self.check_key(args[0], span)
        return mir.MapTy(key: args[0], value: args[1])
    let needs = if name == "map" then "two types" else "one type"
    return self.fail("E0303", "`{name}` needs {needs}", span).ty

# A compound key needs `Hash`, which depends on tasks that may not be
# declared yet. A `float` never has it, since NaN is not equal to itself.
task check_key(change self: Checker, ty: mir.Ty, span: diag.Span)
    if ty == mir.ErrorTy
        return
    if ty.is_compound() or mir.is_param(ty)
        if self.ready
            let found = self.require(ty, "Hash", span)
        else
            self.deferred.push(Deferred(ty: ty, name: "Hash", span: span, bounds: self.bounds))
    else if not ty.is_key()
        let poison = self.fail("E0303", "`{ty.name()}` cannot be a key", span)

# Reports E0304 and returns false if a type or task has this name. A `type`,
# `choice`, variant, and task share one namespace, so that a variant reads
# the same in a pattern and in a call.
task define(change self: Checker, name: ast.Name) -> bool
    let text = name.text
    let taken = text in self.types or text in self.constructors or text in self.task_ids
    if taken
        let poison = self.fail("E0304", "`{text}` is already defined", name.span)
    return not taken

# Like `define`, for a name that a type or `set(...)` already means.
task define_data(change self: Checker, name: ast.Name) -> bool
    let text = name.text
    let short = ast.short_name(text)
    let reserved = is_built_in(short) or text in self.traits or (text != short and has_text(prelude_traits(), short))
    if reserved
        let trait_name = has_text(built_in_traits(), short) or has_text(later_traits(), short) or has_text(prelude_traits(), short)
        var what = "a trait"
        if trait_name
            what = "a built-in trait"
        else if is_built_in(short)
            what = "a built-in type"
        let poison = self.note("E0304", "`{text}` is already defined as {what}", name.span, "pick another name")
        return false
    return self.define(name)

task is_trait(self: Checker, name: text) -> bool
    return name in self.traits or has_text(built_in_traits(), name)

# The traits that each parameter of a declaration has.
task bounds_of(change self: Checker, params: list[ast.TypeParam]) -> list[list[text]]
    var all: list[list[text]] = []
    for param in params
        var traits: list[text] = []
        for bound in param.bounds
            let found = self.trait_named(bound)
            if found is text
                traits.push(found)
        all.push(traits)
    return all

# The trait that a bound or `any` names. Reports anything else.
task trait_named(change self: Checker, written: ast.Type) -> text?
    let span = written.span
    var name = ""
    match written.kind
        NamedType(path, args) ->
            if args is empty and path.len() == 1
                name = path[0].text
        _ ->
            name = ""
    if name is empty
        let poison = self.fail("E0302", "this must name a trait", span)
        return none
    if self.is_trait(name)
        return name
    if has_text(later_traits(), name)
        let poison = self.unsupported("trait `{name}`", span)
    else if name in self.types
        let poison = self.fail("E0302", "`{name}` is a type, not a trait", span)
    else
        let poison = self.fail("E0302", "trait `{name}` is not defined", span)
    return none

# Checks the bounds of a generic `type` or `choice`, now or once every task
# is declared.
task check_data_bounds(change self: Checker, id: int, args: list[mir.Ty], span: diag.Span)
    let bounds = self.datas[id].bounds
    for i in 0..args.len()
        if i < bounds.len()
            for name in bounds[i]
                if self.ready
                    let found = self.require(args[i], name, span)
                else
                    self.deferred.push(Deferred(ty: args[i], name: name, span: span, bounds: self.bounds))

# Reports E0320 unless a type has a trait.
task require(change self: Checker, ty: mir.Ty, name: text, span: diag.Span) -> bool
    let found = self.satisfies(ty, name)
    if not found
        var d = diag.new("E0320", "`{ty.name()}` does not have `{name}`", span)
        let written_equal = name == "Hash" and self.find_method("equal", ty) is not none
        match ty
            ParamTy(param, _) -> d.notes.push("add a bound, as in `[{param}: {name}]`")
            _ ->
                if written_equal
                    d.notes.push("a hand-written `equal` needs a hand-written `hash` to match it")
                else if name == "Json" and not self.json_union_clear(ty)
                    d.notes.push("two members would read from one kind of JSON value")
        let poison = self.report(d)
    return found

task satisfies(change self: Checker, ty: mir.Ty, name: text) -> bool
    var seen: list[Asked] = []
    return self.satisfied(ty, name, change seen)

type Asked
    ty: mir.Ty
    name: text

# True if a type has a trait. `seen` holds what was already asked: a
# recursive type has a trait if nothing else in it lacks one, and any
# `false` ends the whole walk. A type that keeps growing has no last answer,
# so past the limits the answer is no.
task satisfied(change self: Checker, ty: mir.Ty, name: text, change seen: list[Asked]) -> bool
    if ty == mir.ErrorTy
        return true
    if ty == mir.PointerTy
        return false
    match ty
        ParamTy(_, index) ->
            return index < self.bounds.len() and has_text(self.bounds[index], name)
        _ -> skip()
    if name == "Hash" and mir.holds(self.written_hashes, ty)
        return false
    match ty
        AnyTy(held) ->
            if held == name or name == "Show" or name == "Equal"
                let tasks = if name in self.traits then self.traits[name] else []
                for t in tasks
                    if self.changes(t)
                        return false
                return true
        _ -> skip()
    if ty.too_large() or seen.len() == max_finite_check()
        return false
    for asked in seen
        if asked.ty == ty and asked.name == name
            return true
    seen.push(Asked(ty: ty, name: name))
    var written = ""
    if name == "Show"
        written = "show"
    else if name == "Equal"
        written = "equal"
    else if name == "Order"
        written = "compare"
    else if name == "Add"
        written = "add"
    else if name == "Sub"
        written = "sub"
    else if name == "Mul"
        written = "mul"
    else if name == "Div"
        written = "div"
    let found = self.written_task(written, ty, change seen)
    if found is bool
        return found
    if name == "Hash"
        let hashed = self.written_hash(ty, change seen)
        if hashed is bool
            return hashed
    if not has_text(built_in_traits(), name)
        let tasks = if name in self.traits then self.traits[name] else []
        for t in tasks
            if not self.fits_trait_task(ty, t, change seen)
                return false
        return true
    var parts: list[mir.Ty] = []
    match ty
        ListTy(item) ->
            parts = [item]
        SetTy(item) ->
            parts = [item]
        MapTy(key, value) ->
            parts = [key, value]
        UnionTy(members) ->
            parts = members
        DataTy(_, _, _) ->
            for variant in self.variants_of(ty)
                for field in variant
                    parts.push(field)
        _ ->
            parts = []
    if name == "Equal" and (is_task_ty(ty) or ty.is_handle())
        return false
    if name == "Hash"
        # A `none` inside a value hashes as nothing. Alone it is no key.
        var kept: list[mir.Ty] = []
        for part in parts
            if part != mir.NoneTy
                kept.push(part)
        parts = kept
    # A read reports failure as a `JsonError`, so one cannot be a value read.
    let json_error = match ty
        DataTy(data_name, _, _) -> data_name == "@std.json.JsonError"
        _ -> false
    if name == "Json" and (json_error or not self.json_union_clear(ty))
        return false
    var holds = false
    if ty == mir.SqlTy
        # No trait makes a query from text, by decision 195.
        holds = name == "Show" or name == "Equal"
    else if name == "Show" or name == "Equal"
        holds = true
    else if name == "Json"
        holds = json_holds(ty)
    else if name == "Hash"
        holds = ty.is_key() or (ty.is_compound() and not is_any(ty))
    else if name == "Order"
        holds = ty.is_number() or ty == mir.TextTy or is_data(ty) or fits_kind(ty, "list")
    else if name == "Div"
        return ty.is_float()
    else
        return ty.is_number()
    if not holds
        return false
    for part in parts
        if not self.satisfied(part, name, change seen)
            return false
    return true

# True unless two members of a union can read from one kind of JSON value.
task json_union_clear(self: Checker, ty: mir.Ty) -> bool
    let members = ty.members_of()
    if members.len() < 2
        return true
    var shapes: list[mir.Shape] = []
    for data in self.datas
        shapes.push(data.shape())
    var seen: list[int] = []
    var clear = true
    for member in members
        let tags = mir.json_tags(member, shapes)
        for tag in tags
            if has_int(seen, tag)
                clear = false
        for tag in tags
            seen.push(tag)
    return clear

## A task with a `self` parameter that takes a type, and what the type shows
## about its type parameters.
type Method
    id: int
    known: list[mir.Ty?]

# With a hand-written task for this type, true if its bounds hold. `none`
# if there is no such task.
task written_task(change self: Checker, name: text, ty: mir.Ty, change seen: list[Asked]) -> bool?
    let found = self.find_method(name, ty)
    if found is none
        return none
    let bounds = self.signatures[found.id].bounds
    for i in 0..found.known.len()
        if i < bounds.len()
            for trait_name in bounds[i]
                let arg = found.known[i]
                if arg is none
                    return false
                if not self.satisfied(arg, trait_name, change seen)
                    return false
    return true

# Whether a type's own tasks give it `Hash`, or `none` if they say nothing.
# A written `hash` needs a result with `Hash`. A written `equal` alone gives
# no `Hash`, since a derived hash would not match it. See decision 77.
task written_hash(change self: Checker, ty: mir.Ty, change seen: list[Asked]) -> bool?
    let found = self.written_task("hash", ty, change seen)
    if found is none
        if self.find_method("equal", ty) is not none
            return false
        return none
    let method = self.find_method("hash", ty)
    if method is none
        return none
    var args: list[mir.Ty] = []
    for known in method.known
        if known is none
            return false
        args.push(known)
    if not found
        return false
    let returns = self.signatures[method.id].returns
    let result = self.table.subst(returns, args)
    self.written_hashes.push(ty)
    let hashed = self.satisfied(result, "Hash", change seen)
    self.written_hashes.pop()
    return hashed

# True if `ty` has a task that matches a task of a trait.
task fits_trait_task(change self: Checker, ty: mir.Ty, task_id: int, change seen: list[Asked]) -> bool
    let name = self.signatures[task_id].name.text
    let written = self.written_task(name, ty, change seen)
    if written is none or not written
        return false
    let found = self.find_method(name, ty)
    if found is none
        return false
    var args: list[mir.Ty] = []
    for known in found.known
        if known is none
            return false
        args.push(known)
    let want = self.signatures[task_id]
    let have = self.signatures[found.id]
    if want.params.len() != have.params.len()
        return false
    for i in 1..want.params.len()
        let param = have.params[i].ty
        if want.params[i].ty != self.table.subst(param, args)
            return false
    let returns = have.returns
    if want.returns != self.table.subst(returns, args)
        return false
    for i in 0..want.params.len()
        if (want.params[i].mode == "Change") != (have.params[i].mode == "Change")
            return false
    return true

# True if a task has a `change` parameter.
task changes(self: Checker, id: int) -> bool
    for param in self.signatures[id].params
        if param.mode == "Change"
            return true
    return false

# The task with a `self` parameter that takes this type, if any, and what
# the type shows about its type parameters.
task find_method(change self: Checker, name: text, ty: mir.Ty) -> Method?
    if name not in self.methods
        return none
    for id in self.methods[name]
        let pattern = self.signatures[id].params[0].ty
        let count = self.signatures[id].type_params.len()
        let known = self.table.fit(pattern, ty, count)
        if known is list[mir.Ty?]
            return Method(id: id, known: known)
    return none

# Reports a type parameter that reuses a name. A field or parameter could
# otherwise not tell it from the type that it hides.
task check_type_params(change self: Checker, params: list[ast.TypeParam])
    var seen: list[text] = []
    for param in params
        let text = param.name.text
        let taken = has_text(seen, text) or text in self.types or self.is_trait(text) or has_text(later_traits(), text) or has_text(built_in_types(), text) or number_type(text) is not none or has_text(later_types(), text)
        if taken
            let poison = self.fail("E0304", "`{text}` is already defined", param.name.span)
        seen.push(text)

task new_data(change self: Checker, name: ast.Name, params: list[ast.TypeParam], is_choice: bool) -> int
    let id = self.datas.len()
    let type_params = own_params(params)
    let bounds = self.bounds_of(params)
    let args = env_types(type_params)
    let ty = mir.DataTy(name: name.text, id: id, args: args)
    self.datas.push(Data(name: name, ty: ty, type_params: type_params, bounds: bounds, is_choice: is_choice, variants: []))
    self.types[name.text] = if args is empty then KnownNamed(ty: ty) else GenericNamed(id: id)
    return id

# Runs before anything that uses a type: fields may name any type, so all
# names go in first, then aliases resolve, then fields.
task declare_types(change self: Checker, file: ast.File)
    var aliases: list[AliasDecl] = []
    var headers: list[list[ast.TypeParam]] = []
    var written: list[WrittenVariant] = []
    for item in file.stmts
        match item.kind
            TraitStmt(def) -> self.declare_trait(def)
            _ ->
                continue
    for item in file.stmts
        match item.kind
            TypeStmt(def) ->
                if self.define_data(def.name)
                    headers.push(def.type_params)
                    match def.body
                        AliasBody(target) ->
                            let name = def.name.text
                            let params = def.type_params
                            var bound: ast.Type? = none
                            for p in params
                                if bound is none and p.bounds is not empty
                                    bound = p.bounds[0]
                            if bound is ast.Type
                                let poison = self.unsupported("a bound on an alias", bound.span)
                            self.types[name] = AliasNamed(target: target, params: params)
                            aliases.push(AliasDecl(name: name, target: target, params: params, span: def.name.span))
                        FieldsBody(fields) ->
                            let id = self.new_data(def.name, def.type_params, false)
                            let name = def.name.text
                            let short = ast.short_name(name)
                            self.constructor_names[short] = true
                            self.datas[id].variants.push(DataVariant(name: short, fields: []))
                            self.constructors[name] = VariantRef(data: id, variant: 0)
                            var found: list[WrittenField] = []
                            for f in fields
                                found.push(WrittenField(name: f.name, ty: f.ty, default: f.default, plain: true))
                            written.push(WrittenVariant(data: id, variant: 0, fields: found))
            ChoiceStmt(def) ->
                if self.define_data(def.name)
                    headers.push(def.type_params)
                    let id = self.new_data(def.name, def.type_params, true)
                    for variant in def.variants
                        let name = variant.name.text
                        let index = self.datas[id].variants.len()
                        if self.define_data(variant.name)
                            self.constructors[name] = VariantRef(data: id, variant: index)
                            self.constructor_names[ast.short_name(name)] = true
                        self.datas[id].variants.push(DataVariant(name: ast.short_name(name), fields: []))
                        var found: list[WrittenField] = []
                        for p in variant.params
                            let plain = p.mode == "Read" and p.name.text != "self"
                            found.push(WrittenField(name: p.name, ty: p.ty, default: p.default, plain: plain))
                        written.push(WrittenVariant(data: id, variant: index, fields: found))
            _ ->
                continue
    for params in headers
        self.check_type_params(params)
    for decl in aliases
        let still = decl.name in self.types and is_alias(self.types[decl.name])
        if still
            let args = env_types(own_params(decl.params))
            let found = self.alias(decl.name, decl.target, decl.params, args, decl.span)
    for w in written
        self.type_params = self.datas[w.data].type_params
        self.bounds = self.datas[w.data].bounds
        let fields = self.fields(w.fields)
        self.type_params = []
        self.bounds = []
        self.datas[w.data].variants[w.variant].fields = fields
    self.check_finite()

task fields(change self: Checker, written: list[WrittenField]) -> list[DataField]
    var fields: list[DataField] = []
    for w in written
        if not w.plain
            let poison = self.fail("E0307", "a field cannot be `self`, `change`, or `take`", w.name.span)
        var ty = mir.ErrorTy
        let written_ty = w.ty
        if written_ty is ast.Type
            ty = self.ty(written_ty)
        for field in fields
            if field.name == w.name.text
                let poison = self.fail("E0304", "`{w.name.text}` is already defined", w.name.span)
        var default: mir.Expr? = none
        let written_default = w.default
        if written_default is ast.Expr
            default = self.default_value(written_default, ty)
        fields.push(DataField(name: w.name.text, ty: ty, default: default))
    return fields

# The field types of each variant of a `type` or `choice`, with its type
# arguments in place.
task variants_of(change self: Checker, ty: mir.Ty) -> list[list[mir.Ty]]
    match ty
        DataTy(_, id, args) ->
            var out: list[list[mir.Ty]] = []
            let variants = self.datas[id].variants
            for variant in variants
                var fields: list[mir.Ty] = []
                for field in variant.fields
                    fields.push(self.table.subst(field.ty, args))
                out.push(fields)
            return out
        _ -> return []

task finite_holds(ty: mir.Ty, finite: list[mir.Ty], explored: list[mir.Ty]) -> bool
    match ty
        DataTy(_, _, _) -> return ty.too_large() or mir.holds(finite, ty) or not mir.holds(explored, ty)
        UnionTy(members) ->
            for m in members
                if finite_holds(m, finite, explored)
                    return true
            return false
        _ -> return true

# Reports a type with no finite value. Recursion must pass through a variant
# that can avoid it, or a collection that can be empty. A generic type needs
# this per instance.
task check_finite(change self: Checker)
    var instances: list[mir.Ty] = []
    for data in self.datas
        instances.push(data.ty)
    var shapes: list[list[list[mir.Ty]]] = []
    let limit = if max_finite_check() > instances.len() then max_finite_check() else instances.len()
    while shapes.len() < instances.len() and shapes.len() < limit
        let variants = self.variants_of(instances[shapes.len()])
        for fields in variants
            for field in fields
                for member in field.members_of()
                    if is_data(member) and not member.too_large() and not mir.holds(instances, member)
                        instances.push(member)
        shapes.push(variants)
    while instances.len() > shapes.len()
        instances.pop()
    let explored = instances
    var finite: list[mir.Ty] = []
    var changed = true
    while changed
        changed = false
        for i in 0..instances.len()
            let ty = instances[i]
            var reachable = false
            for fields in shapes[i]
                var all = true
                for f in fields
                    if not finite_holds(f, finite, explored)
                        all = false
                if all
                    reachable = true
            if reachable and not mir.holds(finite, ty)
                finite.push(ty)
                changed = true
    for id in 0..self.datas.len()
        if not mir.holds(finite, self.datas[id].ty)
            let name = self.datas[id].name
            let note = "building it needs a type that holds itself: add a variant with no such field, or hold the value in a list or a union such as `T?`"
            let poison = self.note("E0315", "`{name.text}` has no finite value", name.span, note)

# A trait name goes in before anything that may name it. Its tasks wait for
# `declare`, since their types may be any type.
task declare_trait(change self: Checker, def: ast.TraitDef)
    if def.type_params is not empty
        let poison = self.unsupported("a generic trait", def.type_params[0].name.span)
    if self.define_data(def.name)
        self.traits[def.name.text] = []
        self.trait_spans[def.name.text] = def.name.span

# Reports what no receiver may do: overlap another one, take the name of a
# built-in task, or give a derived task the wrong signature.
task check_methods(change self: Checker)
    for id in 0..self.signatures.len()
        let signature = self.signatures[id]
        let skip = signature.in_trait or signature.params is empty or signature.params[0].name != "self"
        if not skip
            let name = signature.name.text
            let span = signature.name.span
            let receiver = signature.params[0].ty
            if receiver != mir.ErrorTy
                if mir.is_param(receiver)
                    let poison = self.fail("E0307", "`self` needs a type that is not a bare type parameter", span)
                else
                    var overlaps = false
                    for other in self.methods[name]
                        if other < id and self.overlap(id, other)
                            overlaps = true
                    if overlaps or builtin_method(receiver, name) or self.trait_task(receiver, name) >= 0
                        let poison = self.fail("E0304", "`{name}` is already defined", span)
                    else
                        self.check_orphan(id)
                    self.check_written_shape(id)

# The package that holds the file of a span, or -1.
task package_of(self: Checker, span: diag.Span) -> int
    let file = self.files[diag.file_index(self.files, span.start)].start
    for entry in self.packages
        if entry.start == file
            return entry.package
    return -1

# The orphan rule of decision 196: in a package, a task with `self` needs
# its receiver's type, or a trait that names the task, from that package.
task check_orphan(change self: Checker, id: int)
    let signature = self.signatures[id]
    let name = signature.name.text
    let span = signature.name.span
    let receiver = signature.params[0].ty
    let package = self.package_of(span)
    if package < 0
        return
    var owner = -1
    match receiver
        DataTy(_, data, _) ->
            owner = self.package_of(self.datas[data].name.span)
        AnyTy(held) ->
            if held in self.trait_spans
                owner = self.package_of(self.trait_spans[held])
        _ ->
            owner = -1
    var named = false
    for key in self.traits
        for t in self.traits[key]
            let task_name = self.signatures[t].name
            if task_name.text == name and self.package_of(task_name.span) == package
                named = true
    if owner != package and not named
        let message = "`{name}` adds a task to `{receiver.name()}`, a type from outside this package"
        let poison = self.note("E0342", message, span, "take the value as a plain argument, or hold it in a type of this package")

# True if one value could be the receiver of both tasks.
task overlap(self: Checker, a: int, b: int) -> bool
    return self.signatures[a].params[0].ty.may_overlap(self.signatures[b].params[0].ty)

# A task named after a derived one replaces it, so it must fit. See
# decision 73.
task check_written_shape(change self: Checker, id: int)
    let signature = self.signatures[id]
    let name = signature.name.text
    let span = signature.name.span
    let receiver = signature.params[0].ty
    var others = 0
    var returns = mir.TextTy
    if name == "show"
        others = 0
    else if name == "equal"
        others = 1
        returns = mir.BoolTy
    else if name == "compare"
        others = 1
        returns = mir.IntTy
    else if has_text(["add", "sub", "mul", "div"], name)
        others = 1
        returns = receiver
    else if name == "hash"
        returns = if signature.returns == mir.NoneTy then mir.IntTy else signature.returns
    else
        return
    let count = signature.type_params.len()
    var fits = signature.params.len() == others + 1 and not self.changes(id) and signature.returns == returns and receiver.is_compound() and not is_any(receiver)
    for i in 1..signature.params.len()
        if signature.params[i].ty != receiver
            fits = false
    var known: list[mir.Ty?] = []
    for i in 0..count
        known.push(none)
    self.table.unify(receiver, receiver, change known)
    for k in known
        if k is none
            fits = false
    if not fits
        let other = if others == 1 then ", other: T" else ""
        var shown = returns.name()
        if name == "hash"
            shown = "int"
        else if returns == receiver
            shown = "T"
        let note = "write `task {name}(self: T{other}) -> {shown}`, for a `type`, `choice`, or collection `T`"
        let poison = self.note("E0323", "`{name}` replaces a derived task, so it needs this form", span, note)

# First pass: tasks and top-level values may be used before their line.
task declare(change self: Checker, file: ast.File)
    for item in file.stmts
        match item.kind
            TaskStmt(def) ->
                let name = def.sig.name.text
                let id = self.signatures.len()
                if def.sig.is_method()
                    if name not in self.methods
                        self.methods[name] = []
                    self.methods[name].push(id)
                else if self.define(def.sig.name)
                    self.task_ids[name] = id
                var signature = self.signature(def.sig, false)
                signature.is_public = def.is_public
                if def.body is none
                    self.check_foreign(def, signature)
                    self.foreign.push(id)
                    self.unsafe_sites.push(mir.UnsafeSite(kind: "extern", span: item.span))
                    self.need_permission("an `extern` task", item.span)
                self.signatures.push(signature)
            _ ->
                continue
    for item in file.stmts
        match item.kind
            TraitStmt(def) ->
                for sig in def.tasks
                    if sig.type_params is not empty
                        let poison = self.unsupported("a generic task in a trait", sig.type_params[0].name.span)
                    if sig.params is empty or sig.params[0].name.text != "self"
                        let poison = self.fail("E0307", "`{sig.name.text}` needs `self` first", sig.name.span)
                    else
                        let id = self.signatures.len()
                        let signature = self.signature(sig, true)
                        self.signatures.push(signature)
                        if def.name.text in self.traits
                            self.traits[def.name.text].push(id)
            _ ->
                continue
    for item in file.stmts
        match item.kind
            LetStmt(mutable, name, ty, value) ->
                if mutable
                    self.top[name.text] = VarTop
                else if is_literal(value)
                    self.top[name.text] = LiteralTop(value: value, ty: ty)
                else
                    self.top[name.text] = LetTop
            _ ->
                continue
    self.check_methods()
    self.ready = true
    let deferred = self.deferred
    self.deferred = []
    for d in deferred
        self.bounds = d.bounds
        let found = self.require(d.ty, d.name, d.span)
    self.bounds = []

task signature(change self: Checker, sig: ast.TaskSig, in_trait: bool) -> Signature
    self.check_type_params(sig.type_params)
    let type_params = own_params(sig.type_params)
    let bounds = self.bounds_of(sig.type_params)
    self.type_params = type_params
    self.bounds = bounds
    var params: list[SigParam] = []
    for param in sig.params
        let span = param.name.span
        if param.mode == "Change" and param.default is not none
            let poison = self.fail("E0307", "a `change` parameter takes no default", span)
        var ty = mir.ErrorTy
        let written_ty = param.ty
        if written_ty is ast.Type
            ty = self.ty(written_ty)
        if param.name.text == "self"
            if params is not empty
                let poison = self.fail("E0307", "`self` must come first", span)
            else if in_trait and param.ty is not none
                let poison = self.fail("E0307", "`self` has no type in a trait", span)
            else if not in_trait and param.ty is none
                let poison = self.note("E0307", "`self` needs a type here", span, "write `self: User`. Only a trait leaves it out")
        else
            for p in params
                if p.name == param.name.text
                    let poison = self.fail("E0304", "`{param.name.text}` is already defined", span)
        var default: mir.Expr? = none
        let written_default = param.default
        if written_default is ast.Expr
            default = self.default_value(written_default, ty)
        if default is none and params is not empty and params[params.len() - 1].default is not none
            let poison = self.fail("E0307", "`{param.name.text}` needs a default, like the one before it", span)
        params.push(SigParam(name: param.name.text, ty: ty, default: default, mode: param.mode))
    var returns = mir.NoneTy
    let written_returns = sig.returns
    if written_returns is ast.Type
        returns = self.ty(written_returns)
    self.type_params = []
    self.bounds = []
    return Signature(name: sig.name, is_public: false, type_params: type_params, bounds: bounds, in_trait: in_trait, params: params, returns: returns)

task default_value(change self: Checker, value: ast.Expr, ty: mir.Ty) -> mir.Expr
    let blank = match value.kind
        ListExpr(items) -> items is empty
        MapExpr(entries) -> entries is empty
        _ -> false
    if not is_literal(value) and not blank
        return self.fail("E0313", "a default must be a literal, or an empty `[]` or `{{}}`", value.span)
    let lowered = self.expected(value, ty)
    self.expect_type(lowered, ty, "this default")
    return lowered

task check_task(change self: Checker, id: int, def: ast.TaskDef, body: list[ast.Stmt], span: diag.Span) -> mir.Task
    let signature = self.signatures[id]
    let returns = signature.returns
    self.frame.returns = returns
    self.type_params = signature.type_params
    self.bounds = signature.bounds
    let params = signature.params
    var scope: map[text, int] = {}
    var changes: list[int] = []
    # The runtime calls a written `equal` directly, and passes no count.
    let method = params is not empty and params[0].name == "self"
    let written = not (method and signature.name.text == "equal")
    var takes: list[int] = []
    for p in params
        let changing = p.mode == "Change"
        let local = self.new_local(p.ty, changing)
        scope[p.name] = local
        if changing
            changes.push(local)
        if written and p.mode == "Take"
            takes.push(local)
    self.frame.params = params.len()
    var lowered: list[mir.Stmt] = []
    for i in 0..params.len()
        if params[i].mode == "Take"
            let param_ty = self.frame.locals[i]
            let own = self.new_local(param_ty, true)
            let read = self.read(i, span)
            scope[params[i].name] = own
            lowered.push(mir.SetStmt(local: own, value: read))
    for param in def.sig.params
        if param.name.text in scope
            let local = scope[param.name.text]
            self.frame.spans[local] = param.name.span
    self.frame.scopes.push(scope)
    for s in self.stmts(body)
        lowered.push(s)
    self.frame.scopes.pop()
    self.check_returns(def.sig.name, returns, change lowered)
    self.open_spawns(change lowered)
    self.frame.mutable = []
    let type_params = self.type_params.len()
    self.type_params = []
    self.bounds = []
    let locals = self.frame.locals
    self.frame.locals = []
    self.frame.spans = []
    self.frame.params = 0
    return mir.Task(name: def.sig.name.text, params: params.len(), type_params: type_params, returns: returns, locals: locals, body: lowered, span: span, changes: changes, takes: takes)

# Reports E0309 unless a body with a return type returns on every path. A
# task that gives only `none` or an error returns `none` at its end.
task check_returns(change self: Checker, name: ast.Name, returns: mir.Ty, change body: list[mir.Stmt])
    self.check_errors_read()
    let members = returns.members_of()
    let failing = mir.holds(members, mir.NoneTy) and self.error_members(returns).len() + 1 == members.len()
    if failing and returns != mir.NoneTy and not ends(body, false)
        let none_value = self.widen(ex(mir.NoneExpr, mir.NoneTy, name.span), returns)
        body.push(mir.ReturnStmt(value: none_value))
    else if returns != mir.NoneTy and returns != mir.ErrorTy and not ends(body, false)
        let poison = self.fail("E0309", "`{name.text}` must return `{returns.name()}` on every path", name.span)

# An `extern` task crosses to C, where only plain values make sense.
task check_foreign(change self: Checker, def: ast.TaskDef, signature: Signature)
    let span = def.sig.name.span
    let name = ast.short_name(def.sig.name.text)
    # `std` alone reaches the runtime, and passes it counted values.
    let std = def.sig.name.text.starts_with("@std.")
    var problem = ""
    var plain_params = true
    var reads = true
    var defaults = false
    var has_self = false
    for p in signature.params
        if p.name == "self"
            has_self = true
        if p.default is not none
            defaults = true
        if p.mode != "Read"
            reads = false
        if not plain_foreign(p.ty, std) and p.ty != mir.ErrorTy
            plain_params = false
    let returns = signature.returns
    if name.starts_with("lucid_") and not std
        problem = "the runtime keeps names that start with `lucid_`"
    else if signature.type_params is not empty
        problem = "it cannot be generic"
    else if has_self
        problem = "it cannot take `self`"
    else if defaults
        problem = "a parameter cannot have a default"
    else if not reads
        problem = "a parameter cannot be `change` or `take`"
    else if not plain_params
        problem = "a parameter must be a number, `bool`, or `pointer[byte]`"
    else if not plain_foreign(returns, std) and returns != mir.NoneTy and returns != mir.ErrorTy
        problem = "the result must be a number, `bool`, `pointer[byte]`, or nothing"
    else
        var param_tys: list[mir.Ty] = []
        for p in signature.params
            param_tys.push(p.ty)
        if name in self.symbols
            let form = self.symbols[name]
            if form.returns != returns or form.params != param_tys
                problem = "another module declares this symbol with a different form"
        if problem is empty
            self.symbols[name] = ForeignForm(params: param_tys, returns: returns)
            # ponytail: the Rust checker looks the symbol up in the C library
            # for E0904. The Lucid compiler cannot until the backend's C ABI,
            # by decision 217, so it reports none.
    if problem is not empty
        let poison = self.note("E0331", "`{name}` cannot be `extern`", span, problem)

task plain_foreign(ty: mir.Ty, std: bool) -> bool
    return ty.is_number() or ty == mir.BoolTy or ty == mir.PointerTy or (std and ty.is_counted())

# The task behind an `extern`. It passes its parameters on, so a call goes
# through the same path as any task.
task foreign_task(change self: Checker, id: int, def: ast.TaskDef, span: diag.Span) -> mir.Task
    var locals: list[mir.Ty] = []
    var args: list[mir.Expr] = []
    for p in self.signatures[id].params
        args.push(ex(mir.LocalExpr(local: locals.len()), p.ty, span))
        locals.push(p.ty)
    let returns = self.signatures[id].returns
    let name = def.sig.name.text
    let call = ex(mir.ForeignExpr(symbol: ast.short_name(name), values: args), returns, span)
    return mir.Task(name: name, params: locals.len(), type_params: 0, returns: returns, locals: locals, body: [mir.ReturnStmt(value: call)], span: span)

# Reports `what` outside an `unsafe` block.
task need_unsafe(change self: Checker, what: text, span: diag.Span)
    if not self.frame.in_unsafe
        let poison = self.fail("E0330", "{what} needs an `unsafe` block", span)

# Reports `unsafe` code in a package that lacks the `unsafe` permission.
task need_permission(change self: Checker, what: text, span: diag.Span)
    let file = self.files[diag.file_index(self.files, span.start)].start
    let no_unsafe = self.no_unsafe
    for entry in no_unsafe
        if entry.start == file
            let poison = self.note("E0340", "{what} needs the `unsafe` permission", span, "add it under `[permissions]` in `{entry.manifest}`")
            return

# `unsafe`. The comment that security.md asks for comes first, or at the end
# of the line.
task unsafe_block(change self: Checker, body: list[ast.Stmt], span: diag.Span) -> mir.Stmt
    self.unsafe_sites.push(mir.UnsafeSite(kind: "block", span: span))
    self.need_permission("an `unsafe` block", span)
    # Only this file: a package's manifest sits just before its entry file.
    let index = diag.file_index(self.files, span.start)
    let file = self.files[index].start
    let end = if index + 1 < self.files.len() then self.files[index + 1].start else self.src.len()
    if not has_comment(self.src[file..end], span.start - file)
        let poison = self.note("E0332", "this `unsafe` block has no comment", span, "say why it is sound, in a `#` line above it")
    let outer = self.frame.in_unsafe
    self.frame.in_unsafe = true
    let lowered = self.block(body)
    self.frame.in_unsafe = outer
    return mir.BlockStmt(body: lowered)

# The name of a `test`, which must be plain and new.
task test_name(change self: Checker, name: ast.Expr, tests: list[mir.TestCase]) -> text
    var found: text? = none
    match name.kind
        TextExpr(parts) ->
            if parts is empty
                found = ""
            else if parts.len() == 1
                match parts[0]
                    LiteralText(value) ->
                        found = value
                    _ ->
                        found = none
        _ ->
            found = none
    if found is none
        let poison = self.fail("E0329", "a `test` name cannot hold `{{}}`", name.span)
        return ""
    for case in tests
        if case.name == found
            let poison = self.fail("E0329", "there are two tests named \"{found}\"", name.span)
    return found

# A `test` is a task with no parameters. It sees what a task sees.
task check_test(change self: Checker, name: text, body: list[ast.Stmt], span: diag.Span) -> mir.Task
    self.frame.returns = mir.NoneTy
    self.frame.in_test = true
    self.frame.scopes.push({})
    var lowered = self.stmts(body)
    self.frame.scopes.pop()
    self.check_errors_read()
    self.open_spawns(change lowered)
    self.frame.in_test = false
    self.frame.mutable = []
    let locals = self.frame.locals
    self.frame.locals = []
    self.frame.spans = []
    return mir.Task(name: "test \"{name}\"", params: 0, type_params: 0, returns: mir.NoneTy, locals: locals, body: lowered, span: span)

task main(change self: Checker, file: ast.File) -> mir.Task
    self.frame.returns = none
    self.frame.scopes.push({})
    var lowered = self.stmts(file.stmts)
    self.check_errors_read()
    self.open_spawns(change lowered)
    let locals = self.frame.locals
    self.frame.locals = []
    self.frame.spans = []
    return mir.Task(name: "top level", params: 0, type_params: 0, returns: mir.NoneTy, locals: locals, body: lowered, span: diag.span(0, 0))

task new_local(change self: Checker, ty: mir.Ty, mutable: bool) -> int
    self.frame.locals.push(ty)
    self.frame.mutable.push(mutable)
    self.frame.spans.push(diag.span(0, 0))
    return self.frame.locals.len() - 1

# Adds a name to the innermost scope. Shadowing there is an error.
task bind(change self: Checker, name: ast.Name, ty: mir.Ty, mutable: bool) -> int
    let text = name.text
    let top_level = self.frame.returns is none and self.frame.scopes.len() == 1
    let last = self.frame.scopes.len() - 1
    let global = text in self.task_ids or text in self.constructors
    if text in self.frame.scopes[last] or (top_level and global)
        let poison = self.fail("E0304", "`{text}` is already defined", name.span)
    let local = self.new_local(ty, mutable)
    self.frame.scopes[last][text] = local
    self.frame.spans[local] = name.span
    return local

# `bind` for `let` and `var`, where an error must then be read.
task bind_value(change self: Checker, name: ast.Name, ty: mir.Ty, mutable: bool) -> int
    let local = self.bind(name, ty, mutable)
    # Tasks read a top-level literal from its source, not through this local.
    let top = self.frame.returns is none and self.frame.scopes.len() == 1
    var literal = false
    if top and name.text in self.top
        literal = is_literal_top(self.top[name.text])
    if not literal and self.error_members(ty) is not empty
        self.frame.kept_errors.push(KeptError(local: local, span: name.span))
    return local

type Guess
    distance: int
    name: text

# Adds a fix to E0301 if one name in sight is a close spelling. Two names at
# the same distance make the guess unsure, so neither is offered.
task similar(self: Checker, d: diag.Diagnostic, name: text, span: diag.Span) -> diag.Diagnostic
    # Only names that would work here: a task reads a top-level literal `let`
    # and no other, and top-level code sees a top-level name only once
    # declared, so already in `scopes`.
    let in_task = self.frame.returns is not none
    var names: list[text] = []
    for scope in self.frame.scopes
        for key in scope
            names.push(key)
    if in_task
        for key in self.top
            if is_literal_top(self.top[key])
                names.push(key)
    for key in self.task_ids
        names.push(key)
    for key in self.constructors
        names.push(key)
    # As rustc does: a third of the length, and at least one.
    var length = 0
    for c in name
        length += 1
    let longest = if length > 3 then length else 3
    let limit = if longest // 3 < length - 1 then longest // 3 else length - 1
    var best: list[Guess] = []
    for other in names
        if plain_name(other)
            let distance = edit_distance(name, other)
            if distance > 0 and distance <= limit
                best.push(Guess(distance: distance, name: other))
    if best is empty
        return d
    var first = best[0]
    for guess in best
        if guess.distance < first.distance or (guess.distance == first.distance and guess.name < first.name)
            first = guess
    for guess in best
        if guess.distance == first.distance and guess.name != first.name
            return d
    var out = d
    out.fix("rename to `{first.name}`", span, first.name)
    return out

# True if every character is alphanumeric or `_`.
# ponytail: ASCII letters and digits, and any non-ASCII character, as
# `diag.is_name_char` reads them.
task plain_name(name: text) -> bool
    for b in name.bytes()
        let n = b.to_int()
        let letter = (n >= 97 and n <= 122) or (n >= 65 and n <= 90)
        if not (letter or (n >= 48 and n <= 57) or n == 95 or n >= 128)
            return false
    return true

# The local of a name in scope, or -1.
task lookup(self: Checker, name: text) -> int
    var i = self.frame.scopes.len() - 1
    while i >= 0
        if name in self.frame.scopes[i]
            return self.frame.scopes[i][name]
        i -= 1
    return -1

task block(change self: Checker, stmts: list[ast.Stmt]) -> list[mir.Stmt]
    self.frame.scopes.push({})
    var lowered = self.stmts(stmts)
    self.close_scope(change lowered, -1)
    return lowered

# Ends the innermost scope. If control can reach its end, each name in it
# lets go of its value, newest first. `keep` stays, for a loop to handle.
task close_scope(change self: Checker, change stmts: list[mir.Stmt], keep: int)
    let scope = self.frame.scopes[self.frame.scopes.len() - 1]
    self.frame.scopes.pop()
    if not ends(stmts, true)

        var names: list[int] = []
        for key in scope
            if scope[key] != keep
                names.push(scope[key])
        for local in descending(names)
            stmts.push(mir.ClearStmt(local: local))

# The numbers, highest first.
task descending(items: list[int]) -> list[int]
    var out = items
    for i in 1..out.len()
        var j = i
        while j > 0 and out[j - 1] < out[j]
            out.swap(j - 1, j)
            j -= 1
    return out

# An error bound to a name must be read somewhere in its task.
task check_errors_read(change self: Checker)
    let kept = self.frame.kept_errors
    self.frame.kept_errors = []
    for entry in kept
        let ty = self.frame.locals[entry.local]
        self.unused_error(ty, entry.span)

task mark_read(change self: Checker, local: int)
    var kept: list[KeptError] = []
    for entry in self.frame.kept_errors
        if entry.local != local
            kept.push(entry)
    self.frame.kept_errors = kept

task unused_error(change self: Checker, ty: mir.Ty, span: diag.Span)
    let poison = self.note("E0328", "this `{ty.name()}` is an error that nothing uses", span, "use `try`, `else`, or `match`")

# What a `break` or `continue` leaves: each name from the scopes of the open
# loop's body, newest first.
task leaving(self: Checker) -> list[mir.Stmt]
    let open = self.frame.loop_scopes[self.frame.loop_scopes.len() - 1]
    var names: list[int] = []
    for i in open.depth..self.frame.scopes.len()
        let scope = self.frame.scopes[i]
        for key in scope
            if scope[key] != open.keep
                names.push(scope[key])
    for i in open.held..self.frame.held.len()
        names.push(self.frame.held[i])
    var out: list[mir.Stmt] = []
    for local in descending(names)
        out.push(mir.ClearStmt(local: local))
    return out

task stmts(change self: Checker, stmts: list[ast.Stmt]) -> list[mir.Stmt]
    let start = self.frame.narrowed.len()
    var out: list[mir.Stmt] = []
    for item in stmts
        let lowered = self.stmt(item)
        if lowered is mir.Stmt
            out.push(lowered)
    self.truncate_narrowed(start)
    return out

task condition(change self: Checker, value: ast.Expr, what: text) -> mir.Expr
    let lowered = self.expr(value)
    self.expect_type(lowered, mir.BoolTy, what)
    return lowered

task stmt(change self: Checker, item: ast.Stmt) -> mir.Stmt?
    self.check_busy_reads(item)
    let start = self.frame.changed.len()
    let held = self.frame.held.len()
    let lowered = self.statement(item)
    self.check_changed(item, start)
    var clears: list[int] = []
    while self.frame.held.len() > held
        clears.push(self.frame.held[self.frame.held.len() - 1])
        self.frame.held.pop()
    if lowered is mir.Stmt and clears is not empty
        var body = [lowered]
        var i = clears.len() - 1
        while i >= 0
            body.push(mir.ClearStmt(local: clears[i]))
            i -= 1
        return mir.BlockStmt(body: body)
    return lowered

task uses_of(item: ast.Stmt) -> list[ast.Use]
    var uses: list[ast.Use] = []
    for group in item.values()
        for value in group
            value.uses(change uses)
    return uses

# Nothing may touch what a `for change` has taken out.
task check_busy_reads(change self: Checker, item: ast.Stmt)
    var exclusive = false
    for busy in self.frame.busy
        if busy.exclusive
            exclusive = true
    if not exclusive
        return
    for found in uses_of(item)
        let local = self.lookup(found.root)
        if local >= 0
            var clash = false
            for busy in self.frame.busy
                if busy.exclusive and busy.local == local and ast.overlap(busy.path, found.path)
                    clash = true
            if clash
                let poison = self.note("E0326", "`{found.root}` cannot be used while `for change` visits it", found.span, "use the loop name, or move this out of the loop")

# A value that a statement reads may be a borrow that lasts to its end, so
# no other part of it may use what a `change` argument changes.
task check_changed(change self: Checker, item: ast.Stmt, start: int)
    var changed: list[Changed] = []
    for i in start..self.frame.changed.len()
        changed.push(self.frame.changed[i])
    while self.frame.changed.len() > start
        self.frame.changed.pop()
    if changed is empty
        return
    # A write reads its way down first, so a path beside it is not safe.
    var writes: list[diag.Span] = []
    for c in changed
        writes.push(c.span)
    let target = item.target()
    if target is ast.Expr
        writes.push(target.span)
    for group in item.values()
        var uses: list[ast.Use] = []
        for value in group
            value.uses(change uses)
        for c in changed
            var held = false
            for found in uses
                if found.root == c.root and in_peers(c.peers, found.span)
                    held = true
            if held
                var clash: ast.Use? = none
                for found in uses
                    if clash is none and found.root == c.root and (ast.overlap(found.path, c.path) or has_span(writes, found.span)) and not in_peers(c.peers, found.span)
                        clash = found
                if clash is ast.Use
                    var seen = false
                    for d in self.diags
                        if d.code == "E0326" and d.span == clash.span
                            seen = true
                    if not seen
                        let poison = self.note("E0326", "`{clash.root}` is used here while this statement changes it", clash.span, "split it in two, and name the value with `let`")

task in_peers(peers: list[diag.Span], span: diag.Span) -> bool
    for peer in peers
        if holds_span(peer, span)
            return true
    return false

task has_span(spans: list[diag.Span], span: diag.Span) -> bool
    for known in spans
        if known == span
            return true
    return false

task statement(change self: Checker, item: ast.Stmt) -> mir.Stmt?
    let span = item.span
    match item.kind
        TaskStmt(def) ->
            if self.frame.returns is not none or self.frame.scopes.len() > 1
                return self.nested_task(def, span)
            return none
        LetStmt(mutable, name, written, value) ->
            var want: mir.Ty? = none
            if written is ast.Type
                want = self.ty(written)
            let held = self.statement_value(value, want)
            if held is Held
                let ty = if want is mir.Ty then want else self.frame.locals[held.result]
                let read = self.held_value(held.result, ty, "this annotation", value.span)
                let local = self.bind_value(name, ty, mutable)
                return self.with_held([held.stmt, mir.SetStmt(local: local, value: read)], held.result)
            let lowered = self.expected(value, want)
            let ty = if want is mir.Ty then want else lowered.ty
            self.expect_type(lowered, ty, "this annotation")
            let local = self.bind_value(name, ty, mutable)
            return mir.SetStmt(local: local, value: lowered)
        AssignStmt(target, op, value) -> return self.assign(target, op, value, span)
        IfStmt(branches, otherwise) -> return self.if_stmt(branches, otherwise)
        WhileStmt(condition, body) ->
            self.forget_assigned(body)
            let start = self.frame.narrowed.len()
            let probe = self.condition(condition, "`while`")
            let found = self.facts(condition, true)
            self.push_facts(found)
            let held = self.frame.held.len()
            self.frame.loop_scopes.push(LoopScope(depth: self.frame.scopes.len(), keep: -1, held: held))
            let lowered = self.block(body)
            self.frame.loop_scopes.pop()
            self.truncate_narrowed(start)
            return mir.WhileStmt(condition: probe, body: lowered)
        ForStmt(changing, name, iterable, body) -> return self.for_loop(changing, name, iterable, body)
        ReturnStmt(value) ->
            var lowered = ex(mir.NoneExpr, mir.NoneTy, span)
            var matched: mir.Stmt? = none
            if value is ast.Expr
                let returns = self.frame.returns
                let held = self.statement_value(value, returns)
                if held is Held
                    matched = held.stmt
                    let read = self.read(held.result, value.span)
                    let returns = self.frame.returns
                    lowered = if returns is mir.Ty then self.widen(read, returns) else read
                else
                    let returns = self.frame.returns
                    lowered = self.expected(value, returns)
            let returns = self.frame.returns
            if returns is mir.Ty
                self.expect_type(lowered, returns, "this `return`")
            else
                let poison = self.fail("E0310", "`return` is only allowed in a task", span)
            if matched is mir.Stmt
                return mir.BlockStmt(body: [matched, mir.ReturnStmt(value: lowered)])
            return mir.ReturnStmt(value: lowered)
        PrintStmt(value) ->
            match value.kind
                TextExpr(parts) ->
                    if parts is empty
                        return mir.PrintTextStmt(value: "")
                    if parts.len() == 1
                        match parts[0]
                            LiteralText(text) -> return mir.PrintTextStmt(value: text)
                            _ -> return mir.PrintStmt(value: self.expr(value))
                    return mir.PrintStmt(value: self.expr(value))
                _ ->
                    let lowered = self.expr(value)
                    return mir.PrintStmt(value: self.showable(lowered))
        BreakStmt -> return self.jump(true, span)
        ContinueStmt -> return self.jump(false, span)
        PlaceholderStmt -> return mir.PlaceholderStmt(span: span)
        ExprStmt(value) -> return self.expr_stmt(value, span)
        UseStmt(_, _, _) -> return self.later("`use`", span)
        ExpectStmt(value) -> return self.expect_stmt(value, span)
        UnsafeStmt(body) -> return self.unsafe_block(body, span)
        _ -> return none

task jump(change self: Checker, breaks: bool, span: diag.Span) -> mir.Stmt?
    if self.frame.loop_scopes is empty
        let poison = self.fail("E0311", "`break` and `continue` need a loop", span)
        return none
    var out = self.leaving()
    out.push(if breaks then mir.BreakStmt else mir.ContinueStmt)
    return mir.BlockStmt(body: out)

# Starts a lambda or nested task. Local 0 is its record, of type `ty`, which
# a lambda with an open return type fills in at `end_closure`.
task start_closure(change self: Checker, ty: mir.Ty, returns: mir.Ty)
    self.frames.push(self.frame)
    self.frame = Frame()
    self.frame.returns = returns
    let record = self.new_local(ty, false)
    self.frame.scopes.push({})

# A parameter of a lambda or nested task, and whether it is `take`.
type ClosureParam
    name: ast.Name
    takes: bool

# Moves each counted parameter of a task value to a local of its own, and
# so does a `take` one, whose local can change. A task value owns what it is
# passed, by decision 183, so `end_closure` lists each in `Task.takes`.
# Gives the moves, which start the body.
task own_closure_params(change self: Checker, names: list[ClosureParam]) -> list[mir.Stmt]
    var moves: list[mir.Stmt] = []
    for index in 0..names.len()
        let param = index + 1
        let name = names[index].name
        let ty = self.frame.locals[param]
        if names[index].takes or ty.is_counted()
            let own = self.new_local(ty, names[index].takes)
            self.frame.spans[own] = name.span
            let last = self.frame.scopes.len() - 1
            self.frame.scopes[last][name.text] = own
            moves.push(mir.SetStmt(local: own, value: self.read(param, name.span)))
    return moves

# Ends what `start_closure` began. Gives the new value, which the task around
# it builds from what the body captured.
task end_closure(change self: Checker, params: list[mir.Ty], returns: mir.Ty, body: list[mir.Stmt], span: diag.Span) -> mir.Expr
    var lowered = body
    self.open_spawns(change lowered)
    let inside = self.frame
    self.frame = self.frames[self.frames.len() - 1]
    self.frames.pop()
    let ty = mir.TaskTy(params: params, returns: returns)
    var locals = inside.locals
    locals[0] = ty
    var captures: list[mir.Ty] = []
    var fields: list[mir.Slot] = []
    for i in 0..inside.captures.len()
        let value = inside.captures[i].value
        captures.push(value.ty)
        fields.push(mir.Slot(slot: i, value: value))
    let args = env_types(self.type_params)
    let count = params.len() + 1
    var takes: list[int] = []
    for param in 1..count
        if locals[param].is_counted()
            takes.push(param)
    self.lifted.push(mir.Task(name: "lambda", params: count, type_params: args.len(), returns: returns, locals: locals, body: lowered, span: span, captures: captures, takes: takes))
    let id = self.first_lifted + self.lifted.len() - 1
    return ex(mir.ClosureExpr(id: id, args: args, counted: 0, fields: fields), ty, span)

# A task inside a task. It is a value made at its line, under a name that
# cannot change, so it needs a name that is already bound. It reads its own
# name as its own record, which keeps it from holding itself.
task nested_task(change self: Checker, def: ast.TaskDef, span: diag.Span) -> mir.Stmt?
    let body = def.body
    if body is none
        let poison = self.fail("E0331", "an `extern` task must be at top level", span)
        return none
    let sig = def.sig
    var plain = sig.type_params is empty
    for p in sig.params
        if p.name.text == "self" or p.default is not none or p.mode == "Change"
            plain = false
    if not plain
        let poison = self.fail("E0307", "a nested task takes no type parameters, `self`, defaults, or `change`", sig.name.span)
    var params: list[mir.Ty] = []
    for param in sig.params
        let written_ty = param.ty
        params.push(if written_ty is ast.Type then self.ty(written_ty) else mir.ErrorTy)
    var returns = mir.NoneTy
    let written_returns = sig.returns
    if written_returns is ast.Type
        returns = self.ty(written_returns)
    let ty = mir.TaskTy(params: params, returns: returns)
    self.start_closure(ty, returns)
    self.frame.own_name = sig.name.text
    for i in 0..sig.params.len()
        let local = self.bind(sig.params[i].name, params[i], false)
    self.frame.params = self.frame.locals.len()
    var names: list[ClosureParam] = []
    for p in sig.params
        names.push(ClosureParam(name: p.name, takes: p.mode == "Take"))
    var lowered = self.own_closure_params(names)
    for s in self.stmts(body)
        lowered.push(s)
    self.check_returns(sig.name, returns, change lowered)
    let value = self.end_closure(params, returns, lowered, span)
    let local = self.bind(sig.name, ty, false)
    return mir.SetStmt(local: local, value: value)

# `x => x + 1`, with the types of its parameters and of its result from the
# context. A lambda with no such context is E0324.
task lambda(change self: Checker, params: list[ast.Name], body: ast.Expr, want: mir.Ty?, span: diag.Span) -> mir.Expr
    let found = literal_want(want, "task")
    if found is mir.Ty
        match found
            TaskTy(types, returns) ->
                if types.len() == params.len()
                    return self.lambda_with(params, body, types, returns, span)
                return self.fail("E0307", "this lambda has {params.len()} parameters, and needs {types.len()}", span)
            ErrorTy -> return poisoned(span)
            _ -> skip()
    let note = "write its type, as in `let f: task(int) -> int = x => x`, or pass it after the values that show its type"
    return self.note("E0324", "a lambda needs a task type here", span, note)

task lambda_with(change self: Checker, params: list[ast.Name], body_expr: ast.Expr, types: list[mir.Ty], returns: mir.Ty?, span: diag.Span) -> mir.Expr
    self.start_closure(mir.ErrorTy, if returns is mir.Ty then returns else mir.ErrorTy)
    self.frame.open_result = returns is none
    for i in 0..params.len()
        let local = self.bind(params[i], types[i], false)
    var names: list[ClosureParam] = []
    for name in params
        names.push(ClosureParam(name: name, takes: false))
    var body = self.own_closure_params(names)
    let value = self.expected(body_expr, returns)
    let result = if returns is mir.Ty then returns else value.ty
    self.expect_type(value, result, "this lambda")
    body.push(mir.ReturnStmt(value: value))
    return self.end_closure(types, result, body, span)

task in_frame(frame: Frame, name: text) -> bool
    let own = frame.own_name
    if own is text and own == name
        return true
    for scope in frame.scopes
        if name in scope
            return true
    return false

# True if a name of a local means something in the task being checked, or in
# one around it.
task visible(self: Checker, name: text) -> bool
    if self.lookup(name) >= 0 or in_frame(self.frame, name)
        return true
    for frame in self.frames
        if in_frame(frame, name)
            return true
    return false

# Reads a name of a task around this one, which this task then captures.
# `none` if no such task has the name.
task captured(change self: Checker, name: text, span: diag.Span) -> mir.Expr?
    let own = self.frame.own_name
    if own is text and own == name
        return ex(mir.LocalExpr(local: 0), self.frame.locals[0], span)
    for index in 0..self.frame.captures.len()
        if self.frame.captures[index].name == name
            return ex(mir.CaptureExpr(at: index), self.frame.captures[index].value.ty, span)
    if self.frames is empty
        return none
    let inside = self.frame
    self.frame = self.frames[self.frames.len() - 1]
    self.frames.pop()
    var found: mir.Expr? = none
    let local = self.lookup(name)
    if local >= 0 and self.frame.mutable[local]
        found = self.note("E0325", "`{name}` can change, so it cannot be captured", span, "copy it first, with `let copy = {name}`")
    else if local >= 0
        self.mark_read(local)
        found = view(self.read(local, span), self.current(local))
    else
        found = self.captured(name, span)
    self.frames.push(self.frame)
    self.frame = inside
    if found is none
        return none
    if found.ty == mir.ErrorTy
        return found
    let ty = found.ty
    self.frame.captures.push(CaptureEntry(name: name, value: found))
    return ex(mir.CaptureExpr(at: self.frame.captures.len() - 1), ty, span)

# A task used as a value. Its code is a small task that takes a record
# first, like a lambda, and calls the real one.
task task_value(change self: Checker, id: int, name: text, explicit: list[mir.Ty]?, span: diag.Span) -> mir.Expr
    if has_int(self.foreign, id)
        # A task type says nothing of `unsafe`, so a value could leave the
        # block.
        let poison = self.note("E0331", "`{name}` is an `extern` task, which is not a value", span, "call it in an `unsafe` block")
    let signature = self.signatures[id]
    var params: list[text] = []
    for entry in signature.type_params
        params.push(entry.name)
    var known: list[mir.Ty?] = []
    if explicit is list[mir.Ty]
        for ty in explicit
            known.push(ty)
    else
        for p in params
            known.push(none)
    let args = self.solved(name, params, known, self.diags.len(), span)
    if args is none
        return poisoned(span)
    let bounds = signature.bounds
    for i in 0..args.len()
        if i < bounds.len()
            for trait_name in bounds[i]
                let found = self.require(args[i], trait_name, span)
    if self.changes(id)
        return self.fail("E0307", "`{name}` has a `change` parameter, so it has no value form", span)
    var types: list[mir.Ty] = []
    for p in signature.params
        types.push(p.ty)
    let returns = signature.returns
    let ty = mir.TaskTy(params: types, returns: returns)
    var code = 0
    if id in self.task_values
        code = self.task_values[id]
    else
        let own = env_types(signature.type_params)
        # Each counted parameter moves to a local, which the call borrows or
        # takes, by decision 183.
        var locals = [ty]
        for t in types
            locals.push(t)
        let count = locals.len()
        var body: list[mir.Stmt] = []
        var values: list[mir.Expr] = []
        var takes: list[int] = []
        for index in 0..types.len()
            let t = types[index]
            var value = ex(mir.LocalExpr(local: index + 1), t, span)
            if t.is_counted()
                takes.push(index + 1)
                locals.push(t)
                body.push(mir.SetStmt(local: locals.len() - 1, value: value))
                value = ex(mir.LocalExpr(local: locals.len() - 1), t, span)
            values.push(value)
        let call = ex(mir.CallExpr(id: id, args: own, values: values), returns, span)
        body.push(mir.ReturnStmt(value: call))
        self.lifted.push(mir.Task(name: "", params: count, type_params: own.len(), returns: returns, locals: locals, body: body, span: span, takes: takes))
        code = self.first_lifted + self.lifted.len() - 1
        self.task_values[id] = code
    let shown = self.table.subst(ty, args)
    return ex(mir.ClosureExpr(id: code, args: args, counted: 0, fields: []), shown, span)

# Calls a task value. Its type has no names, so arguments are positional.
task call_value(change self: Checker, value: mir.Expr, args: list[ast.Arg], span: diag.Span) -> mir.Expr
    match value.ty
        TaskTy(params, returns) ->
            var plain = args.len() == params.len()
            for a in args
                if a.changes or a.name is not none
                    plain = false
            if not plain
                let poison = self.poison_args(args, span)
                let plural = if params.len() == 1 then "" else "s"
                return self.fail("E0307", "this task takes {params.len()} positional argument{plural}", span)
            var values: list[mir.Expr] = []
            for i in 0..args.len()
                let lowered = self.expected(args[i].value, params[i])
                self.expect_type(lowered, params[i], "this argument")
                values.push(lowered)
            return ex(mir.CallValueExpr(callee: value, values: values), returns, span)
        _ ->
            let poison = self.poison_args(args, span)
            if value.ty == mir.ErrorTy
                return poisoned(span)
            return self.fail("E0308", "`{value.ty.name()}` is not a task", value.span)

# Later branches, and any code after an `if` whose branches all leave, know
# that the earlier conditions were false.
task if_stmt(change self: Checker, branches: list[ast.Branch], otherwise: list[ast.Stmt]?) -> mir.Stmt
    let start = self.frame.narrowed.len()
    var lowered: list[mir.Branch] = []
    for branch in branches
        let probe = self.condition(branch.condition, "`if`")
        let found = self.facts(branch.condition, true)
        let rest = self.facts(branch.condition, false)
        let outer = self.frame.narrowed.len()
        self.push_facts(found)
        let body = self.block(branch.body)
        self.truncate_narrowed(outer)
        self.push_facts(rest)
        lowered.push(mir.Branch(condition: probe, body: body))
    var other: list[mir.Stmt] = []
    if otherwise is list[ast.Stmt]
        other = self.block(otherwise)
    var all_end = true
    for branch in lowered
        if not ends(branch.body, true)
            all_end = false
    if not all_end
        self.truncate_narrowed(start)
    return mir.IfStmt(branches: lowered, otherwise: other)

# `expect`. A comparison keeps both sides in locals, to show them if it
# fails. What passes narrows what follows, like an `if` that ends.
task expect_stmt(change self: Checker, value: ast.Expr, span: diag.Span) -> mir.Stmt
    var probe = self.condition(value, "`expect`")
    let found = self.facts(value, true)
    self.push_facts(found)
    var out: list[mir.Stmt] = []
    var failed = mir.TrapStmt(message: "expect failed", span: span)
    match probe.kind
        BinaryExpr(op, left, right) ->
            let left_shows = self.satisfies(left.ty, "Show")
            let shows = left_shows and self.satisfies(right.ty, "Show")
            if shows
                let kept_left = self.keep(left, change out)
                let kept_right = self.keep(right, change out)
                let parts = [ex(mir.TextExpr(value: "expect failed: "), mir.TextTy, span), shown_side(kept_left), ex(mir.TextExpr(value: " {symbol(op)} "), mir.TextTy, span), shown_side(kept_right)]
                let message = ex(mir.JoinExpr(values: parts), mir.TextTy, span)
                probe.kind = mir.BinaryExpr(op: op, left: kept_left, right: kept_right)
                failed = mir.FailStmt(value: message, span: span)
        _ -> skip()
    out.push(mir.IfStmt(branches: [mir.Branch(condition: probe, body: [])], otherwise: [failed]))
    return mir.BlockStmt(body: out)

# Runs `value` into a hidden local that lasts for this statement.
task keep(change self: Checker, value: mir.Expr, change out: list[mir.Stmt]) -> mir.Expr
    let local = self.new_local(value.ty, false)
    self.frame.held.push(local)
    out.push(mir.SetStmt(local: local, value: value))
    return ex(mir.LocalExpr(local: local), value.ty, value.span)

## Statements that a value needs first, and the local that then holds it.
type Held
    stmt: mir.Stmt
    result: int

# Lowers a value that needs its own statements first, which only the whole
# value of a statement can have: a `match`, or a `pop`, which must not change
# a list while the same statement borrows from it.
task statement_value(change self: Checker, value: ast.Expr, want: mir.Ty?) -> Held?
    match value.kind
        MatchExpr(subject, arms) -> return self.matching(subject, arms, true, want)
        CallExpr(callee, args) ->
            match callee.kind
                FieldExpr(base, name) ->
                    if name.text == "pop" and self.is_builtin(base, "pop")
                        return self.pop(base, args, value.span)
                    if name.text == "receive" and self.is_builtin(base, "receive")
                        let channel = self.expr(base)
                        return self.receive(channel, args, value.span)
                    return none
                _ -> return none
        _ -> return none

# Reads the local from `statement_value` as a `want`.
task held_value(change self: Checker, result: int, want: mir.Ty, what: text, span: diag.Span) -> mir.Expr
    let found = self.read(result, span)
    let read = self.widen(found, want)
    self.expect_type(read, want, what)
    return read

# Runs `stmts`, then lets go of the local from `statement_value`.
task with_held(self: Checker, stmts: list[mir.Stmt], result: int) -> mir.Stmt
    var out = stmts
    if self.frame.locals[result].is_counted()
        out.push(mir.ClearStmt(local: result))
    return mir.BlockStmt(body: out)

task expr_stmt(change self: Checker, value: ast.Expr, span: diag.Span) -> mir.Stmt?
    match value.kind
        MatchExpr(subject, arms) ->
            let held = self.matching(subject, arms, false, none)
            return held.stmt
        CallExpr(callee, args) ->
            match callee.kind
                FieldExpr(base, name) ->
                    if has_text(changing_calls(), name.text) and self.is_builtin(base, name.text)
                        return self.changing_call(base, name, args, span)
                    if has_text(thread_calls(), name.text) and self.is_builtin(base, name.text)
                        return self.thread_call(base, name, args, span)
                    return self.discarded(value)
                _ -> return self.discarded(value)
        _ -> return self.discarded(value)

# A value that a statement drops, which must not be an error.
task discarded(change self: Checker, value: ast.Expr) -> mir.Stmt
    let lowered = self.expr(value)
    if self.error_members(lowered.ty) is not empty
        self.unused_error(lowered.ty, lowered.span)
    return mir.ExprStmt(value: lowered)

# The members of a type that are error types.
task error_members(change self: Checker, ty: mir.Ty) -> list[mir.Ty]
    var out: list[mir.Ty] = []
    for m in ty.members_of()
        if m != mir.ErrorTy and m != mir.NoneTy and self.satisfies(m, "Error")
            out.push(m)
    return out

## A value kept for `try` or `else`: its local, the statement that fills it,
## and its type split into failure and what is left.
type Holder
    local: int
    set: mir.Stmt
    failed: mir.Ty
    rest: mir.Ty

# Starts `try` or `else`: keeps `value` in a hidden local, and splits its
# type into what counts as failure and what is left. `none` is a failure
# only in a union with no error type. Reports E0327 if nothing can fail or
# nothing is left.
task hold_failure(change self: Checker, value: mir.Expr, word: text) -> Holder?
    let ty = value.ty
    if ty == mir.ErrorTy
        return none
    let errors = self.error_members(ty)
    let failed = if errors is empty then mir.NoneTy else self.union(errors)
    let parts = self.split(ty, failed)
    if parts is none
        let note = "it needs a union of an error type or `none` and another type"
        let poison = self.note("E0327", "`{word}` has nothing to act on in `{ty.name()}`", value.span, note)
        return none
    let holder = self.new_local(ty, false)
    self.frame.held.push(holder)
    return Holder(local: holder, set: mir.SetStmt(local: holder, value: value), failed: parts.found, rest: parts.rest)

task holder_has(self: Checker, holder: int, want: mir.Ty, span: diag.Span) -> mir.Expr
    return ex(mir.HoldsExpr(inner: self.read(holder, span), tys: want.members_of()), mir.BoolTy, span)

# `try x`. See "Early exits" in docs/compiler.md.
task try_value(change self: Checker, value: ast.Expr, span: diag.Span) -> mir.Expr
    let lowered = self.expr(value)
    let h = self.hold_failure(lowered, "try")
    if h is none
        return poisoned(span)
    let probe = self.holder_has(h.local, h.failed, span)
    var leave: list[mir.Stmt] = []
    if self.frame.returns is none or self.frame.in_test
        leave = self.exit_failure(h.local, h.failed, span)
    else
        leave = self.return_failure(h.local, h.failed, span)
    let check = mir.IfStmt(branches: [mir.Branch(condition: probe, body: leave)], otherwise: [])
    let kept = view(self.read(h.local, span), h.rest)
    return ex(mir.SeqExpr(setup: [h.set, check], inner: kept), h.rest, span)

task return_failure(change self: Checker, holder: int, failed: mir.Ty, span: diag.Span) -> list[mir.Stmt]
    let want = self.frame.returns
    if want is none
        return []
    if self.frame.open_result
        let poison = self.fail("E0324", "a lambda with `try` needs a result type from its context", span)
        return []
    let held = view(self.read(holder, span), failed)
    let error = self.widen(held, want)
    if error.ty == want or want == mir.ErrorTy
        return [mir.ReturnStmt(value: error)]
    # A union stays out of an `any`, but each of its members can go in.
    let members = failed.members_of()
    let last = members[members.len() - 1]
    var branches: list[mir.Branch] = []
    var left: mir.Stmt? = self.member_return(holder, last, want, span)
    for i in 0..members.len() - 1
        let member = members[i]
        let probe = self.holder_has(holder, member, span)
        let leave = self.member_return(holder, member, want, span)
        if leave is mir.Stmt
            branches.push(mir.Branch(condition: probe, body: [leave]))
        else
            left = none
    if left is none
        let poison = self.note("E0303", "this `try` can return `{failed.name()}`", span, "the task returns `{want.name()}`, which must accept it")
        return []
    return [mir.IfStmt(branches: branches, otherwise: [left])]

task member_return(change self: Checker, holder: int, member: mir.Ty, want: mir.Ty, span: diag.Span) -> mir.Stmt?
    let held = view(self.read(holder, span), member)
    let error = self.widen(held, want)
    if error.ty == want
        return mir.ReturnStmt(value: error)
    return none

# At top level, `try` prints the error and ends the program.
task exit_failure(change self: Checker, holder: int, failed: mir.Ty, span: diag.Span) -> list[mir.Stmt]
    let members = failed.members_of()
    var branches: list[mir.Branch] = []
    for i in 0..members.len() - 1
        let probe = self.holder_has(holder, members[i], span)
        let leave = self.exit_with(holder, members[i], span)
        branches.push(mir.Branch(condition: probe, body: [leave]))
    let last = self.exit_with(holder, members[members.len() - 1], span)
    return [mir.IfStmt(branches: branches, otherwise: [last])]

task exit_with(change self: Checker, holder: int, member: mir.Ty, span: diag.Span) -> mir.Stmt
    if member == mir.NoneTy
        return mir.ExitStmt(value: ex(mir.TextExpr(value: "none"), mir.TextTy, span))
    let error = view(self.read(holder, span), member)
    return mir.ExitStmt(value: self.method_call(error, none, 0, "error_message", [], span))

# `x else y`. The value takes the type that the context asks for, if a value
# of `x` fits it, so that `y` can be wider.
task fallback(change self: Checker, value: ast.Expr, other: ast.Expr, want: mir.Ty?, span: diag.Span) -> mir.Expr
    let lowered = self.expr(value)
    let h = self.hold_failure(lowered, "else")
    if h is none
        let ignored = self.expected(other, want)
        return poisoned(span)
    var kept = view(self.read(h.local, span), h.rest)
    if want is mir.Ty
        let wide = self.widen(kept, want)
        if wide.ty == want
            kept = wide
    let ty = kept.ty
    let alternative = self.expected(other, ty)
    self.expect_type(alternative, ty, "`else`, to match the value,")
    let probe = self.holder_has(h.local, h.failed, span)
    let pick = ex(mir.IfExpr(condition: probe, yes: alternative, otherwise: kept), ty, span)
    return ex(mir.SeqExpr(setup: [h.set], inner: pick), ty, span)

## A lowered arm: its probe, or `none` if anything matches, and its body.
type ArmCode
    probe: mir.Expr?
    body: list[mir.Stmt]

# Lowers a `match` to an `if` chain over a hidden local, which keeps the
# value fixed if an arm assigns the variable it came from. The checks below
# prove that the last arm is all that can remain, so it needs no probe.
#
# `valued` is false for a statement. `want` holds the type that the context
# needs, if known. Gives the local that receives the value.
task matching(change self: Checker, subject: ast.Expr, arms: list[ast.Arm], valued: bool, want_in: mir.Ty?) -> Held
    let lowered_subject = self.expr(subject)
    let ty = lowered_subject.ty
    let holder = self.new_local(ty, false)
    let result = self.new_local(mir.NoneTy, false)
    var want = want_in
    var covered = Covered()
    var lowered: list[ArmCode] = []
    for arm in arms
        if self.missing(ty, covered) is empty
            let poison = self.fail("E0317", "this arm can never run: earlier arms cover everything", arm.pattern.span)
        self.frame.scopes.push({})
        let code = self.pattern(arm.pattern, holder, ty, change covered)
        var body = code.body
        match arm.body
            ArmExpr(arm_value) ->
                if valued
                    let value = self.expected(arm_value, want)
                    if want is none
                        want = value.ty
                    let wanted = if want is mir.Ty then want else value.ty
                    self.expect_type(value, wanted, "this arm")
                    body.push(mir.SetStmt(local: result, value: value))
                else
                    let s = self.expr_stmt(arm_value, arm_value.span)
                    if s is mir.Stmt
                        body.push(s)
            ArmStmt(item) ->
                if valued
                    match item.kind
                        PrintStmt(_) ->
                            let poison = self.fail("E0303", "this `match` needs a value, and `print` gives none", item.span)
                        _ -> skip()
                let s = self.stmt(item)
                if s is mir.Stmt
                    body.push(s)
            ArmBlock(items) ->
                for s in self.stmts(items)
                    body.push(s)
        self.close_scope(change body, -1)
        lowered.push(ArmCode(probe: code.probe, body: body))
    let missing = self.missing(ty, covered)
    if missing is not empty and ty != mir.ErrorTy and not covered.failed
        let span = if arms is empty then lowered_subject.span else arms[arms.len() - 1].pattern.span
        let poison = self.note("E0316", "this `match` does not cover every `{ty.name()}`", span, "add an arm for {mir.join_texts(missing, ", ")}")
    self.frame.locals[result] = if want is mir.Ty then want else mir.NoneTy
    var otherwise: list[mir.Stmt] = []
    if lowered is not empty
        otherwise = lowered[lowered.len() - 1].body
        lowered.pop()
    let span = lowered_subject.span
    var branches: list[mir.Branch] = []
    for code in lowered
        let found = code.probe
        let probe = if found is mir.Expr then found else ex(mir.BoolExpr(value: true), mir.BoolTy, span)
        branches.push(mir.Branch(condition: probe, body: code.body))
    var out = [mir.SetStmt(local: holder, value: lowered_subject), mir.IfStmt(branches: branches, otherwise: otherwise)]
    if ty.is_counted()
        out.push(mir.ClearStmt(local: holder))
    return Held(stmt: mir.BlockStmt(body: out), result: result)

# What no arm has covered, in the words of a note. Empty if nothing is left.
task missing(self: Checker, ty: mir.Ty, covered: Covered) -> list[text]
    if covered.all
        return []
    var out: list[text] = []
    if is_union(ty)
        for member in ty.members_of()
            if not self.covers(ty, member, covered)
                out.push("`{member.name()}`")
        return out
    let id = self.choice_of(ty)
    if id >= 0
        let variants = self.datas[id].variants
        for index in 0..variants.len()
            if not has_int(covered.variants, index)
                out.push("`{variants[index].name}`")
        return out
    if ty == mir.BoolTy
        for literal in ["true", "false"]
            if not has_text(covered.literals, literal)
                out.push("`{literal}`")
        return out
    return ["`_`"]

# Advice for a variant or type name matched straight on a union: match the
# member first. Names the choice that has the variant, if one does.
task union_member_note(self: Checker, ty: mir.Ty, name: ast.Name) -> text
    for member in ty.members_of()
        let id = self.choice_of(member)
        if id >= 0
            for variant in self.datas[id].variants
                if variant.name == name.text
                    # A choice from a module has a full path, which a pattern
                    # does not take.
                    let short = ast.short_name(self.datas[id].name.text)
                    return "`{name.text}` is a variant of `{short}`: match `e: {short}` first, then match `e` in that arm"
    return "to test what the union holds, write `x: {name.text}`"

# The `choice` that a value of this type belongs to, or -1.
task choice_of(self: Checker, ty: mir.Ty) -> int
    match ty
        DataTy(_, id, _) ->
            if self.datas[id].is_choice
                return id
            return -1
        _ -> return -1

# Finds a variant of a choice, or reports that the name is wrong. A
# misspelled variant must not become a name that catches everything.
task variant_index(change self: Checker, id: int, name: ast.Name) -> int
    let data = self.datas[id]
    for i in 0..data.variants.len()
        if data.variants[i].name == name.text
            return i
    var names: list[text] = []
    for variant in data.variants
        names.push(variant.name)
    let note = "its variants are {mir.join_texts(names, ", ")}, and `_` matches the rest"
    let poison = self.note("E0318", "`{data.name.text}` has no variant `{name.text}`", name.span, note)
    return -1

# Lowers a pattern. Gives its probe, or `none` if anything matches, and the
# statements that bind its names.
task pattern(change self: Checker, item: ast.Pattern, holder: int, ty: mir.Ty, change covered: Covered) -> ArmCode
    let span = item.span
    match item.kind
        WildcardPattern ->
            covered.all = true
            return ArmCode(probe: none, body: [])
        NonePattern -> return self.member_pattern(mir.NoneTy, none, holder, ty, change covered, span)
        TypedPattern(name, written) ->
            let target = self.ty(written)
            return self.member_pattern(target, name, holder, ty, change covered, span)
        LiteralPattern(value) -> return ArmCode(probe: self.literal(value, holder, ty, change covered), body: [])
        NamePattern(name) ->
            if self.choice_of(ty) >= 0
                return self.variant_pattern(name, none, holder, ty, change covered)
            if is_union(ty) and name.text in self.constructor_names
                covered.failed = true
                let note = self.union_member_note(ty, name)
                let poison = self.note("E0318", "`{ty.name()}` is not a `choice`", name.span, note)
                return ArmCode(probe: none, body: [])
            var left: list[mir.Ty] = []
            for member in ty.members_of()
                if not self.covers(ty, member, covered)
                    left.push(member)
            covered.all = true
            self.check_binding(name)
            let bound = self.union(left)
            let local = self.bind(name, bound, false)
            return ArmCode(probe: none, body: [mir.SetStmt(local: local, value: view(self.read(holder, span), bound))])
        VariantPattern(name, bindings) -> return self.variant_pattern(name, bindings, holder, ty, change covered)

# True if an arm has taken this member of a union.
task covers(self: Checker, ty: mir.Ty, member: mir.Ty, covered: Covered) -> bool
    return is_union(ty) and has_int(covered.variants, self.type_id(member))

# A pattern on the type a union holds: `none`, or `name: type`.
task member_pattern(change self: Checker, target: mir.Ty, name: ast.Name?, holder: int, ty: mir.Ty, change covered: Covered, span: diag.Span) -> ArmCode
    var fits = is_union(ty)
    if fits
        for member in target.members_of()
            if not mir.holds(ty.members_of(), member)
                fits = false
    if not fits
        covered.failed = true
    if not fits and ty != mir.ErrorTy and target != mir.ErrorTy
        let message = if is_union(ty) then "`{ty.name()}` never holds `{target.name()}`" else "`{ty.name()}` is not a union, so `{target.name()}` is nothing to test"
        let poison = self.fail("E0318", message, span)
    var local = -1
    if name is ast.Name
        self.check_binding(name)
        local = self.bind(name, if fits then target else mir.ErrorTy, false)
    if not fits
        return ArmCode(probe: none, body: [])
    var ids: list[int] = []
    for member in target.members_of()
        ids.push(self.type_id(member))
    var fresh = 0
    for id in ids
        if not has_int(covered.variants, id)
            fresh += 1
    for id in ids
        covered.variants.push(id)
    if fresh == 0 and self.missing(ty, covered) is not empty
        let poison = self.fail("E0317", "this arm can never run: earlier arms have `{target.name()}`", span)
    var bound: list[mir.Stmt] = []
    if local >= 0
        bound.push(mir.SetStmt(local: local, value: view(self.read(holder, span), target)))
    let probe = ex(mir.HoldsExpr(inner: self.read(holder, span), tys: target.members_of()), mir.BoolTy, span)
    return ArmCode(probe: probe, body: bound)

# A variant or type name in a binding would read as a probe, and catch
# everything. See decision 52.
task check_binding(change self: Checker, name: ast.Name)
    if name.text in self.constructor_names
        let poison = self.note("E0318", "`{name.text}` cannot be bound here", name.span, "it names a type or variant, and patterns do not nest, so use another name")

task literal(change self: Checker, value: ast.Expr, holder: int, ty: mir.Ty, change covered: Covered) -> mir.Expr?
    let span = value.span
    if not is_literal(value)
        let poison = self.fail("E0318", "a text pattern cannot hold `{{}}`", span)
        return none
    let lowered = self.lower(value, ty)
    self.expect_type(lowered, ty, "this pattern")
    if lowered.ty != ty
        covered.failed = true
        return none
    let key = match lowered.kind
        IntExpr(n) -> "{n}"
        FloatExpr(x) -> "float {x}"
        BoolExpr(b) -> "{b}"
        TextExpr(t) -> "text {t}"
        _ -> ""
    let repeated = has_text(covered.literals, key)
    if not repeated
        covered.literals.push(key)
    if repeated and self.missing(ty, covered) is not empty
        let poison = self.fail("E0317", "this arm can never run: an earlier arm has it", span)
    let held = self.read(holder, span)
    return self.binary_values("Eq", held, lowered, span)

# `bindings` is `none` if the name stands alone. Bindings take the fields in
# written order, and `_` skips one.
task variant_pattern(change self: Checker, name: ast.Name, written: list[ast.Name]?, holder: int, ty: mir.Ty, change covered: Covered) -> ArmCode
    let span = name.span
    var bound: list[mir.Stmt] = []
    let parentheses = written is not none
    let bindings = if written is list[ast.Name] then written else []
    let id = self.choice_of(ty)
    var variant = -1
    if id >= 0
        variant = self.variant_index(id, name)
    else if ty != mir.ErrorTy
        covered.failed = true
        var d = diag.new("E0318", "`{ty.name()}` is not a `choice`", span)
        if is_union(ty)
            d.notes.push(self.union_member_note(ty, name))
        let poison = self.report(d)
    if variant < 0
        for binding in bindings
            if binding.text != "_"
                let local = self.bind(binding, mir.ErrorTy, false)
        return ArmCode(probe: none, body: bound)
    let repeated = has_int(covered.variants, variant)
    if not repeated
        covered.variants.push(variant)
    if repeated and self.missing(ty, covered) is not empty
        let poison = self.fail("E0317", "this arm can never run: an earlier arm has `{name.text}`", span)
    let fields = self.datas[id].variants[variant].fields
    if fields is empty and parentheses
        let poison = self.note("E0318", "`{name.text}` has no fields", span, "write `{name.text}`, with no `()`")
    else if bindings.len() != fields.len()
        let plural = if fields.len() == 1 then "" else "s"
        let poison = self.note("E0318", "`{name.text}` has {fields.len()} field{plural}", span, "bind all {fields.len()} in order, and use `_` to skip one")
    for index in 0..bindings.len()
        let binding = bindings[index]
        let field_ty = if index < fields.len() then fields[index].ty else mir.ErrorTy
        let sub = self.subst_data(field_ty, ty)
        if binding.text != "_"
            self.check_binding(binding)
            let local = self.bind(binding, sub, false)
            let member = ex(mir.MemberExpr(inner: self.read(holder, span), variant: variant, field: index), sub, span)
            bound.push(mir.SetStmt(local: local, value: member))
    let tag = ex(mir.TagExpr(inner: self.read(holder, span)), mir.IntTy, span)
    let number = ex(mir.IntExpr(value: variant), mir.IntTy, span)
    return ArmCode(probe: ex(mir.BinaryExpr(op: "Eq", left: tag, right: number), mir.BoolTy, span), body: bound)

task read(self: Checker, local: int, span: diag.Span) -> mir.Expr
    return ex(mir.LocalExpr(local: local), self.frame.locals[local], span)

# Finds what a write changes. Each index runs once, before the value that is
# written, so that the order is the order on the page.
task place(change self: Checker, target: ast.Expr) -> Place?
    match target.kind
        NameExpr(name) -> return self.name_place(name, target.span)
        SelfExpr -> return self.name_place("self", target.span)
        IndexExpr(base, indices) ->
            let found = self.place(base)
            if found is none
                return none
            var place = found
            let container = self.frame.locals[place.local]
            let key = self.key(container, indices, target.span)
            if key is none
                return none
            let hoisted = self.hoist(key.value, change place.setup, change place.finish)
            let read = self.element(place.local, hoisted, key.ty, target.span)
            let key_read = self.read(hoisted, target.span)
            return self.step(place, key_read, read)
        FieldExpr(base, name) ->
            let found = self.place(base)
            if found is none
                return none
            let container = self.frame.locals[found.local]
            let field = self.field(container, name)
            if field is none
                return none
            let span = target.span
            let read = self.slot_of(found.local, field.slot, field.ty, span)
            return self.step(found, ex(mir.IntExpr(value: field.slot), mir.IntTy, span), read)
        _ ->
            let poison = self.note("E0305", "this value cannot change", target.span, "only a name declared with `var` can change")
            return none

task name_place(change self: Checker, name: text, span: diag.Span) -> Place?
    let local = self.variable(name, span)
    if local < 0
        return none
    let place = place_at(local)
    let ty = self.current(local)
    if ty == self.frame.locals[local] or is_union(ty)
        return place
    # A narrowed union: what it holds is a field of its record.
    let read = view(self.read(local, span), ty)
    return self.step(place, ex(mir.IntExpr(value: 0), mir.IntTy, span), read)

# Goes one level deeper: `read` is the element at `key` of `place`.
task step(change self: Checker, place_in: Place, key: mir.Expr, read: mir.Expr) -> Place
    var place = place_in
    let span = read.span
    let item = read.ty
    var step = SlotStep(slot: 0)
    var slot = -1
    match key.kind
        IntExpr(n) ->
            step = SlotStep(slot: n)
            slot = n
        LocalExpr(local) ->
            step = KeyStep(local: local)
        _ -> skip()
    place.path.push(step)
    let parent = place.local
    if self.frame.opening and slot >= 0
        for entry in self.frame.opened
            if entry.local == parent and entry.slot == slot
                place.local = entry.held
                return place
    let value = self.new_local(item, true)
    if self.frame.opening and slot >= 0
        self.frame.opened.push(Opened(local: parent, slot: slot, held: value))
    let stored = self.read(value, span)
    let container = self.frame.locals[place.local]
    let in_place = match container
        ListTy(_) -> true
        DataTy(_, _, _) -> true
        _ -> false
    if in_place
        # The slot's own count moves to the local and back, so no count
        # changes. Until `take`, the local borrows from the slot.
        place.setup.push(mir.BindStmt(local: value, value: read))
        let local = place.local
        place.take_out.push(mir.UpdateStmt(local: local, op: "Take", args: [key], span: span))
        place.finish = prepend(mir.UpdateStmt(local: local, op: "Put", args: [key, stored], span: span), place.finish)
    else
        place.setup.push(mir.SetStmt(local: value, value: read))
        let blank = ex(mir.NoneExpr, mir.NoneTy, span)
        place.take_out.push(self.write(place.local, key, blank, span))
        let write = self.write(place.local, key, stored, span)
        place.finish = prepend(write, place.finish)
        place.finish.push(mir.ClearStmt(local: value))
    place.local = value
    return place

task prepend(first: mir.Stmt, rest: list[mir.Stmt]) -> list[mir.Stmt]
    var out = [first]
    for s in rest
        out.push(s)
    return out

# Moves a value to a hidden local, so that it can be read twice or read
# before `take`. The local lets go of it when the write ends.
task hoist(change self: Checker, value: mir.Expr, change setup: list[mir.Stmt], change finish: list[mir.Stmt]) -> int
    let local = self.new_local(value.ty, false)
    if value.ty.is_counted()
        finish.push(mir.ClearStmt(local: local))
    setup.push(mir.SetStmt(local: local, value: value))
    return local

# Reads an element from the container in `local`.
task element(self: Checker, local: int, key: int, ty: mir.Ty, span: diag.Span) -> mir.Expr
    let container = self.read(local, span)
    let at = self.read(key, span)
    match self.frame.locals[local]
        ListTy(_) -> return ex(mir.ListGetExpr(value: container, at: at), ty, span)
        _ -> return ex(mir.MapGetExpr(value: container, key: at), ty, span)

task write(self: Checker, local: int, key: mir.Expr, value: mir.Expr, span: diag.Span) -> mir.Stmt
    let op = match self.frame.locals[local]
        ListTy(_) -> "ListSet"
        DataTy(_, _, _) -> "FieldSet"
        UnionTy(_) -> "UnionSet"
        _ -> "MapSet"
    return mir.UpdateStmt(local: local, op: op, args: [key, value], span: span)

task assign(change self: Checker, target: ast.Expr, op: text, value: ast.Expr, span: diag.Span) -> mir.Stmt?
    self.check_write(target)
    var name = ""
    match target.kind
        NameExpr(found) ->
            name = found
        SelfExpr ->
            name = "self"
        IndexExpr(base, indices) -> return self.assign_index(base, indices, op, value, span)
        FieldExpr(base, field) -> return self.assign_field(base, field, op, value, span)
        _ -> return none
    let local = self.variable(name, target.span)
    if local < 0
        let ignored = self.expected(value, mir.ErrorTy)
        return none
    let ty = self.frame.locals[local]
    var lowered = poisoned(span)
    let binary = compound(op)
    if binary is not empty
        let found = self.binary(binary, target, value, none, span)
        lowered = self.widen(found, ty)
    else
        let held = self.statement_value(value, ty)
        if held is Held
            let read = self.held_value(held.result, ty, "this assignment", span)
            self.forget(local)
            return self.with_held([held.stmt, mir.SetStmt(local: local, value: read)], held.result)
        lowered = self.expected(value, ty)
    self.expect_type(lowered, ty, "this assignment")
    self.forget(local)
    return mir.SetStmt(local: local, value: lowered)

# The local of a name that can change, or -1. Reports E0305 if it cannot.
task variable(change self: Checker, name: text, span: diag.Span) -> int
    let local = self.lookup(name)
    if local < 0 and name in self.task_ids
        let poison = self.fail("E0305", "`{name}` cannot change", span)
        return -1
    if local < 0
        if self.name(name, span).ty != mir.ErrorTy
            let poison = self.fail("E0305", "`{name}` cannot change", span)
        return -1
    if self.frame.locals[local] == mir.ErrorTy
        return -1
    if not self.frame.mutable[local]
        let note = if local < self.frame.params then "a parameter is read-only: declare it `change` to change the caller's value, or `take` to own a copy" else "only a name declared with `var` can change"
        let poison = self.note("E0305", "`{name}` cannot change", span, note)
    return local

# Reports E0326 if a plain `for` visits what this write changes.
task check_write(change self: Checker, target: ast.Expr)
    let found = target.path()
    if found is none
        return
    let local = self.lookup(found.root)
    if local < 0
        return
    let busy_list = self.frame.busy
    for busy in busy_list
        if not busy.exclusive and busy.local == local and ast.overlap(busy.path, found.fields)
            let poison = self.note("E0326", "`{found.root}` cannot change while a `for` visits it", target.span, "loop over a copy: `let copy = {found.root}`")
            return

task assign_index(change self: Checker, base: ast.Expr, indices: list[ast.Expr], op: text, value: ast.Expr, span: diag.Span) -> mir.Stmt?
    let found = self.place(base)
    if found is none
        let ignored = self.expected(value, mir.ErrorTy)
        return none
    var place = found
    let local = place.local
    let container = self.frame.locals[local]
    let key = self.key(container, indices, span)
    if key is none
        let ignored = self.expected(value, mir.ErrorTy)
        return none
    let hoisted = self.hoist(key.value, change place.setup, change place.finish)
    let item = key.ty
    var lowered = poisoned(span)
    let binary = compound(op)
    if binary is not empty
        let old = self.element(local, hoisted, item, span)
        let number = self.number_want(old.ty)
        let right = self.lower(value, number)
        lowered = self.binary_values(binary, old, right, span)
    else
        lowered = self.expected(value, item)
    self.expect_type(lowered, item, "this assignment")
    let ready = self.ready(lowered, change place)
    let write = self.write(local, self.read(hoisted, span), ready, span)
    return place.place_stmts(write)

task assign_field(change self: Checker, base: ast.Expr, name: ast.Name, op: text, value: ast.Expr, span: diag.Span) -> mir.Stmt?
    let found = self.place(base)
    if found is none
        let ignored = self.expected(value, mir.ErrorTy)
        return none
    var place = found
    let local = place.local
    let container = self.frame.locals[local]
    let field = self.field(container, name)
    if field is none
        let ignored = self.expected(value, mir.ErrorTy)
        return none
    let ty = field.ty
    let slot = field.slot
    let appends = op == "Set" and ty == mir.TextTy and starts_with_field(value, base, name)
    var lowered = poisoned(span)
    let binary = compound(op)
    if binary is not empty
        let old = self.slot_of(local, slot, ty, span)
        let number = self.number_want(old.ty)
        let right = self.lower(value, number)
        lowered = self.binary_values(binary, old, right, span)
    else
        lowered = self.expected(value, ty)
    self.expect_type(lowered, ty, "this assignment")
    let key = ex(mir.IntExpr(value: slot), mir.IntTy, span)
    if appends
        match lowered.kind
            JoinExpr(parts) ->
                # `b.t = "{b.t}..."` takes the text out of its slot, as a
                # path does, so the join may grow it in place, by decision
                # 222. The other parts run first, since nothing may read `b`
                # after `take`.
                var out = parts
                for i in 1..out.len()
                    if not is_text_value(out[i])
                        let hoisted = self.hoist(out[i], change place.setup, change place.finish)
                        out[i] = self.read(hoisted, span)
                let read = self.slot_of(local, slot, ty, span)
                let stepped = self.step(place, key, read)
                let text = stepped.local
                out[0] = self.read(text, span)
                lowered.kind = mir.JoinExpr(values: out)
                return stepped.place_stmts(mir.SetStmt(local: text, value: lowered))
            _ -> skip()
    let ready = self.ready(lowered, change place)
    let write = self.write(local, key, ready, span)
    return place.place_stmts(write)

task is_text_value(value: mir.Expr) -> bool
    return match value.kind
        TextExpr(_) -> true
        _ -> false

task slot_of(self: Checker, local: int, field: int, ty: mir.Ty, span: diag.Span) -> mir.Expr
    return ex(mir.MemberExpr(inner: self.read(local, span), variant: 0, field: field), ty, span)

# A field type of `data`, with the type arguments of `data` in place.
task subst_data(change self: Checker, field: mir.Ty, data: mir.Ty) -> mir.Ty
    match data
        DataTy(_, _, args) -> return self.table.subst(field, args)
        _ -> return field

## A field of a `type`: its position and type.
type FoundField
    slot: int
    ty: mir.Ty

# Finds a field of a `type`.
task field(change self: Checker, ty: mir.Ty, name: ast.Name) -> FoundField?
    var id = -1
    match ty
        ErrorTy -> return none
        DataTy(_, found, _) ->
            if self.datas[found].is_choice
                let poison = self.note("E0303", "`{ty.name()}` is a `choice`, so it has no fields", name.span, "use `match` to reach the fields of a variant")
                return none
            id = found
        UnionTy(_) ->
            let poison = self.note("E0303", "`{ty.name()}` has no field `{name.text}`", name.span, TEST_UNION)
            return none
        _ ->
            id = -1
    if id >= 0
        let fields = self.datas[id].variants[0].fields
        for index in 0..fields.len()
            if fields[index].name == name.text
                return FoundField(slot: index, ty: self.subst_data(fields[index].ty, ty))
    let poison = self.fail("E0303", "`{ty.name()}` has no field `{name.text}`", name.span)
    return none

# Lowers a value for a parameter or field of type `pattern`, whose type
# parameters may come from this value. Types flow left to right, so an
# earlier value gives a type to a later one. See decision 67. `settled`
# checks the result, once all types are known.
task inferred(change self: Checker, value: ast.Expr, pattern: mir.Ty, change known: list[mir.Ty?]) -> mir.Expr
    let want = self.table.partial(pattern, known)
    # A lambda can give a `U` that only its result shows, once `T` is known.
    if want is none
        match value.kind
            LambdaExpr(params, body) ->
                match pattern
                    TaskTy(types, returns) ->
                        var given: list[mir.Ty] = []
                        var all = true
                        for t in types
                            let part = self.table.partial(t, known)
                            if part is mir.Ty
                                given.push(part)
                            else
                                all = false
                        if all and given.len() == params.len()
                            let result = self.table.partial(returns, known)
                            let lowered = self.lambda_with(params, body, given, result, value.span)
                            self.table.unify(pattern, lowered.ty, change known)
                            return lowered
                    _ -> skip()
            _ -> skip()
    let lowered = self.expected(value, want)
    if want is none
        self.table.unify(pattern, lowered.ty, change known)
    return lowered

# Gives a value its final type, and checks it. A `none` for a `T?` could not
# widen before a later value told what `T` is.
task settled(change self: Checker, value: mir.Expr, ty: mir.Ty, what: text) -> mir.Expr
    let wide = self.widen(value, ty)
    self.expect_type(wide, ty, what)
    return wide

# Finishes type arguments. Reports E0319 for one with no answer, unless an
# error was already reported since `reported`.
task solved(change self: Checker, name: text, params: list[text], known: list[mir.Ty?], reported: int, span: diag.Span) -> list[mir.Ty]?
    var out: list[mir.Ty] = []
    for index in 0..known.len()
        let found = known[index]
        if found is none
            if self.diags.len() == reported
                let poison = self.note("E0319", "cannot tell what `{params[index]}` is here", span, "name the types, as in `{name}[int](...)`")
            return none
        out.push(found)
    return out

# Reads written type arguments, for something that takes `want` of them.
task explicit(change self: Checker, indices: list[ast.Expr], want: int, name: text, span: diag.Span) -> list[mir.Ty]?
    var args: list[mir.Ty] = []
    for index in indices
        args.push(self.expr_type(index))
    if self.arity(name, want, args.len(), span) and not mir.holds(args, mir.ErrorTy)
        return args
    return none

# Builds a `type` or a variant. Arguments are always named, and run in the
# order written, so any order keeps the order on the page. Type arguments
# come from `explicit`, then `want`, then the values.
task construct(change self: Checker, target: VariantRef, explicit: list[mir.Ty]?, want: mir.Ty?, args: list[ast.Arg], span: diag.Span) -> mir.Expr
    let id = target.data
    let variant = target.variant
    let reported = self.diags.len()
    let info = self.datas[id].variants[variant]
    let name = info.name
    let count = info.fields.len()
    var wanted: list[mir.Ty]? = none
    if want is mir.Ty
        for ty in want.members_of()
            match ty
                DataTy(_, found, found_args) ->
                    if found == id and wanted is none
                        wanted = found_args
                _ ->
                    continue
    var known: list[mir.Ty?] = []
    var types = wanted
    if explicit is list[mir.Ty]
        types = explicit
    if types is list[mir.Ty]
        for t in types
            known.push(t)
    else
        for p in self.datas[id].type_params
            known.push(none)
    var given: list[bool] = []
    for i in 0..count
        given.push(false)
    var fields: list[mir.Slot] = []
    for arg in args
        var found = -1
        let label = arg.name
        if label is ast.Name
            for index in 0..count
                if info.fields[index].name == label.text
                    found = index
        let pattern = if found >= 0 then info.fields[found].ty else mir.ErrorTy
        let value = self.inferred(arg.value, pattern, change known)
        if label is none
            let poison = self.note("E0307", "`{name}` needs named arguments", arg.value.span, "write `field: value`")
        else if found < 0
            let poison = self.fail("E0307", "`{name}` has no field `{label.text}`", label.span)
        else if given[found]
            let poison = self.fail("E0307", "`{label.text}` is given twice", label.span)
        else
            given[found] = true
            fields.push(mir.Slot(slot: found, value: value))
    for index in 0..count
        if not given[index] and info.fields[index].default is none
            let poison = self.fail("E0307", "`{name}` is missing field `{info.fields[index].name}`", span)
    var params: list[text] = []
    for entry in self.datas[id].type_params
        params.push(entry.name)
    let solved = self.solved(name, params, known, reported, span)
    if solved is none
        return poisoned(span)
    self.check_data_bounds(id, solved, span)
    for change field in fields
        let ty = self.table.subst(info.fields[field.slot].ty, solved)
        field.value = self.settled(field.value, ty, "this field")
    for index in 0..count
        if not given[index]
            let default = info.fields[index].default
            if default is mir.Expr
                var value = default
                value.ty = self.table.subst(info.fields[index].ty, solved)
                fields.push(mir.Slot(slot: index, value: value))
    var type_name = ""
    match self.datas[id].ty
        DataTy(found, _, _) ->
            type_name = found
        _ ->
            type_name = ""
    return ex(mir.NewExpr(tag: variant, counted: 0, fields: fields), mir.DataTy(name: type_name, id: id, args: solved), span)

# The `type` or variant that this name builds here, if any.
task constructor(self: Checker, name: text) -> VariantRef?
    if self.visible(name) or name in self.top or name not in self.constructors
        return none
    return self.constructors[name]

# The task with this name here, or -1.
task task_named(self: Checker, name: text) -> int
    if self.visible(name) or name in self.top or name not in self.task_ids
        return -1
    return self.task_ids[name]

# `Name(...)` with fields, or `Name[T](...)`.
task construct_call(change self: Checker, target: VariantRef, name: text, explicit: list[mir.Ty]?, want: mir.Ty?, args: list[ast.Arg], span: diag.Span) -> mir.Expr
    if self.datas[target.data].variants[target.variant].fields is empty
        return self.note("E0307", "`{name}` has no fields", span, "write `{name}`, with no `()`")
    return self.construct(target, explicit, want, args, span)

# Reads a value now if the write takes a slot that it may read.
task ready(change self: Checker, value: mir.Expr, change place: Place) -> mir.Expr
    if place.take_out is empty
        return value
    let local = self.hoist(value, change place.setup, change place.finish)
    return self.read(local, value.span)

# True if the language builds this task in for the type of `value`. Errors
# stay for the real lowering to report.
task is_builtin(change self: Checker, value: ast.Expr, name: text) -> bool
    let reported = self.diags.len()
    let found = builtin_method(self.expr(value).ty, name)
    while self.diags.len() > reported
        self.diags.pop()
    return found

task changing_call(change self: Checker, base: ast.Expr, name: ast.Name, args: list[ast.Arg], span: diag.Span) -> mir.Stmt?
    if name.text == "pop"
        let held = self.pop(base, args, span)
        return self.with_held([held.stmt], held.result)
    self.check_write(base)
    let found = self.place(base)
    if found is none
        return none
    var place = found
    let local = place.local
    let ty = self.frame.locals[local]
    var op = ""
    var wants: list[mir.Ty] = []
    match ty
        ListTy(item) ->
            if name.text == "push"
                op = "ListPush"
                wants = [item]
            else if name.text == "swap"
                op = "ListSwap"
                wants = [mir.IntTy, mir.IntTy]
        SetTy(item) ->
            if name.text == "add"
                op = "MapSet"
                wants = [item]
            else if name.text == "remove"
                op = "MapRemove"
                wants = [item]
        MapTy(key, _) ->
            if name.text == "remove"
                op = "MapRemove"
                wants = [key]
        _ ->
            op = ""
    if op is empty
        let poison = self.fail("E0303", "`{name.text}` does not work on `{ty.name()}`", span)
        return none
    var positional = args.len() == wants.len()
    for arg in args
        if arg.changes or arg.name is not none
            positional = false
    if not positional
        let plural = if wants.len() == 1 then "" else "s"
        let poison = self.fail("E0307", "`{name.text}` takes {wants.len()} positional argument{plural}", span)
        return none
    var values: list[mir.Expr] = []
    for i in 0..args.len()
        let value = self.expected(args[i].value, wants[i])
        self.expect_type(value, wants[i], "this argument")
        values.push(self.ready(value, change place))
    if name.text == "add"
        values.push(ex(mir.NoneExpr, mir.NoneTy, span))
    return place.place_stmts(mir.UpdateStmt(local: local, op: op, args: values, span: span))

# Reads the last value, and drops it, or gives `none` for an empty list.
task pop(change self: Checker, base: ast.Expr, args: list[ast.Arg], span: diag.Span) -> Held
    let nothing = mir.BlockStmt(body: [])
    self.check_write(base)
    let place = self.place(base)
    if place is none
        return Held(stmt: nothing, result: self.new_local(mir.ErrorTy, false))
    let local = place.local
    match self.frame.locals[local]
        ListTy(item) ->
            if args is not empty
                let poison = self.fail("E0307", "`pop` takes no arguments", span)
            let ty = self.union([item, mir.NoneTy])
            let result = self.new_local(ty, false)
            let list = self.read(local, span)
            let len = ex(mir.LenExpr(inner: list), mir.IntTy, span)
            let nonempty = self.binary_values("Gt", len, ex(mir.IntExpr(value: 0), mir.IntTy, span), span)
            let last = self.binary_values("Sub", len, ex(mir.IntExpr(value: 1), mir.IntTy, span), span)
            let value = ex(mir.ListGetExpr(value: list, at: last), item, span)
            let found = [mir.SetStmt(local: result, value: self.widen(value, ty)), mir.UpdateStmt(local: local, op: "ListPop", args: [], span: span)]
            let otherwise = [mir.SetStmt(local: result, value: self.widen(ex(mir.NoneExpr, mir.NoneTy, span), ty))]
            return Held(stmt: place.place_stmts(mir.IfStmt(branches: [mir.Branch(condition: nonempty, body: found)], otherwise: otherwise)), result: result)
        _ ->
            let shown = self.frame.locals[local].name()
            let poison = self.fail("E0303", "`pop` does not work on `{shown}`", span)
            return Held(stmt: nothing, result: self.new_local(mir.ErrorTy, false))

type Range
    start: mir.Expr
    end: mir.Expr

task range(change self: Checker, start: ast.Expr, end: ast.Expr) -> Range
    let first = self.expr(start)
    let last = self.expr(end)
    self.expect_type(first, mir.IntTy, "a range")
    self.expect_type(last, mir.IntTy, "a range")
    return Range(start: first, end: last)

## A loop body and the local of its loop name.
type LoopBody
    local: int
    body: list[mir.Stmt]

# Checks a loop body, in a new scope that holds the loop name.
task loop_body(change self: Checker, name: ast.Name, ty: mir.Ty, mutable: bool, body: list[ast.Stmt]) -> LoopBody
    self.forget_assigned(body)
    self.frame.scopes.push({})
    let local = self.bind(name, ty, mutable)
    let held = self.frame.held.len()
    self.frame.loop_scopes.push(LoopScope(depth: self.frame.scopes.len() - 1, keep: local, held: held))
    var lowered = self.stmts(body)
    self.frame.loop_scopes.pop()
    self.close_scope(change lowered, local)
    return LoopBody(local: local, body: lowered)

task for_loop(change self: Checker, changing: bool, name: ast.Name, iterable: ast.Expr, body: list[ast.Stmt]) -> mir.Stmt
    match iterable.kind
        BinaryExpr(op, start, end) ->
            if op == "Range" or op == "RangeInclusive"
                let bounds = self.range(start, end)
                if changing
                    let poison = self.fail("E0303", "a range has nothing to change", iterable.span)
                let found = self.loop_body(name, mir.IntTy, false, body)
                return mir.ForStmt(local: found.local, start: bounds.start, end: bounds.end, inclusive: op == "RangeInclusive", body: found.body)
        _ -> skip()
    let reported = self.diags.len()
    var value = self.expr(iterable)
    let span = value.span
    match value.ty
        ErrorTy -> skip()
        TextTy ->
            if changing
                value = self.fail("E0303", "text cannot change", span)
        ListTy(_) ->
            if changing
                # It finds its place from the source, with the same errors.
                while self.diags.len() > reported
                    self.diags.pop()
                return self.for_change(iterable, name, body)
        MapTy(_, _) ->
            if changing
                value = self.fail("E0303", "a key cannot change", span)
        SetTy(_) ->
            if changing
                value = self.fail("E0303", "a key cannot change", span)
        _ ->
            value = self.fail("E0303", "`for` cannot loop over `{value.ty.name()}`", span)
    # Text cannot change, so a `for` over it has nothing to protect.
    let found = iterable.path()
    if changing or found is none or value.ty == mir.TextTy
        return self.for_each(value, name, body)
    let local = self.lookup(found.root)
    if local < 0
        return self.for_each(value, name, body)
    self.frame.busy.push(Busy(local: local, path: found.fields, exclusive: false))
    let lowered = self.for_each(value, name, body)
    self.frame.busy.pop()
    return lowered

# `for change x in items`. The list stays out of its place for the whole
# loop, and each element is out of the list while the body runs, so both
# hold one count and every write is in place. So `x` is a plain local, and
# any way out of the body puts it back first, and any `return` puts the list
# back too.
task for_change(change self: Checker, iterable: ast.Expr, name: ast.Name, body: list[ast.Stmt]) -> mir.Stmt
    let span = iterable.span
    self.check_write(iterable)
    let found = self.place(iterable)
    if found is none
        return mir.BlockStmt(body: [])
    let place = found
    let list = place.local
    let list_ty = self.frame.locals[list]
    var item = mir.ErrorTy
    match list_ty
        ListTy(found_item) ->
            item = found_item
        _ ->
            let poison = self.fail("E0303", "`for change` needs a list", span)
            return mir.BlockStmt(body: [])
    # Every step of the path is out of its place while the body runs, so
    # only a field beside the first step can be read. A narrowed name has
    # given up its whole value.
    let root = place.root
    let written = iterable.path()
    var path: list[text] = []
    if written is ast.Path
        path = written.fields
    let narrowed = self.current(root) != self.frame.locals[root]
    let keep = if narrowed then 0 else 1
    while path.len() > keep
        path.pop()
    self.frame.busy.push(Busy(local: root, path: path, exclusive: true))
    let looped = self.loop_body(name, item, true, body)
    self.frame.busy.pop()
    let current = looped.local
    let position = self.new_local(mir.IntTy, true)
    let at = self.new_local(mir.IntTy, true)
    let pos_read = ex(mir.LocalExpr(local: position), mir.IntTy, span)
    let at_read = ex(mir.LocalExpr(local: at), mir.IntTy, span)
    let list_read = ex(mir.LocalExpr(local: list), list_ty, span)
    let len = ex(mir.LenExpr(inner: list_read), mir.IntTy, span)
    let inside = self.binary_values("Lt", pos_read, len, span)
    let next = self.binary_values("Add", pos_read, ex(mir.IntExpr(value: 1), mir.IntTy, span), span)
    let element = ex(mir.ListGetExpr(value: list_read, at: at_read), item, span)
    var start = [mir.SetStmt(local: at, value: pos_read), mir.SetStmt(local: position, value: next)]
    var back: list[mir.Stmt] = []
    let current_read = ex(mir.LocalExpr(local: current), item, span)
    if item.is_counted()
        # As in `step`: the slot's own count moves to the loop name and back.
        start.push(mir.BindStmt(local: current, value: element))
        start.push(mir.UpdateStmt(local: list, op: "Take", args: [at_read], span: span))
        back = [mir.UpdateStmt(local: list, op: "Put", args: [at_read, current_read], span: span)]
    else
        start.push(mir.SetStmt(local: current, value: element))
        back = [self.write(list, at_read, current_read, span)]
    var leave = back
    for s in place.finish
        leave.push(s)
    let inner = self.put_back_stmts(looped.body, back, leave, true)
    for s in inner
        start.push(s)
    for s in back
        start.push(s)
    var out = place.setup
    for s in place.take_out
        out.push(s)
    out.push(mir.SetStmt(local: position, value: ex(mir.IntExpr(value: 0), mir.IntTy, span)))
    out.push(mir.WhileStmt(condition: inside, body: start))
    for s in place.finish
        out.push(s)
    return mir.BlockStmt(body: out)

# Runs `back` before a `break` or `continue` of a `for change`, and `leave`
# before any `return` in its body, whose value runs first. `try` puts a
# `return` inside an expression, so this walks those too.
task put_back_stmts(change self: Checker, stmts: list[mir.Stmt], back: list[mir.Stmt], leave: list[mir.Stmt], own_loop: bool) -> list[mir.Stmt]
    var out: list[mir.Stmt] = []
    for s in stmts
        out.push(self.put_back(s, back, leave, own_loop))
    return out

task put_back(change self: Checker, s: mir.Stmt, back: list[mir.Stmt], leave: list[mir.Stmt], own_loop: bool) -> mir.Stmt
    match s
        BreakStmt ->
            if own_loop
                var block = back
                block.push(s)
                return mir.BlockStmt(body: block)
            return s
        ContinueStmt ->
            if own_loop
                var block = back
                block.push(s)
                return mir.BlockStmt(body: block)
            return s
        ReturnStmt(value) ->
            let walked = self.put_back_expr(value, back, leave)
            self.frame.locals.push(walked.ty)
            self.frame.mutable.push(false)
            let held = self.frame.locals.len() - 1
            let read = ex(mir.LocalExpr(local: held), walked.ty, walked.span)
            var block = [mir.SetStmt(local: held, value: walked)]
            for l in leave
                block.push(l)
            block.push(mir.ReturnStmt(value: read))
            return mir.BlockStmt(body: block)
        WhileStmt(condition, body) ->
            let c = self.put_back_expr(condition, back, leave)
            return mir.WhileStmt(condition: c, body: self.put_back_stmts(body, back, leave, false))
        ForStmt(local, start, end, inclusive, body) ->
            let a = self.put_back_expr(start, back, leave)
            let b = self.put_back_expr(end, back, leave)
            return mir.ForStmt(local: local, start: a, end: b, inclusive: inclusive, body: self.put_back_stmts(body, back, leave, false))
        SetStmt(local, value) -> return mir.SetStmt(local: local, value: self.put_back_expr(value, back, leave))
        BindStmt(local, value) -> return mir.BindStmt(local: local, value: self.put_back_expr(value, back, leave))
        ExitStmt(value) -> return mir.ExitStmt(value: self.put_back_expr(value, back, leave))
        FailStmt(value, span) -> return mir.FailStmt(value: self.put_back_expr(value, back, leave), span: span)
        PrintStmt(value) -> return mir.PrintStmt(value: self.put_back_expr(value, back, leave))
        ExprStmt(value) -> return mir.ExprStmt(value: self.put_back_expr(value, back, leave))
        UpdateStmt(local, op, args, span) ->
            var walked: list[mir.Expr] = []
            for arg in args
                walked.push(self.put_back_expr(arg, back, leave))
            return mir.UpdateStmt(local: local, op: op, args: walked, span: span)
        BlockStmt(body) -> return mir.BlockStmt(body: self.put_back_stmts(body, back, leave, own_loop))
        IfStmt(branches, otherwise) ->
            var walked: list[mir.Branch] = []
            for branch in branches
                let c = self.put_back_expr(branch.condition, back, leave)
                walked.push(mir.Branch(condition: c, body: self.put_back_stmts(branch.body, back, leave, own_loop)))
            return mir.IfStmt(branches: walked, otherwise: self.put_back_stmts(otherwise, back, leave, own_loop))
        _ -> return s

task put_back_expr(change self: Checker, value: mir.Expr, back: list[mir.Stmt], leave: list[mir.Stmt]) -> mir.Expr
    match value.kind
        SeqExpr(setup, inner) ->
            let stmts = self.put_back_stmts(setup, back, leave, true)
            let walked = self.put_back_expr(inner, back, leave)
            var out = value
            out.kind = mir.SeqExpr(setup: stmts, inner: walked)
            return out
        _ ->
            let parts = value.parts()
            if parts is empty
                return value
            var walked: list[mir.Expr] = []
            for part in parts
                walked.push(self.put_back_expr(part, back, leave))
            return value.with_parts(walked)

# Lowers to a `while` over a hidden position. A hidden local keeps the value
# alive and fixed, since the body may assign the variable it came from. The
# position moves before the body, so `continue` needs no separate step. A
# text position is a byte offset, a map's is an entry.
task for_each(change self: Checker, value: mir.Expr, name: ast.Name, body: list[ast.Stmt]) -> mir.Stmt
    let span = value.span
    let ty = value.ty
    var item = ty
    match ty
        ListTy(found) ->
            item = found
        SetTy(found) ->
            item = found
        MapTy(found, _) ->
            item = found
        _ ->
            item = ty
    let owner = self.new_local(ty, false)
    let position = self.new_local(mir.IntTy, true)
    let looped = self.loop_body(name, item, false, body)
    let current = looped.local
    let held = ex(mir.LocalExpr(local: owner), ty, span)
    let at = ex(mir.LocalExpr(local: position), mir.IntTy, span)
    let zero = ex(mir.IntExpr(value: 0), mir.IntTy, span)
    let one = ex(mir.IntExpr(value: 1), mir.IntTy, span)
    let after = mir.BinaryExpr(op: "Add", left: at, right: one)
    var first = mir.IntExpr(value: 0)
    var inside = mir.NoneExpr
    var read = mir.NoneExpr
    var advance = mir.NoneExpr
    match ty
        TextTy ->
            let owner_len = ex(mir.TextByteLenExpr(inner: ex(mir.LocalExpr(local: owner), ty, span)), mir.IntTy, span)
            let current_len = ex(mir.TextByteLenExpr(inner: ex(mir.LocalExpr(local: current), ty, span)), mir.IntTy, span)
            inside = mir.BinaryExpr(op: "Lt", left: at, right: owner_len)
            read = mir.TextCharAtExpr(value: held, at: at)
            advance = mir.BinaryExpr(op: "Add", left: at, right: current_len)
        ListTy(_) ->
            let len = ex(mir.LenExpr(inner: held), mir.IntTy, span)
            inside = mir.BinaryExpr(op: "Lt", left: at, right: len)
            read = mir.ListGetExpr(value: held, at: at)
            advance = after
        _ ->
            first = mir.MapNextExpr(value: held, at: zero)
            inside = mir.BinaryExpr(op: "Ge", left: at, right: zero)
            read = mir.MapKeyExpr(value: held, at: at)
            advance = mir.MapNextExpr(value: held, at: ex(after, mir.IntTy, span))
    var inner = [mir.SetStmt(local: current, value: ex(read, item, span)), mir.SetStmt(local: position, value: ex(advance, mir.IntTy, span))]
    for s in looped.body
        inner.push(s)
    return mir.BlockStmt(body: [mir.SetStmt(local: owner, value: value), mir.SetStmt(local: position, value: ex(first, mir.IntTy, span)), mir.WhileStmt(condition: ex(inside, mir.BoolTy, span), body: inner), mir.ClearStmt(local: current), mir.ClearStmt(local: owner)])

task name(change self: Checker, name: text, span: diag.Span) -> mir.Expr
    let local = self.lookup(name)
    if local >= 0
        self.mark_read(local)
        return view(self.read(local, span), self.current(local))
    let captured = self.captured(name, span)
    if captured is mir.Expr
        return captured
    if self.frame.returns is not none and name in self.top
        match self.top[name]
            LiteralTop(value, written) ->
                # Its own statement reports any error.
                let reported = self.diags.len()
                var want: mir.Ty? = none
                if written is ast.Type
                    want = self.ty(written)
                var lowered = self.expected(value, want)
                while self.diags.len() > reported
                    self.diags.pop()
                lowered.span = span
                return lowered
            VarTop -> return self.note("E0306", "a task cannot use top-level `var` `{name}`", span, "pass it as a parameter")
            LetTop -> return self.unsupported("a task reading a non-literal top-level `let`", span)
    if name in self.task_ids
        return self.task_value(self.task_ids[name], name, none, span)
    if name in self.constructors
        let target = self.constructors[name]
        if self.datas[target.data].variants[target.variant].fields is empty
            return self.construct(target, none, none, [], span)
        return self.note("E0307", "`{name}` needs its fields", span, "write `{name}(field: value)`")
    var d = diag.new("E0301", "name `{name}` is not defined", span)
    if name in self.methods
        d.notes.push("`{name}` has `self`, so it has no value form: write a lambda")
    else
        d = self.similar(d, name, span)
    return self.report(d)

# The digits of a whole number without leading zeros, or "0".
task trim_zeros(digits: text) -> text
    var at = 0
    for c in digits
        if c != "0"
            break
        at += 1
    if at == digits.len()
        return "0"
    return digits[at..digits.len()]

# The value of a digit in base 16, or -1.
task digit_value(c: text) -> int
    let found = "0123456789abcdef".find(c.lower())
    return if found is int then found else -1

# A literal has `want` if that is an integer type, or else `int`.
task int(change self: Checker, lexeme: text, want: mir.Ty?, span: diag.Span) -> mir.Expr
    var ty = mir.IntTy
    if want is mir.Ty and want.is_integer()
        ty = want
    let negative = lexeme.starts_with("-")
    var digits = ""
    for c in lexeme
        if c != "-" and c != "_"
            digits = "{digits}{c}"
    var base = 10
    if digits.starts_with("0x")
        base = 16
        digits = digits[2..digits.len()]
    else if digits.starts_with("0b")
        base = 2
        digits = digits[2..digits.len()]
    let significant = trim_zeros(digits)
    # The magnitude must fit in `u64`, as Rust parses it.
    var fits = digits is not empty
    if base == 10
        fits = fits and (significant.len() < 20 or (significant.len() == 20 and significant <= "18446744073709551615"))
    else if base == 16
        fits = fits and significant.len() <= 16
    else
        fits = fits and significant.len() <= 64
    # The low 64 bits of the magnitude, which is how Rust casts it to `i64`.
    var bits = 0
    if fits
        for c in significant
            let d = digit_value(c)
            if d < 0 or d >= base
                fits = false
            else
                bits = bits.wrapping_mul(base).wrapping_add(d)
    # A magnitude of 2^63 or more has its top bit set.
    let huge = bits < 0
    if fits
        if huge
            fits = (ty == mir.U64Ty and not negative) or (negative and bits == -9223372036854775807 - 1 and ty == mir.IntTy)
        else
            let value = if negative then 0 - bits else bits
            fits = in_range(ty, value)
    if not fits
        return self.fail("E0312", "`{lexeme}` does not fit in `{ty.name()}`", span)
    let value = if negative then bits.wrapping_mul(-1) else bits
    return ex(mir.IntExpr(value: value), ty, span)

# True if an `i64` value is in the range of an integer type.
task in_range(ty: mir.Ty, value: int) -> bool
    return match ty
        ByteTy -> value >= 0 and value <= 255
        I8Ty -> value >= -128 and value <= 127
        I16Ty -> value >= -32768 and value <= 32767
        I32Ty -> value >= -2147483648 and value <= 2147483647
        U16Ty -> value >= 0 and value <= 65535
        U32Ty -> value >= 0 and value <= 4294967295
        U64Ty -> value >= 0
        _ -> true

# A literal is a `float` unless `want` is `f32`.
task float(change self: Checker, lexeme: text, want: mir.Ty?, span: diag.Span) -> mir.Expr
    let ty = if want is mir.Ty and want == mir.F32Ty then mir.F32Ty else mir.FloatTy
    var digits = ""
    for c in lexeme
        if c != "_"
            digits = "{digits}{c}"
    var mantissa = digits
    let e = digits.lower().find("e")
    if e is int
        mantissa = digits[0..e]
    var nonzero = false
    for c in mantissa
        if c >= "1" and c <= "9"
            nonzero = true
    # JSON takes no leading zeros, and Rust ignores them.
    var start = 0
    while start + 1 < digits.len() and digits[start..start + 1] == "0" and digits[start + 1..start + 2] != "." and digits[start + 1..start + 2].lower() != "e"
        start += 1
    let parsed = json.parse[float](digits[start..digits.len()])
    match parsed
        value: float ->
            # ponytail: an `f32` literal rounds twice, through `float`, where
            # Rust rounds once. Only a literal on a halfway point can differ.
            let rounded = if ty == mir.F32Ty then value.to_f32().to_float() else value
            if rounded - rounded == 0.0 and (rounded != 0.0 or not nonzero)
                return ex(mir.FloatExpr(value: rounded), ty, span)
        _ -> skip()
    return self.fail("E0312", "`{lexeme}` does not fit in `{ty.name()}`", span)

# Lowers `value`. `want` is the type that the context needs, if known, which
# is how an empty list or map gets its type, and how a value becomes a union.
task expected(change self: Checker, value: ast.Expr, want: mir.Ty?) -> mir.Expr
    let lowered = self.lower(value, want)
    if want is mir.Ty
        return self.widen(lowered, want)
    return lowered

# The number type that `want` asks of a literal, with a `T?` counting as
# `T`.
task number_want(self: Checker, want: mir.Ty?) -> mir.Ty?
    let found = literal_want(want, "number")
    if found is mir.Ty and found.is_number()
        return found
    return none

task lower(change self: Checker, value: ast.Expr, want: mir.Ty?) -> mir.Expr
    let span = value.span
    let number = self.number_want(want)
    let found_sql = literal_want(want, "sql")
    let sql = found_sql is mir.Ty and found_sql == mir.SqlTy
    match value.kind
        TextExpr(_) ->
            # Only text that the author wrote becomes a query, by decision 195.
            if sql and is_literal(value)
                var text = self.expr(value)
                text.ty = mir.SqlTy
                return text
            return self.expr(value)
        BinaryExpr(op, left, right) ->
            if op == "Add" and sql
                return self.binary("Add", left, right, mir.SqlTy, span)
            if op == "Fallback"
                return self.fallback(left, right, want, span)
            if is_math(op)
                return self.binary(op, left, right, number, span)
            return self.expr(value)
        IntExpr(lexeme) -> return self.int(lexeme, number, span)
        FloatExpr(lexeme) -> return self.float(lexeme, number, span)
        UnaryExpr(op, inner) ->
            if op == "Neg" or op == "BitNot"
                return self.unary(op, inner, number, span)
            return self.expr(value)
        ListExpr(items) -> return self.list(items, want, span)
        MapExpr(entries) -> return self.map(entries, want, span)
        IfExpr(condition, yes, otherwise) ->
            let probe = self.condition(condition, "`if`")
            let start = self.frame.narrowed.len()
            let found = self.facts(condition, true)
            let rest = self.facts(condition, false)
            self.push_facts(found)
            let first = self.expected(yes, want)
            self.truncate_narrowed(start)
            self.push_facts(rest)
            let second = self.expected(otherwise, if want is mir.Ty then want else first.ty)
            self.truncate_narrowed(start)
            self.expect_type(second, first.ty, "`else`, to match `then`,")
            return ex(mir.IfExpr(condition: probe, yes: first, otherwise: second), first.ty, span)
        CallExpr(callee, args) -> return self.call(callee, args, want, span)
        LambdaExpr(params, body) -> return self.lambda(params, body, want, span)
        NameExpr(name) ->
            let target = self.constructor(name)
            if target is VariantRef and self.datas[target.data].variants[target.variant].fields is empty
                return self.construct(target, none, want, [], span)
            return self.expr(value)
        _ -> return self.expr(value)

# True if `name` is the built-in `built_in`, which no name of the program
# hides.
task is_built_in_call(self: Checker, name: text, built_in: text) -> bool
    return name == built_in and not self.visible(name) and name not in self.top and name not in self.task_ids

# True if `set` here means the built-in, and no name of the program hides it.
task is_set_call(self: Checker, name: text) -> bool
    return self.is_built_in_call(name, "set")

# The one plain argument of a call, if that is all it has.
task only_arg(args: list[ast.Arg]) -> ast.Expr?
    if args.len() == 1 and args[0].name is none and not args[0].changes
        return args[0].value
    return none

task set_call(change self: Checker, args: list[ast.Arg], want_in: mir.Ty?, span: diag.Span) -> mir.Expr
    let want = literal_want(want_in, "set")
    let value = only_arg(args)
    if value is none
        return self.fail("E0307", "`set` takes one list", span)
    var item: mir.Ty? = none
    if want is mir.Ty
        match want
            SetTy(found) ->
                item = found
            _ ->
                item = none
    var inner_want: mir.Ty? = none
    if want is mir.Ty and want == mir.ErrorTy
        inner_want = want
    else if item is mir.Ty
        inner_want = mir.ListTy(item: item)
    let list = self.expected(value, inner_want)
    match list.ty
        ErrorTy -> return poisoned(span)
        ListTy(listed) ->
            # The written type already reported a bad key.
            if item is none
                self.check_key(listed, list.span)
            return ex(mir.SetOfExpr(inner: list, keys: none), mir.SetTy(item: listed), span)
        _ -> return self.fail("E0303", "`set` needs a list, found `{list.ty.name()}`", list.span)

task untyped_empty(change self: Checker, what: text, want: mir.Ty?, example: text, span: diag.Span) -> mir.Expr
    if want is mir.Ty
        match want
            ErrorTy -> return poisoned(span)
            SetTy(_) -> return self.note("E0303", "an empty {what} does not fit `{want.name()}`", span, "an empty set is `set([])`")
            _ -> return self.fail("E0303", "an empty {what} does not fit `{want.name()}`", span)
    return self.note("E0314", "an empty {what} needs a type", span, "write its type, as in `{example}`")

task list(change self: Checker, items: list[ast.Expr], want_in: mir.Ty?, span: diag.Span) -> mir.Expr
    let want = literal_want(want_in, "list")
    var item: mir.Ty? = none
    if want is mir.Ty
        match want
            ListTy(found) ->
                item = found
            _ ->
                item = none
    var values: list[mir.Expr] = []
    for value in items
        let lowered = self.expected(value, item)
        if item is none
            item = lowered.ty
        let ty = if item is mir.Ty then item else lowered.ty
        self.expect_type(lowered, ty, "this list")
        values.push(lowered)
    if item is mir.Ty
        if item == mir.ErrorTy
            return poisoned(span)
        return ex(mir.ListOfExpr(values: values), mir.ListTy(item: item), span)
    return self.untyped_empty("list", want, "let x: list[int] = []", span)

task map(change self: Checker, entries: list[ast.Entry], want_in: mir.Ty?, span: diag.Span) -> mir.Expr
    let want = literal_want(want_in, "map")
    var key_ty: mir.Ty? = none
    var value_ty: mir.Ty? = none
    if want is mir.Ty
        match want
            MapTy(key, value) ->
                key_ty = key
                value_ty = value
            _ ->
                key_ty = none
    let inferred = key_ty is none
    var lowered: list[mir.MapEntry] = []
    for entry in entries
        let key = self.expected(entry.key, key_ty)
        let value = self.expected(entry.value, value_ty)
        if key_ty is none
            key_ty = key.ty
        if value_ty is none
            value_ty = value.ty
        let want_key = if key_ty is mir.Ty then key_ty else key.ty
        let want_value = if value_ty is mir.Ty then value_ty else value.ty
        self.expect_type(key, want_key, "this map")
        self.expect_type(value, want_value, "this map")
        lowered.push(mir.MapEntry(key: key, value: value))
    if key_ty is mir.Ty and value_ty is mir.Ty
        if key_ty == mir.ErrorTy or value_ty == mir.ErrorTy
            return poisoned(span)
        if inferred
            self.check_key(key_ty, span)
        return ex(mir.MapOfExpr(entries: lowered, keys: none), mir.MapTy(key: key_ty, value: value_ty), span)
    if (key_ty is mir.Ty and key_ty == mir.ErrorTy) or (value_ty is mir.Ty and value_ty == mir.ErrorTy)
        return poisoned(span)
    return self.untyped_empty("map", want, "let x: map[text, int] = {{}}", span)

task expr(change self: Checker, value: ast.Expr) -> mir.Expr
    let span = value.span
    match value.kind
        IntExpr(lexeme) -> return self.int(lexeme, none, span)
        FloatExpr(lexeme) -> return self.float(lexeme, none, span)
        BoolExpr(b) -> return ex(mir.BoolExpr(value: b), mir.BoolTy, span)
        NoneExpr -> return ex(mir.NoneExpr, mir.NoneTy, span)
        NameExpr(name) -> return self.name(name, span)
        UnaryExpr(op, inner) -> return self.unary(op, inner, none, span)
        BinaryExpr(op, left, right) ->
            if op == "Fallback"
                return self.fallback(left, right, none, span)
            return self.binary(op, left, right, none, span)
        IfExpr(_, _, _) -> return self.expected(value, none)
        ListExpr(_) -> return self.expected(value, none)
        MapExpr(_) -> return self.expected(value, none)
        CallExpr(callee, args) -> return self.call(callee, args, none, span)
        TextExpr(parts) -> return self.text(parts, span)
        IsExpr(inner, negated, target) -> return self.is_test(inner, negated, target, span)
        LambdaExpr(params, body) -> return self.lambda(params, body, none, span)
        IndexExpr(base, indices) -> return self.index(base, indices, span)
        FieldExpr(base, name) ->
            let lowered = self.expr(base)
            let field = self.field(lowered.ty, name)
            if field is none
                return poisoned(span)
            return ex(mir.MemberExpr(inner: lowered, variant: 0, field: field.slot), field.ty, span)
        SelfExpr -> return self.name("self", span)
        _ -> return self.note("E0322", "a type cannot be a value", span, "a type only goes in brackets, as in `f[int?](x)`")

task range_index(indices: list[ast.Expr]) -> bool
    return indices.len() == 1 and ast_is_range(indices[0])

task ast_is_range(value: ast.Expr) -> bool
    return match value.kind
        BinaryExpr(op, _, _) -> op == "Range" or op == "RangeInclusive"
        _ -> false

task index(change self: Checker, base: ast.Expr, indices: list[ast.Expr], span: diag.Span) -> mir.Expr
    match base.kind
        NameExpr(name) ->
            let target = self.constructor(name)
            if target is VariantRef and self.datas[target.data].variants[target.variant].fields is empty
                let args = self.explicit(indices, self.datas[target.data].type_params.len(), name, span)
                if args is none
                    return poisoned(span)
                return self.construct(target, args, none, [], span)
            let id = self.task_named(name)
            if id >= 0
                let args = self.explicit(indices, self.signatures[id].type_params.len(), name, span)
                if args is none
                    return poisoned(span)
                return self.task_value(id, name, args, span)
        _ -> skip()
    let value = self.expr(base)
    let slice = range_index(indices)
    let is_list = match value.ty
        ListTy(_) -> true
        _ -> false
    if value.ty != mir.TextTy and not (is_list and slice)
        let key = self.key(value.ty, indices, span)
        if key is none
            return poisoned(span)
        if is_list
            return ex(mir.ListGetExpr(value: value, at: key.value), key.ty, span)
        return ex(mir.MapGetExpr(value: value, key: key.value), key.ty, span)
    if not slice
        return self.note("E0303", "text needs a range index", span, "for one character, use `x[i..i + 1]`")
    match indices[0].kind
        BinaryExpr(op, start, end) ->
            let bounds = self.range(start, end)
            var last = bounds.end
            if op == "RangeInclusive"
                let one = ex(mir.IntExpr(value: 1), mir.IntTy, last.span)
                last = ex(mir.BinaryExpr(op: "Add", left: last, right: one), mir.IntTy, last.span)
            if is_list
                return ex(mir.ListSliceExpr(value: value, start: bounds.start, end: last), value.ty, span)
            return ex(mir.TextSliceExpr(value: value, start: bounds.start, end: last), value.ty, span)
        _ -> return poisoned(span)

## An index of a list or map, and the element type.
type Key
    value: mir.Expr
    ty: mir.Ty

# Checks an index of a list or map of type `ty`, or of a value that can have
# no index.
task key(change self: Checker, ty: mir.Ty, indices: list[ast.Expr], span: diag.Span) -> Key?
    match ty
        ErrorTy -> return none
        ListTy(item) ->
            if range_index(indices)
                let poison = self.note("E0305", "a list slice cannot change", span, "a slice is a new list: write to the elements of the list")
                return none
            if indices.len() == 1
                let index = self.expected(indices[0], mir.IntTy)
                self.expect_type(index, mir.IntTy, "a list index")
                return Key(value: index, ty: item)
            let poison = self.fail("E0303", "this needs one index", span)
            return none
        MapTy(key, value) ->
            if indices.len() == 1
                let index = self.expected(indices[0], key)
                self.expect_type(index, key, "a map key")
                return Key(value: index, ty: value)
            let poison = self.fail("E0303", "this needs one index", span)
            return none
        SetTy(_) ->
            let poison = self.note("E0303", "a set has no index", span, "to test for a value, use `x in items`")
            return none
        TextTy ->
            let poison = self.fail("E0303", "text cannot change", span)
            return none
        UnionTy(_) ->
            let poison = self.note("E0303", "`{ty.name()}` has no index", span, TEST_UNION)
            return none
        _ ->
            let poison = self.fail("E0303", "`{ty.name()}` has no index", span)
            return none

task is_test(change self: Checker, value: ast.Expr, negated: bool, target: ast.IsTarget, span: diag.Span) -> mir.Expr
    let lowered = self.expr(value)
    let want = self.is_target(target)
    var probe = poisoned(span)
    if want is none
        probe = self.is_empty(lowered, span)
    else if want == mir.ErrorTy or lowered.ty == mir.ErrorTy
        probe = poisoned(span)
    else
        if self.split(lowered.ty, want) is none
            var foreign = false
            if is_union(lowered.ty)
                for member in want.members_of()
                    if not mir.holds(lowered.ty.members_of(), member)
                        foreign = true
            let message = if foreign then "`{lowered.ty.name()}` never holds `{want.name()}`" else "`is {want.name()}` gives one answer for every `{lowered.ty.name()}`"
            return self.note("E0303", message, span, "`is` tests what a union holds, and `==` tests equality")
        probe = ex(mir.HoldsExpr(inner: lowered, tys: want.members_of()), mir.BoolTy, span)
    if negated and probe.ty != mir.ErrorTy
        return ex(mir.NotExpr(inner: probe), mir.BoolTy, span)
    return probe

task is_empty(change self: Checker, value: mir.Expr, span: diag.Span) -> mir.Expr
    if value.ty == mir.ErrorTy
        return poisoned(span)
    if value.ty == mir.TextTy
        return ex(mir.TextIsEmptyExpr(inner: value), mir.BoolTy, span)
    if value.ty.is_collection()
        let len = ex(mir.LenExpr(inner: value), mir.IntTy, span)
        let zero = ex(mir.IntExpr(value: 0), mir.IntTy, span)
        return ex(mir.BinaryExpr(op: "Eq", left: len, right: zero), mir.BoolTy, span)
    return self.method_call(value, none, 0, "is_empty", [], span)

# `x.get(i)` on a list, or `x.get(key)` on a map. A map's value may hold
# `none` itself, and `V?` then is `V`, as decision 39 says.
task get(change self: Checker, value: mir.Expr, args: list[ast.Arg], span: diag.Span) -> mir.Expr
    var key_ty = mir.IntTy
    var item = mir.ErrorTy
    let is_list = match value.ty
        ListTy(_) -> true
        _ -> false
    match value.ty
        ListTy(found) ->
            item = found
        MapTy(key, found) ->
            key_ty = key
            item = found
        _ -> skip()
    let arg = only_arg(args)
    if arg is none
        return self.fail("E0307", "`get` takes 1 positional argument", span)
    let lowered_key = self.expected(arg, key_ty)
    self.expect_type(lowered_key, key_ty, "this argument")
    if lowered_key.ty != key_ty
        return poisoned(span)
    let ty = self.union([item, mir.NoneTy])
    var setup: list[mir.Stmt] = []
    let held = self.repeated(value, change setup)
    let key = self.repeated(lowered_key, change setup)
    var probe = poisoned(span)
    if is_list
        let zero = ex(mir.IntExpr(value: 0), mir.IntTy, span)
        let len = ex(mir.LenExpr(inner: held), mir.IntTy, span)
        let above = self.binary_values("Ge", key, zero, span)
        let below = self.binary_values("Lt", key, len, span)
        probe = self.binary_values("And", above, below, span)
    else
        probe = ex(mir.MapHasExpr(key: key, value: held), mir.BoolTy, span)
    let read = if is_list then ex(mir.ListGetExpr(value: held, at: key), item, span) else ex(mir.MapGetExpr(value: held, key: key), item, span)
    let found = self.widen(read, ty)
    let missing = self.widen(ex(mir.NoneExpr, mir.NoneTy, span), ty)
    let pick = ex(mir.IfExpr(condition: probe, yes: found, otherwise: missing), ty, span)
    if setup is empty
        return pick
    return ex(mir.SeqExpr(setup: setup, inner: pick), ty, span)

# `x.split(separator)` on a text, which traps on an empty separator.
task text_split(change self: Checker, value: mir.Expr, args: list[ast.Arg], span: diag.Span) -> mir.Expr
    let arg = only_arg(args)
    if arg is none
        let poison = self.poison_args(args, span)
        return self.fail("E0307", "`split` takes 1 positional argument", span)
    let lowered = self.expected(arg, mir.TextTy)
    self.expect_type(lowered, mir.TextTy, "this argument")
    if lowered.ty != mir.TextTy
        return poisoned(span)
    var setup: list[mir.Stmt] = []
    let held = self.repeated(value, change setup)
    let separator = self.repeated(lowered, change setup)
    let blank = ex(mir.TextIsEmptyExpr(inner: separator), mir.BoolTy, span)
    setup.push(mir.IfStmt(branches: [mir.Branch(condition: blank, body: [mir.TrapStmt(message: "split by empty text", span: span)])], otherwise: []))
    let ty = mir.ListTy(item: mir.TextTy)
    let call = ex(mir.ForeignExpr(symbol: "lucid_text_split", values: [held, separator]), ty, span)
    return ex(mir.SeqExpr(setup: setup, inner: call), ty, span)

# `x.starts_with(part)`, `x.ends_with(part)`, `x.contains(part)`, and
# `x.find(part)`, which gives the `int?` character index of the first match.
# The runtime gives -1 for no match.
task text_part(change self: Checker, value: mir.Expr, name: text, args: list[ast.Arg], span: diag.Span) -> mir.Expr
    let arg = only_arg(args)
    if arg is none
        let poison = self.poison_args(args, span)
        return self.fail("E0307", "`{name}` takes 1 positional argument", span)
    let part = self.expected(arg, mir.TextTy)
    self.expect_type(part, mir.TextTy, "this argument")
    if part.ty != mir.TextTy
        return poisoned(span)
    var symbol = "lucid_text_find"
    if name == "starts_with"
        symbol = "lucid_text_starts_with"
    else if name == "ends_with"
        symbol = "lucid_text_ends_with"
    if symbol != "lucid_text_find"
        return ex(mir.ForeignExpr(symbol: symbol, values: [value, part]), mir.BoolTy, span)
    let call = ex(mir.ForeignExpr(symbol: symbol, values: [value, part]), mir.IntTy, span)
    let zero = ex(mir.IntExpr(value: 0), mir.IntTy, span)
    if name == "contains"
        return ex(mir.BinaryExpr(op: "Ge", left: call, right: zero), mir.BoolTy, span)
    let ty = self.union([mir.IntTy, mir.NoneTy])
    let local = self.new_local(mir.IntTy, false)
    let at = self.read(local, span)
    let probe = ex(mir.BinaryExpr(op: "Ge", left: at, right: zero), mir.BoolTy, span)
    let found = self.widen(at, ty)
    let missing = self.widen(ex(mir.NoneExpr, mir.NoneTy, span), ty)
    let read = ex(mir.IfExpr(condition: probe, yes: found, otherwise: missing), ty, span)
    return ex(mir.SeqExpr(setup: [mir.SetStmt(local: local, value: call)], inner: read), ty, span)

task text_to_int(change self: Checker, value: mir.Expr, span: diag.Span) -> mir.Expr
    let ty = self.union([mir.IntTy, mir.NoneTy])
    var setup: list[mir.Stmt] = []
    let held = self.repeated(value, change setup)
    let probe = ex(mir.ForeignExpr(symbol: "lucid_text_is_int", values: [held]), mir.BoolTy, span)
    let found = self.widen(ex(mir.ForeignExpr(symbol: "lucid_text_int", values: [held]), mir.IntTy, span), ty)
    let missing = self.widen(ex(mir.NoneExpr, mir.NoneTy, span), ty)
    let read = ex(mir.IfExpr(condition: probe, yes: found, otherwise: missing), ty, span)
    if setup is empty
        return read
    return ex(mir.SeqExpr(setup: setup, inner: read), ty, span)

# Makes a value safe to read twice. A plain read stays as it is: a hidden
# local keeps a count until it is overwritten, so the next write to that list
# would copy.
task repeated(change self: Checker, value: mir.Expr, change setup: list[mir.Stmt]) -> mir.Expr
    if repeatable(value)
        return value
    let local = self.new_local(value.ty, false)
    setup.push(mir.SetStmt(local: local, value: value))
    return self.read(local, value.span)

# Reports a value that `print` and interpolation cannot show.
task showable(change self: Checker, value: mir.Expr) -> mir.Expr
    if not self.require(value.ty, "Show", value.span)
        return poisoned(value.span)
    return value

task text(change self: Checker, parts: list[ast.TextPart], span: diag.Span) -> mir.Expr
    var values: list[mir.Expr] = []
    for part in parts
        match part
            LiteralText(value) -> values.push(ex(mir.TextExpr(value: value), mir.TextTy, span))
            ExprText(inner) ->
                let lowered = self.expr(inner)
                let shown = self.showable(lowered)
                if shown.ty == mir.TextTy or shown.ty == mir.ErrorTy
                    values.push(shown)
                else
                    values.push(ex(mir.ToTextExpr(inner: shown), mir.TextTy, shown.span))
    if values is empty
        return ex(mir.TextExpr(value: ""), mir.TextTy, span)
    if values.len() == 1
        return values[0]
    return ex(mir.JoinExpr(values: values), mir.TextTy, span)

# True for an integer type with negative values.
task signed(ty: mir.Ty) -> bool
    return ty == mir.IntTy or ty == mir.I8Ty or ty == mir.I16Ty or ty == mir.I32Ty

task unary(change self: Checker, op: text, value: ast.Expr, hint: mir.Ty?, span: diag.Span) -> mir.Expr
    if op == "Neg"
        let lowered = self.lower(value, hint)
        let ty = lowered.ty
        if ty == mir.ErrorTy
            return poisoned(span)
        if ty.is_float()
            return ex(mir.NegExpr(inner: lowered), ty, span)
        if ty.is_integer() and signed(ty)
            let zero = ex(mir.IntExpr(value: 0), ty, span)
            return ex(mir.BinaryExpr(op: "Sub", left: zero, right: lowered), ty, span)
        if ty.is_integer()
            return self.fail("E0303", "`-` needs a signed number, found `{ty.name()}`", lowered.span)
        return self.fail("E0303", "`-` needs a number, found `{ty.name()}`", lowered.span)
    if op == "BitNot"
        # All bits set, in the width and extension of the type.
        let lowered = self.lower(value, hint)
        let ty = lowered.ty
        if ty == mir.ErrorTy
            return poisoned(span)
        if ty.is_integer()
            var ones = -1
            if ty == mir.ByteTy
                ones = 255
            else if ty == mir.U16Ty
                ones = 65535
            else if ty == mir.U32Ty
                ones = 4294967295
            let all = ex(mir.IntExpr(value: ones), ty, span)
            return ex(mir.BinaryExpr(op: "BitXor", left: lowered, right: all), ty, span)
        return self.fail("E0303", "`~` needs an integer, found `{ty.name()}`", lowered.span)
    if op == "Not"
        let lowered = self.condition(value, "`not`")
        return ex(mir.NotExpr(inner: lowered), mir.BoolTy, span)
    if op == "Try"
        return self.try_value(value, span)
    if op == "Spawn"
        return self.spawn_call(value, span)
    return self.unsupported("`shared` and `weak`", span)

# True if a written value is a call to the built-in `set`.
task is_set_value(self: Checker, value: ast.Expr) -> bool
    match value.kind
        CallExpr(callee, _) ->
            match callee.kind
                NameExpr(name) -> return self.is_set_call(name)
                _ -> return false
        _ -> return false

task sql_of(ty: mir.Ty) -> mir.Ty?
    return if ty == mir.SqlTy then ty else none

task first_of(a: mir.Ty?, b: mir.Ty?) -> mir.Ty?
    return if a is mir.Ty then a else b

# A literal takes the number type of the other side, or else `hint`.
task binary(change self: Checker, op: text, left: ast.Expr, right: ast.Expr, hint: mir.Ty?, span: diag.Span) -> mir.Expr
    if op == "In" or op == "NotIn"
        return self.contains(op, left, right, span)
    if op == "Range" or op == "RangeInclusive"
        return self.unsupported("a range outside `for`", span)
    if op == "And" or op == "Or"
        let first = self.expr(left)
        let start = self.frame.narrowed.len()
        let found = self.facts(left, op == "And")
        self.push_facts(found)
        let second = self.expr(right)
        self.truncate_narrowed(start)
        return self.binary_values(op, first, second, span)
    # A text literal next to a query is a query too.
    let sql_side = op == "Add" or op == "Eq" or op == "Ne"
    if (literal_math(left) and not literal_math(right)) or (sql_side and literal_text(left) and not literal_text(right) and hint is none)
        let second = self.lower(right, hint)
        let want = first_of(first_of(self.number_want(second.ty), sql_of(second.ty)), hint)
        let first = self.lower(left, want)
        return self.binary_values(op, first, second, span)
    let first = self.lower(left, hint)
    # A collection literal takes its element type from the other side.
    let literal = match right.kind
        ListExpr(_) -> true
        MapExpr(_) -> true
        _ -> false
    var want: mir.Ty? = none
    if self.is_set_value(right) or literal
        if first.ty.is_collection()
            want = first.ty
    else
        want = first_of(first_of(self.number_want(first.ty), sql_of(first.ty)), hint)
    let second = self.lower(right, want)
    return self.binary_values(op, first, second, span)

task contains(change self: Checker, op: text, left: ast.Expr, right: ast.Expr, span: diag.Span) -> mir.Expr
    # A literal takes its type from the other side, so that side goes first.
    var first: mir.Expr? = none
    if not literal_math(left)
        first = self.expr(left)
    var collection: mir.Ty? = none
    if first is mir.Expr and first.ty != mir.ErrorTy
        match right.kind
            ListExpr(_) ->
                collection = mir.ListTy(item: first.ty)
            _ ->
                if self.is_set_value(right)
                    collection = mir.SetTy(item: first.ty)
    let lowered = self.lower(right, collection)
    var item = mir.ErrorTy
    var list = false
    match lowered.ty
        ErrorTy ->
            if first is none
                let ignored = self.expr(left)
            return poisoned(span)
        ListTy(found) ->
            item = found
            list = true
        SetTy(found) ->
            item = found
        MapTy(found, _) ->
            item = found
        _ ->
            if first is none
                let ignored = self.expr(left)
            return self.fail("E0303", "`in` needs a list, map, or set, found `{lowered.ty.name()}`", lowered.span)
    var value = poisoned(span)
    if first is mir.Expr
        value = first
    else
        let number = self.number_want(item)
        value = self.lower(left, number)
    if list and not self.require(item, "Equal", lowered.span)
        return poisoned(span)
    let wide = self.widen(value, item)
    self.expect_type(wide, item, "`in`")
    let found = if list then ex(mir.ListHasExpr(item: wide, value: lowered), mir.BoolTy, span) else ex(mir.MapHasExpr(key: wide, value: lowered), mir.BoolTy, span)
    if op == "In"
        return found
    return ex(mir.NotExpr(inner: found), mir.BoolTy, span)

task binary_values(change self: Checker, op: text, left: mir.Expr, right: mir.Expr, span: diag.Span) -> mir.Expr
    if left.ty == mir.ErrorTy or right.ty == mir.ErrorTy
        return poisoned(span)
    let name = symbol(op)
    if op == "And" or op == "Or"
        self.expect_type(left, mir.BoolTy, "`{name}`")
        self.expect_type(right, mir.BoolTy, "`{name}`")
        let yes = if op == "And" then right else ex(mir.BoolExpr(value: true), mir.BoolTy, span)
        let no = if op == "And" then ex(mir.BoolExpr(value: false), mir.BoolTy, span) else right
        return ex(mir.IfExpr(condition: left, yes: yes, otherwise: no), mir.BoolTy, span)
    if left.ty != right.ty
        let a = left.ty.name()
        let b = right.ty.name()
        var d = diag.new("E0303", "`{name}` needs one type on both sides, found `{a}` and `{b}`", span)
        let union = left.ty == mir.NoneTy or right.ty == mir.NoneTy or is_union(left.ty) or is_union(right.ty)
        let numbers = left.ty.is_number() and right.ty.is_number()
        let plain = (left.ty == mir.IntTy and right.ty == mir.FloatTy) or (left.ty == mir.FloatTy and right.ty == mir.IntTy)
        if union and self.frames is not empty
            d.notes.push("test a union with `is`. A captured name does not narrow, so test a `let` copy of it")
        else if union
            d.notes.push("narrow a union with `is` first, as in `x is none`, or give a fallback with `else`")
        else if left.ty == mir.SqlTy or right.ty == mir.SqlTy
            d.notes.push(JOIN_SQL)
        else if left.ty == mir.TextTy or right.ty == mir.TextTy
            d.notes.push(JOIN_TEXT)
        else if numbers and not plain
            d.notes.push("conversions are explicit: use `.to_{a}()`")
        else if numbers
            d.notes.push("conversions are explicit: use `.to_float()` or `.to_int()`")
        return self.report(d)
    let ty = left.ty
    if ty == mir.SqlTy and op == "Add"
        return ex(mir.JoinExpr(values: [left, right]), ty, span)
    let equality = op == "Eq" or op == "Ne"
    let order = op == "Lt" or op == "Le" or op == "Gt" or op == "Ge"
    let int_only = is_math(op) and not has_text(["Add", "Sub", "Mul", "Div"], op)
    var valid = false
    let generic = mir.is_param(ty)
    if ty.is_integer()
        valid = true
    else if ty.is_float()
        valid = not int_only
    else if ty == mir.BoolTy
        valid = equality
    else if ty == mir.TextTy
        valid = equality or order
    else if ty == mir.SqlTy
        valid = equality
    else if (ty.is_compound() or ty.is_handle() or generic or is_task_ty(ty)) and (equality or order)
        let trait_name = if equality then "Equal" else "Order"
        if not self.require(ty, trait_name, span)
            return poisoned(span)
        valid = true
    else if (ty.is_compound() or generic) and not int_only
        var trait_name = "Div"
        if op == "Add"
            trait_name = "Add"
        else if op == "Sub"
            trait_name = "Sub"
        else if op == "Mul"
            trait_name = "Mul"
        if not self.require(ty, trait_name, span)
            return poisoned(span)
        valid = true
    if not valid
        let needs = if int_only then "`int`" else "a number"
        var d = diag.new("E0303", "`{name}` needs {needs}, found `{ty.name()}`", left.span)
        if ty == mir.TextTy and op == "Add"
            d.notes.push(JOIN_TEXT)
        return self.report(d)
    var result = ty
    if equality or order
        result = mir.BoolTy
    else if op == "Div" and ty.is_integer()
        result = mir.FloatTy
    if op == "Div" and ty.is_integer()
        let a = ex(mir.ConvertExpr(inner: left), mir.FloatTy, left.span)
        let b = ex(mir.ConvertExpr(inner: right), mir.FloatTy, right.span)
        return ex(mir.BinaryExpr(op: op, left: a, right: b), result, span)
    return ex(mir.BinaryExpr(op: op, left: left, right: right), result, span)

task call(change self: Checker, callee: ast.Expr, args: list[ast.Arg], want: mir.Ty?, span: diag.Span) -> mir.Expr
    match callee.kind
        FieldExpr(base, name) ->
            let reported = self.diags.len()
            let value = self.expr(base)
            return self.dot_call(value, base, reported, name, args, span)
        NameExpr(name) ->
            if self.is_set_call(name)
                return self.set_call(args, want, span)
            if self.is_built_in_call(name, "channel")
                return self.new_channel(none, args, want, span)
            if self.is_built_in_call(name, "lock")
                return self.new_lock(args, want, span)
            let target = self.constructor(name)
            if target is VariantRef
                return self.construct_call(target, name, none, want, args, span)
            let id = self.task_named(name)
            if id >= 0
                return self.task_call(id, name, none, none, args, span)
            if self.visible(name) or name in self.top
                let value = self.name(name, callee.span)
                if is_task_ty(value.ty) or value.ty == mir.ErrorTy
                    return self.call_value(value, args, span)
                let poison = self.poison_args(args, span)
                return self.fail("E0308", "`{name}` is not a task", callee.span)
            let poison = self.poison_args(args, span)
            var d = diag.new("E0301", "name `{name}` is not defined", callee.span)
            if name in self.methods
                d.notes.push("`{name}` has `self`, so call it with a dot: `x.{name}()`")
            else
                d = self.similar(d, name, callee.span)
            return self.report(d)
        IndexExpr(base, indices) ->
            match base.kind
                NameExpr(name) ->
                    if self.is_built_in_call(name, "channel")
                        return self.new_channel(indices, args, want, span)
                    let target = self.constructor(name)
                    if target is VariantRef
                        let types = self.explicit(indices, self.datas[target.data].type_params.len(), name, span)
                        if types is none
                            return self.poison_args(args, span)
                        return self.construct_call(target, name, types, none, args, span)
                    let id = self.task_named(name)
                    if id >= 0
                        let types = self.explicit(indices, self.signatures[id].type_params.len(), name, span)
                        if types is none
                            return self.poison_args(args, span)
                        return self.task_call(id, name, types, none, args, span)
                _ -> skip()
            let value = self.expr(callee)
            return self.call_value(value, args, span)
        _ ->
            let value = self.expr(callee)
            return self.call_value(value, args, span)

# The value before the dot of a call, what its type shows about the task's
# type parameters, and for a `change` receiver, where it came from.
type Receiver
    value: mir.Expr
    known: list[mir.Ty?]
    base: ast.Expr?
    place: Place?

# Named arguments follow positional ones, in parameter order, so that the
# order of evaluation is always the order on the page.
task task_call(change self: Checker, id: int, name: text, explicit: list[mir.Ty]?, receiver: Receiver?, args: list[ast.Arg], span: diag.Span) -> mir.Expr
    if has_int(self.foreign, id)
        self.need_unsafe("`{name}`, an `extern` task,", span)
    let reported = self.diags.len()
    let opened = self.frame.opened.len()
    let signature = self.signatures[id]
    let params = signature.params
    var known: list[mir.Ty?] = []
    if explicit is list[mir.Ty]
        for t in explicit
            known.push(t)
    else if receiver is Receiver
        known = receiver.known
    else
        for p in signature.type_params
            known.push(none)
    let count = params.len()
    var required = 0
    for p in params
        if p.default is none
            required += 1
    var values: list[mir.Expr?] = []
    var places: list[Place?] = []
    for i in 0..count
        values.push(none)
        places.push(none)
    var next = 0
    var changed: list[ast.Expr] = []
    var peers: list[diag.Span] = []
    if receiver is Receiver
        values[0] = receiver.value
        next = 1
        let base = receiver.base
        if base is ast.Expr
            peers.push(base.span)
            changed.push(base)
            places[0] = receiver.place
    var named = false
    for arg in args
        var want = -1
        let label = arg.name
        if label is ast.Name
            for i in 0..count
                if want < 0 and params[i].name == label.text
                    want = i
        else if next < count
            want = next
        let pattern = if want >= 0 then params[want].ty else mir.ErrorTy
        let mode = if want >= 0 then params[want].mode else ""
        let span_arg = arg.value.span
        if mode is not empty and mode != "Change" and arg.changes
            let poison = self.fail("E0307", "this parameter of `{name}` is not `change`", span_arg)
        if mode == "Change" and not arg.changes
            let note = if arg.name is not none then "pass it by position, as `change x`" else "write `change` before it"
            let poison = self.note("E0307", "`{name}` changes this argument, so mark it", span_arg, note)
        let before = self.frame.changed.len()
        var place: Place? = none
        var value = poisoned(span_arg)
        if mode == "Change" and arg.changes
            peers.push(span_arg)
            changed.push(arg.value)
            place = self.change_place(arg.value, pattern)
            if place is Place
                let ty = self.frame.locals[place.local]
                self.table.unify(pattern, ty, change known)
                value = ex(mir.ChangeExpr(local: place.local), ty, span_arg)
        else
            value = self.inferred(arg.value, pattern, change known)
        if not arg.changes and not value.ty.is_counted() and value.ty != mir.ErrorTy and self.frame.changed.len() == before
            peers.push(span_arg)
        var problem = ""
        var slot = -1
        if label is ast.Name
            named = true
            var found = -1
            for i in 0..count
                if found < 0 and params[i].name == label.text
                    found = i
            if found < 0
                problem = "`{name}` has no parameter `{label.text}`"
            else if params[found].default is none
                problem = "`{label.text}` has no default, so pass it by position"
            else if found < next
                problem = "`{label.text}` is out of parameter order"
            else
                slot = found
        else if named
            problem = "a positional argument cannot follow a named one"
        else if next >= required
            problem = "`{name}` has too many positional arguments"
        else
            slot = next
        if slot >= 0
            values[slot] = value
            places[slot] = place
            next = slot + 1
        else
            let poison = self.fail("E0307", problem, arg.value.span)
    while self.frame.opened.len() > opened
        self.frame.opened.pop()
    for arg in changed
        let found = arg.path()
        if found is ast.Path
            self.frame.changed.push(Changed(root: found.root, path: found.fields, span: arg.span, peers: peers))
    for slot in 0..count
        if values[slot] is none and params[slot].default is none
            let poison = self.fail("E0307", "`{name}` is missing argument `{params[slot].name}`", span)
    var type_names: list[text] = []
    for entry in signature.type_params
        type_names.push(entry.name)
    let types = self.solved(name, type_names, known, reported, span)
    if types is none
        return poisoned(span)
    for i in 0..types.len()
        if i < signature.bounds.len()
            for trait_name in signature.bounds[i]
                let found = self.require(types[i], trait_name, span)
    var setup: list[mir.Stmt] = []
    var take_out: list[mir.Stmt] = []
    var finish: list[mir.Stmt] = []
    var paths = false
    for place in places
        if place is Place and place.setup is not empty
            paths = true
    var changing: list[Place] = []
    var lowered: list[mir.Expr] = []
    for slot in 0..count
        let param = params[slot]
        let ty = self.table.subst(param.ty, types)
        let value = values[slot]
        let place = places[slot]
        if value is mir.Expr and place is Place
            if ty != mir.ErrorTy and value.ty != mir.ErrorTy and ty != value.ty
                let poison = self.note("E0303", "a `change` argument must be `{ty.name()}`, found `{value.ty.name()}`", value.span, "the task may store any such value, so types must match")
            lowered.push(value)
            for s in place.setup
                setup.push(s)
            for s in place.take_out
                take_out.push(s)
            var joined = place.finish
            for s in finish
                joined.push(s)
            finish = joined
            changing.push(place)
        else if value is mir.Expr
            let settled = self.settled(value, ty, "this argument")
            let plain = match settled.kind
                LocalExpr(_) -> true
                IntExpr(_) -> true
                _ -> false
            if paths and not plain
                let held = self.hoist(settled, change setup, change finish)
                lowered.push(self.read(held, settled.span))
            else
                lowered.push(settled)
        else
            let default = param.default
            if default is mir.Expr
                var filled = default
                filled.ty = ty
                lowered.push(filled)
    self.check_overlap(changing, change setup, span)
    let ty = self.table.subst(signature.returns, types)
    var kind = mir.CallExpr(id: id, args: types, values: lowered)
    if signature.in_trait
        kind = mir.MethodExpr(name: signature.name.text, values: lowered)
    let call = ex(kind, ty, span)
    if setup is empty and take_out is empty and finish is empty
        return call
    var last = mir.ExprStmt(value: call)
    var value = ex(mir.NoneExpr, ty, span)
    if ty != mir.NoneTy
        let result = self.new_local(ty, false)
        last = mir.SetStmt(local: result, value: call)
        value = self.read(result, span)
    for s in take_out
        setup.push(s)
    setup.push(last)
    for s in finish
        setup.push(s)
    return ex(mir.SeqExpr(setup: setup, inner: value), ty, span)

# Finds the place of a `change` argument. A name whose declared type is the
# one wanted goes whole, and may come back with any member.
task change_place(change self: Checker, target: ast.Expr, pattern: mir.Ty) -> Place?
    let name = match target.kind
        NameExpr(name) -> name
        SelfExpr -> "self"
        _ -> ""
    if name is not empty
        let local = self.lookup(name)
        if local >= 0
            self.mark_read(local)
            # A union narrowed to a smaller union also goes whole.
            if self.frame.locals[local] == pattern or is_union(self.current(local))
                self.forget(local)
    self.check_write(target)
    let opening = self.frame.opening
    self.frame.opening = true
    let place = self.place(target)
    self.frame.opening = opening
    return place

# Two `change` arguments must not meet. Fields can be told apart here. Two
# indexes may be equal, so they are tested when the call runs.
task check_overlap(change self: Checker, places: list[Place], change setup: list[mir.Stmt], span: diag.Span)
    for index in 0..places.len()
        let first = places[index]
        for j in index + 1..places.len()
            let second = places[j]
            if second.root == first.root
                var differs = -1
                let n = if first.path.len() < second.path.len() then first.path.len() else second.path.len()
                for k in 0..n
                    if differs < 0 and first.path[k] != second.path[k]
                        differs = k
                if differs < 0
                    let poison = self.note("E0326", "two `change` arguments of this call overlap", span, "each one needs a value of its own")
                else
                    match first.path[differs]
                        KeyStep(a) ->
                            match second.path[differs]
                                KeyStep(b) ->
                                    let left = self.read(a, span)
                                    let right = self.read(b, span)
                                    let same = self.binary_values("Eq", left, right, span)

                                    let trap = mir.TrapStmt(message: "two `change` arguments overlap", span: span)
                                    setup.push(mir.IfStmt(branches: [mir.Branch(condition: same, body: [trap])], otherwise: []))
                                _ ->
                                    continue
                        _ ->
                            continue

# The task of this name in the traits of a type parameter or an `any`, or -1.
task trait_task(self: Checker, ty: mir.Ty, name: text) -> int
    var traits: list[text] = []
    match ty
        ParamTy(_, index) ->
            if index < self.bounds.len()
                traits = self.bounds[index]
        AnyTy(held) ->
            traits = [held]
        _ -> return -1
    for t in traits
        if t in self.traits
            for id in self.traits[t]
                if self.signatures[id].name.text == name
                    return id
    return -1

# The position and type of a field of a `type` that holds a task value.
task task_field(change self: Checker, ty: mir.Ty, name: text) -> FoundField?
    match ty
        DataTy(_, id, _) ->
            if self.datas[id].is_choice
                return none
            let fields = self.datas[id].variants[0].fields
            for index in 0..fields.len()
                if fields[index].name == name
                    let field = self.subst_data(fields[index].ty, ty)
                    if is_task_ty(field)
                        return FoundField(slot: index, ty: field)
                    return none
            return none
        _ -> return none

# `x.f(a)` for a task with a `self` parameter. On a type parameter or an
# `any` it looks in their traits, and the monomorphizer finds the real task.
#
# `base` is the source of the receiver, with the diagnostics count from
# before it was lowered. `x is empty` has none, as it has no dot.
task method_call(change self: Checker, value: mir.Expr, base: ast.Expr?, reported: int, name: text, args: list[ast.Arg], span: diag.Span) -> mir.Expr
    let ty = value.ty
    var found: Method? = none
    let in_trait = self.trait_task(ty, name)
    if in_trait >= 0
        found = Method(id: in_trait, known: [])
    else
        found = self.find_method(name, ty)
    if found is Method
        let id = found.id
        self.check_method_visible(id, span)
        if is_any(ty) and self.signatures[id].in_trait and self.changes(id)
            let poison = self.poison_args(args, span)
            return self.fail("E0307", "`{name}` has a `change` parameter, so an `any` cannot call it", span)
        if self.signatures[id].params[0].mode != "Change"
            let receiver = Receiver(value: value, known: found.known, base: none, place: none)
            return self.task_call(id, name, none, receiver, args, span)
        if base is none
            return self.fail("E0307", "`{name}` changes its receiver, so it needs a dot call", span)
        # It was read once to find its type, which reports the same errors.
        while self.diags.len() > reported
            self.diags.pop()
        let opened = self.frame.opened.len()
        let place = self.change_place(base, mir.ErrorTy)
        if place is none
            return self.poison_args(args, span)
        let local_ty = self.frame.locals[place.local]
        let changed = ex(mir.ChangeExpr(local: place.local), local_ty, base.span)
        let receiver = Receiver(value: changed, known: found.known, base: base, place: place)
        let result = self.task_call(id, name, none, receiver, args, span)
        while self.frame.opened.len() > opened
            self.frame.opened.pop()
        return result
    let field = self.task_field(ty, name)
    if field is FoundField
        let member = ex(mir.MemberExpr(inner: value, variant: 0, field: field.slot), field.ty, value.span)
        return self.call_value(member, args, value.span)
    let poison = self.poison_args(args, span)
    let free = self.task_named(name) >= 0
    var d = diag.new("E0303", "`{name}` does not work on `{ty.name()}`", span)
    if is_union(ty)
        d.notes.push(TEST_UNION)
    else if free
        d.notes.push("`{name}` has no `self`, so call it as `{name}(x)`")
    else if mir.is_param(ty)
        d.notes.push("a bound with this task lets a type parameter use it")
    let ignored = self.report(d)
    return poison

# A private task with `self` can only be called in its own module. It still
# counts for traits, so a type means one thing everywhere.
task check_method_visible(change self: Checker, id: int, span: diag.Span)
    let signature = self.signatures[id]
    let home = diag.file_index(self.files, signature.name.span.start)
    if not signature.in_trait and not signature.is_public and home != diag.file_index(self.files, span.start)
        let poison = self.note("E0333", "`{signature.name.text}` is private to its module", span, "mark it `public` in its module to use it here")

# A dot call: a built-in task on a built-in type, or else a method.
task dot_call(change self: Checker, value: mir.Expr, base: ast.Expr, reported: int, name: ast.Name, args: list[ast.Arg], span: diag.Span) -> mir.Expr
    let ty = value.ty
    if ty == mir.ErrorTy
        return self.poison_args(args, span)
    let text = name.text
    if not builtin_method(ty, text)
        return self.method_call(value, base, reported, text, args, span)
    if text == "pop"
        return self.fail("E0303", "`pop` changes its list, so it must be a whole statement, or all of the value of `let`, `var`, `return`, or an assignment to a name", span)
    if text == "receive"
        return self.fail("E0303", "`receive` waits for a value, so it must be a whole statement, or all of the value of `let`, `var`, `return`, or an assignment to a name", span)
    if has_text(changing_calls(), text) or has_text(thread_calls(), text)
        return self.fail("E0303", "`{text}` gives no value, so it must be a statement", span)
    if text == "get"
        return self.get(value, args, span)
    if text == "split"
        return self.text_split(value, args, span)
    if ty == mir.TextTy and has_text(["starts_with", "ends_with", "contains", "find"], text)
        return self.text_part(value, text, args, span)
    let op = wrapping_op(ty, text)
    if op is not empty
        let arg = only_arg(args)
        if arg is none
            return self.fail("E0307", "`{text}` takes 1 positional argument", span)
        let other = self.expected(arg, ty)
        self.expect_type(other, ty, "this argument")
        return ex(mir.WrappingExpr(op: op, left: value, right: other), ty, span)
    if args is not empty
        let poison = self.poison_args(args, span)
        return self.fail("E0307", "`{text}` takes no arguments", span)
    let converted = conversion(ty, text)
    if converted is mir.Ty
        return ex(mir.ConvertExpr(inner: value), converted, span)
    if text == "sqrt"
        return ex(mir.SqrtExpr(inner: value), ty, span)
    if ty == mir.TextTy
        if text == "len"
            return ex(mir.TextLenExpr(inner: value), mir.IntTy, span)
        if text == "bytes"
            return ex(mir.TextBytesExpr(inner: value), mir.ListTy(item: mir.ByteTy), span)
        if text == "upper" or text == "lower" or text == "trim"
            return ex(mir.ForeignExpr(symbol: "lucid_text_{text}", values: [value]), ty, span)
        if text == "to_int"
            return self.text_to_int(value, span)
    match ty
        SpawnedTy(item) ->
            if text == "wait"
                return self.first_item("lucid_wait", value, item, span)
        LockTy(item) ->
            if text == "read"
                return self.first_item("lucid_lock_read", value, item, span)
        _ -> skip()
    if text == "len"
        return ex(mir.LenExpr(inner: value), mir.IntTy, span)
    if text == "pointer"
        self.need_unsafe("`.pointer()`", span)
        var named = false
        match value.kind
            LocalExpr(_) ->
                named = true
            ViewExpr(inner) ->
                match inner.kind
                    LocalExpr(_) ->
                        named = true
                    _ ->
                        named = false
            _ ->
                named = false
        if not named
            # A temporary would be gone by the time the address is used.
            let poison = self.fail("E0331", "`.pointer()` needs a name", span)
        return ex(mir.ListPointerExpr(inner: value), mir.PointerTy, span)
    return self.is_empty(value, span)

# `spawn f(x)`: a task value with no parameters, which `lucid_spawn` runs on
# a new thread. The arguments run here, as its captures, and its code calls
# `f` with them. It gives a list that holds the result, so the runtime calls
# one shape of code, whatever the result type.
task spawn_call(change self: Checker, written: ast.Expr, span: diag.Span) -> mir.Expr
    let wrong = "`spawn` takes a call of a task, as in `spawn f(x)`"
    let is_call = match written.kind
        CallExpr(_, _) -> true
        _ -> false
    if not is_call
        let ignored = self.expected(written, none)
        return self.fail("E0341", wrong, span)
    let call = self.expected(written, none)
    if call.ty == mir.ErrorTy
        return poisoned(span)
    let returns = call.ty
    # A task's id and type arguments, or else a task value, first.
    var values: list[mir.Expr] = []
    var id = -1
    var types: list[mir.Ty] = []
    match call.kind
        CallExpr(found, found_types, args) ->
            for arg in args
                match arg.kind
                    ChangeExpr(_) -> return self.note("E0341", "a `change` argument cannot go to another thread", span, "pass the value, and give the new one back as the result")
                    _ ->
                        continue
            values = args
            id = found
            types = found_types
        CallValueExpr(callee, args) ->
            values = [callee]
            for arg in args
                values.push(arg)
        _ -> return self.fail("E0341", wrong, span)
    var captures: list[mir.Ty] = []
    var reads: list[mir.Expr] = []
    for index in 0..values.len()
        captures.push(values[index].ty)
        reads.push(ex(mir.CaptureExpr(at: index), values[index].ty, span))
    var kind = mir.NoneExpr
    if id >= 0
        kind = mir.CallExpr(id: id, args: types, values: reads)
    else
        kind = mir.CallValueExpr(callee: reads[0], values: reads[1..reads.len()])
    let inner_call = ex(kind, returns, span)
    let list = mir.ListTy(item: returns)
    let result = ex(mir.ListOfExpr(values: [inner_call]), list, span)
    let ty = mir.TaskTy(params: [], returns: list)
    let args = env_types(self.type_params)
    self.lifted.push(mir.Task(name: "", params: 1, type_params: args.len(), returns: list, locals: [ty], body: [mir.ReturnStmt(value: result)], span: span, captures: captures))
    let code = self.first_lifted + self.lifted.len() - 1
    var fields: list[mir.Slot] = []
    for index in 0..values.len()
        fields.push(mir.Slot(slot: index, value: values[index]))
    let closure = ex(mir.ClosureExpr(id: code, args: args, counted: 0, fields: fields), ty, span)
    let scope_ty = mir.SpawnedTy(item: mir.NoneTy)
    var scope = -1
    let open = self.frame.spawns
    if open is SpawnSite
        scope = open.local
    else
        scope = self.new_local(scope_ty, false)
        self.frame.spawns = SpawnSite(local: scope, span: span)
    let read = ex(mir.LocalExpr(local: scope), scope_ty, span)
    return ex(mir.ForeignExpr(symbol: "lucid_spawn", values: [read, closure]), mir.SpawnedTy(item: returns), span)

# Starts the hidden scope of a task that spawns. Its last count joins every
# thread it holds, which the exit block gives up when the task ends, so
# nothing outlives the task that ran it, by decision 171.
task open_spawns(change self: Checker, change body: list[mir.Stmt])
    let open = self.frame.spawns
    if open is SpawnSite
        self.frame.spawns = none
        let ty = self.frame.locals[open.local]
        let start = ex(mir.ForeignExpr(symbol: "lucid_spawn_scope", values: []), ty, open.span)
        body = prepend(mir.SetStmt(local: open.local, value: start), body)

# The one item of the list that the runtime task `symbol` gives for `value`:
# the result of a thread for `.wait()`, or a copy of what a lock holds for
# `.read()`.
task first_item(change self: Checker, symbol: text, value: mir.Expr, item: mir.Ty, span: diag.Span) -> mir.Expr
    let list = mir.ListTy(item: item)
    let results = self.checked(ex(mir.ForeignExpr(symbol: symbol, values: [value]), list, span))
    let first = ex(mir.IntExpr(value: 0), mir.IntTy, span)
    return ex(mir.ListGetExpr(value: results, at: first), item, span)

# Traps here if the runtime task for threads that just ran failed.
task failure_check(span: diag.Span) -> mir.Stmt
    let failed = ex(mir.ForeignExpr(symbol: "lucid_thread_failed", values: []), mir.BoolTy, span)
    let why = ex(mir.ForeignExpr(symbol: "lucid_thread_failure", values: []), mir.TextTy, span)
    return mir.IfStmt(branches: [mir.Branch(condition: failed, body: [mir.FailStmt(value: why, span: span)])], otherwise: [])

# `call`, a runtime task for threads, then `failure_check`.
task checked(change self: Checker, call: mir.Expr) -> mir.Expr
    let local = self.new_local(call.ty, false)
    let setup = [mir.SetStmt(local: local, value: call), failure_check(call.span)]
    return ex(mir.SeqExpr(setup: setup, inner: self.read(local, call.span)), call.ty, call.span)

# The one positional argument of a built-in call, or E0307.
task one_arg(change self: Checker, what: text, args: list[ast.Arg], span: diag.Span) -> ast.Expr?
    let found = only_arg(args)
    if found is ast.Expr
        return found
    let poison = self.poison_args(args, span)
    let reported = self.fail("E0307", "`{what}` takes one positional argument", span)
    return none

# A list of one item, which is how the runtime holds a value of any type in a
# channel or a lock.
task boxed_one(change self: Checker, value: mir.Expr, item: mir.Ty) -> mir.Expr
    let wide = self.widen(value, item)
    return ex(mir.ListOfExpr(values: [wide]), mir.ListTy(item: item), value.span)

# `channel[T](capacity)`, or `channel(capacity)` where the context gives the
# type.
task new_channel(change self: Checker, indices: list[ast.Expr]?, args: list[ast.Arg], want_in: mir.Ty?, span: diag.Span) -> mir.Expr
    let want = literal_want(want_in, "channel")
    var item: mir.Ty? = none
    if indices is list[ast.Expr]
        let types = self.explicit(indices, 1, "channel", span)
        if types is none
            return self.poison_args(args, span)
        item = types[0]
    else if want is mir.Ty
        match want
            ChannelTy(found) ->
                item = found
            ErrorTy -> return self.poison_args(args, span)
            _ ->
                item = none
    let capacity = self.one_arg("channel", args, span)
    if capacity is none
        return poisoned(span)
    let lowered = self.expected(capacity, mir.IntTy)
    self.expect_type(lowered, mir.IntTy, "the capacity of a channel")
    if item is none
        return self.note("E0324", "a channel needs the type of what it holds", span, "write it, as in `channel[int](16)`")
    return self.checked(ex(mir.ForeignExpr(symbol: "lucid_channel", values: [lowered]), mir.ChannelTy(item: item), span))

# `lock(value)`, which holds the type of `value`, or the one that the context
# gives.
task new_lock(change self: Checker, args: list[ast.Arg], want_in: mir.Ty?, span: diag.Span) -> mir.Expr
    let want = literal_want(want_in, "lock")
    var item: mir.Ty? = none
    if want is mir.Ty
        match want
            LockTy(found) ->
                item = found
            ErrorTy ->
                item = mir.ErrorTy
            _ ->
                item = none
    let value = self.one_arg("lock", args, span)
    if value is none
        return poisoned(span)
    let lowered = self.expected(value, item)
    let held = if item is mir.Ty then item else lowered.ty
    self.expect_type(lowered, held, "the value of a lock")
    if held == mir.ErrorTy
        return poisoned(span)
    let list = self.boxed_one(lowered, held)
    return ex(mir.ForeignExpr(symbol: "lucid_lock", values: [list]), mir.LockTy(item: held), span)

# `send`, `close`, `receive`, and `update`, as statements.
task thread_call(change self: Checker, base: ast.Expr, name: ast.Name, args: list[ast.Arg], span: diag.Span) -> mir.Stmt
    let handle = self.expr(base)
    match handle.ty
        ChannelTy(item) ->
            if name.text == "send"
                let value = self.one_arg("send", args, span)
                if value is none
                    return mir.ExprStmt(value: handle)
                let lowered = self.expected(value, item)
                self.expect_type(lowered, item, "this argument")
                let list = self.boxed_one(lowered, item)
                let send = mir.ExprStmt(value: ex(mir.ForeignExpr(symbol: "lucid_send", values: [handle, list]), mir.NoneTy, span))
                return mir.BlockStmt(body: [send, failure_check(span)])
            if name.text == "close"
                if args is not empty
                    let poison = self.poison_args(args, span)
                    let reported = self.fail("E0307", "`close` takes no arguments", span)
                let close = mir.ExprStmt(value: ex(mir.ForeignExpr(symbol: "lucid_close", values: [handle]), mir.NoneTy, span))
                return mir.BlockStmt(body: [close, failure_check(span)])
            let held = self.receive(handle, args, span)
            return self.with_held([held.stmt], held.result)
        LockTy(item) -> return self.update(handle, item, args, span)
        _ -> return mir.ExprStmt(value: handle)

# `channel.receive()`: the next value, or `none` once the channel is closed
# and empty. The runtime gives a list of one item, or an empty one.
task receive(change self: Checker, channel: mir.Expr, args: list[ast.Arg], span: diag.Span) -> Held
    var item = mir.ErrorTy
    match channel.ty
        ChannelTy(found) ->
            item = found
        _ ->
            let poison = self.fail("E0303", "`receive` does not work on `{channel.ty.name()}`", span)
            return Held(stmt: mir.BlockStmt(body: []), result: self.new_local(mir.ErrorTy, false))
    if args is not empty
        let poison = self.poison_args(args, span)
        let reported = self.fail("E0307", "`receive` takes no arguments", span)
    let ty = self.union([item, mir.NoneTy])
    let result = self.new_local(ty, false)
    let list = mir.ListTy(item: item)
    let got = self.new_local(list, false)
    let read = self.read(got, span)
    let len = ex(mir.LenExpr(inner: read), mir.IntTy, span)
    let nonempty = self.binary_values("Gt", len, ex(mir.IntExpr(value: 0), mir.IntTy, span), span)
    let value = ex(mir.ListGetExpr(value: read, at: ex(mir.IntExpr(value: 0), mir.IntTy, span)), item, span)
    let found = [mir.SetStmt(local: result, value: self.widen(value, ty))]
    let otherwise = [mir.SetStmt(local: result, value: self.widen(ex(mir.NoneExpr, mir.NoneTy, span), ty))]
    let received = ex(mir.ForeignExpr(symbol: "lucid_receive", values: [channel]), list, span)
    let stmts = [mir.SetStmt(local: got, value: received), failure_check(span), mir.IfStmt(branches: [mir.Branch(condition: nonempty, body: found)], otherwise: otherwise), mir.ClearStmt(local: got)]
    return Held(stmt: mir.BlockStmt(body: stmts), result: result)

# `lock.update(f)`: takes the value out of the lock, so that it has one
# count, passes it to `f`, which owns it by decision 183, and keeps what `f`
# gives. So a write in `f` is in place, as decision 173 needs. The lock and
# `f` run first, in the order on the page.
task update(change self: Checker, lock: mir.Expr, item: mir.Ty, args: list[ast.Arg], span: diag.Span) -> mir.Stmt
    let written = self.one_arg("update", args, span)
    if written is none
        return mir.ExprStmt(value: lock)
    let task_ty = mir.TaskTy(params: [item], returns: item)
    let f = self.expected(written, task_ty)
    self.expect_type(f, task_ty, "this argument")
    let list = mir.ListTy(item: item)
    let held = self.new_local(lock.ty, false)
    let f_local = self.new_local(task_ty, false)
    let value = self.new_local(item, false)
    let fresh = self.new_local(item, false)
    let taken = self.new_local(list, false)
    let held_read = ex(mir.LocalExpr(local: held), lock.ty, span)
    let taking = ex(mir.ForeignExpr(symbol: "lucid_lock_take", values: [held_read]), list, span)
    let first = ex(mir.IntExpr(value: 0), mir.IntTy, span)
    let get = ex(mir.ListGetExpr(value: ex(mir.LocalExpr(local: taken), list, span), at: first), item, span)
    let call = ex(mir.CallValueExpr(callee: ex(mir.LocalExpr(local: f_local), task_ty, span), values: [ex(mir.LocalExpr(local: value), item, span)]), item, span)
    let kept = self.boxed_one(ex(mir.LocalExpr(local: fresh), item, span), item)
    let put = ex(mir.ForeignExpr(symbol: "lucid_lock_put", values: [held_read, kept]), mir.NoneTy, span)
    return mir.BlockStmt(body: [mir.SetStmt(local: held, value: lock), mir.SetStmt(local: f_local, value: f), mir.SetStmt(local: taken, value: taking), failure_check(span), mir.SetStmt(local: value, value: get), mir.ClearStmt(local: taken), mir.SetStmt(local: fresh, value: call), mir.ExprStmt(value: put), mir.ClearStmt(local: value), mir.ClearStmt(local: fresh), mir.ClearStmt(local: f_local), mir.ClearStmt(local: held)])

# Lowers arguments of a call that already failed, to report their errors.
task poison_args(change self: Checker, args: list[ast.Arg], span: diag.Span) -> mir.Expr
    for arg in args
        let ignored = self.expected(arg.value, mir.ErrorTy)
    return poisoned(span)

# END OF PORTED CODE
