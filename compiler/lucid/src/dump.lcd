# `LUCID_DUMP`: each stage as text that both compilers write, by decision
# 215. Ports dump.rs. See "Dumps" in docs/compiler.md for the form.

use ./ast
use ./diag
use ./lexer
use ./manifest
use ./mir
use ./resolve

# One node per line, indented two spaces per level. A line holds a name and
# atoms, and the node's children follow it, one level deeper.
type Out
    lines: list[text]
    # The indentation of each depth so far.
    indents: list[text]
    depth: int

task new_out() -> Out
    return Out(lines: [], indents: [""], depth: 0)

task line(change self: Out, head: text)
    while self.indents.len() <= self.depth
        self.indents.push("{self.indents[self.indents.len() - 1]}  ")
    self.lines.push("{self.indents[self.depth]}{head}")

task atom(change self: Out, atom: text)
    let last = self.lines.len() - 1
    let before = self.lines[last]
    self.lines[last] = "{before} {atom}"

task count(change self: Out, n: int)
    self.atom("{n}")

task flag(change self: Out, value: bool)
    self.atom("{value}")

task text(change self: Out, value: text)
    self.atom(quote(value))

task span(change self: Out, span: diag.Span)
    self.atom("{span.start} {span.end}")

task name(change self: Out, name: ast.Name)
    self.text(name.text)
    self.span(name.span)

# A child line `-` for a missing child.
task absent(change self: Out)
    self.line("-")

# The lines, each but the last ended by a line break, which `print` adds.
task finish(self: Out) -> text
    var all = ""
    for i in 0..self.lines.len()
        let line = self.lines[i]
        all = if i == 0 then line else "{all}\n{line}"
    return all

## A text in double quotes. Only `\`, `"`, and control characters are
## escaped, so both compilers agree on every byte.
public task quote(value: text) -> text
    if not diag.needs_escape(value, true)
        return "\"{value}\""
    var out = "\""
    for c in value
        if c == "\\"
            out = "{out}\\\\"
        else if c == "\""
            out = "{out}\\\""
        else if c == "\n"
            out = "{out}\\n"
        else if c == "\r"
            out = "{out}\\r"
        else if c == "\t"
            out = "{out}\\t"
        else if c < " " or c.bytes()[0].to_int() == 127
            out = "{out}\\u{{{diag.hex(c.bytes()[0].to_int())}}}"
        else
            out = "{out}{c}"
    return "{out}\""

public task tokens(tokens: list[lexer.Token]) -> text
    var out = new_out()
    for t in tokens
        token(change out, t)
    return out.finish()

task token(change out: Out, item: lexer.Token)
    let kind = item.kind
    out.line(kind.tag())
    out.span(item.span)
    match kind
        NameToken(name) -> out.text(name)
        IntToken(digits) -> out.text(digits)
        FloatToken(digits) -> out.text(digits)
        SymToken(sym) -> out.text(sym)
        TextToken(parts) ->
            out.count(parts.len())
            out.depth += 1
            for part in parts
                match part
                    LiteralPart(value) ->
                        out.line("Literal")
                        out.text(value)
                    ExprPart(tokens) ->
                        out.line("Expr")
                        out.count(tokens.len())
                        out.depth += 1
                        for t in tokens
                            token(change out, t)
                        out.depth -= 1
            out.depth -= 1
        _ ->
            return

## What the resolver gives: the files read, what it records about them, and
## the joined tree, if loading got that far. Printed even with errors.
public task resolved(found: resolve.Resolved) -> text
    var out = new_out()
    let source = found.source
    out.line("Source")
    out.count(source.files.len())
    let grants = found.grants
    if grants is none
        out.atom("-")
    else
        out.count(grants.len())
        for grant in grants
            match grant
                All -> out.atom("all")
                Listed(items) ->
                    out.atom("list")
                    out.count(items.len())
                    for item in items
                        out.text(item)
    out.depth += 1
    for file in source.files
        out.line("File")
        out.text(file.path)
        out.count(file.start)
    for item in found.no_unsafe
        out.line("NoUnsafe")
        out.count(item.start)
        out.text(item.manifest)
    for item in found.packages
        out.line("Package")
        out.count(item.start)
        out.count(item.package)
    let web = found.web_only
    if web is none
        out.absent()
    else
        out.line("WebOnly")
        out.span(web)
    let host = found.host_only
    if host is none
        out.absent()
    else
        out.line("HostOnly")
        out.span(host.span)
        out.text(host.module)
    out.depth -= 1
    let file = found.file
    if file is none
        out.absent()
    else
        out.line("File")
        out.count(file.stmts.len())
        out.depth += 1
        stmts(change out, file.stmts)
        out.depth -= 1
    return out.finish()

public task tree(file: ast.File) -> text
    var out = new_out()
    out.line("File")
    out.count(file.stmts.len())
    out.depth += 1
    stmts(change out, file.stmts)
    out.depth -= 1
    return out.finish()

task stmts(change out: Out, stmts: list[ast.Stmt])
    for s in stmts
        stmt(change out, s)

# The length of a list of statements, or `-` when it is absent.
task maybe_count(change out: Out, body: list[ast.Stmt]?)
    if body is none
        out.atom("-")
    else
        out.count(body.len())

task stmt(change out: Out, item: ast.Stmt)
    let span = item.span
    match item.kind
        UseStmt(relative, path, alias) ->
            leaf(change out, "Use", span)
            out.flag(relative)
            out.count(path.len())
            for name in path
                out.name(name)
            if alias is none
                out.atom("-")
            else
                out.name(alias)
        TestStmt(name, body) ->
            leaf(change out, "Test", span)
            out.count(body.len())
            out.depth += 1
            expr(change out, name)
            stmts(change out, body)
            out.depth -= 1
        TaskStmt(def) ->
            leaf(change out, "Task", span)
            out.flag(def.is_public)
            let body = def.body
            maybe_count(change out, body)
            out.depth += 1
            sig(change out, def.sig)
            if body is not none
                stmts(change out, body)
            out.depth -= 1
        TypeStmt(def) ->
            leaf(change out, "Type", span)
            out.flag(def.is_public)
            out.name(def.name)
            out.count(def.type_params.len())
            out.depth += 1
            for p in def.type_params
                type_param(change out, p)
            type_body(change out, def.body)
            out.depth -= 1
        ChoiceStmt(def) ->
            leaf(change out, "Choice", span)
            out.flag(def.is_public)
            out.name(def.name)
            out.count(def.type_params.len())
            out.count(def.variants.len())
            out.depth += 1
            for p in def.type_params
                type_param(change out, p)
            for variant in def.variants
                out.line("Variant")
                out.name(variant.name)
                out.count(variant.params.len())
                out.depth += 1
                for p in variant.params
                    param(change out, p)
                out.depth -= 1
            out.depth -= 1
        TraitStmt(def) ->
            leaf(change out, "Trait", span)
            out.flag(def.is_public)
            out.name(def.name)
            out.count(def.type_params.len())
            out.count(def.tasks.len())
            out.depth += 1
            for p in def.type_params
                type_param(change out, p)
            for task_sig in def.tasks
                sig(change out, task_sig)
            out.depth -= 1
        LetStmt(mutable, name, ty, value) ->
            leaf(change out, "Let", span)
            out.flag(mutable)
            out.name(name)
            out.depth += 1
            maybe_ty(change out, ty)
            expr(change out, value)
            out.depth -= 1
        IfStmt(branches, otherwise) ->
            leaf(change out, "If", span)
            out.count(branches.len())
            maybe_count(change out, otherwise)
            out.depth += 1
            for branch in branches
                out.line("Branch")
                out.count(branch.body.len())
                out.depth += 1
                expr(change out, branch.condition)
                stmts(change out, branch.body)
                out.depth -= 1
            if otherwise is not none
                stmts(change out, otherwise)
            out.depth -= 1
        WhileStmt(condition, body) ->
            leaf(change out, "While", span)
            out.count(body.len())
            out.depth += 1
            expr(change out, condition)
            stmts(change out, body)
            out.depth -= 1
        ForStmt(changes, name, iterable, body) ->
            leaf(change out, "For", span)
            out.flag(changes)
            out.name(name)
            out.count(body.len())
            out.depth += 1
            expr(change out, iterable)
            stmts(change out, body)
            out.depth -= 1
        ReturnStmt(value) ->
            leaf(change out, "Return", span)
            out.depth += 1
            maybe_expr(change out, value)
            out.depth -= 1
        PrintStmt(value) -> one_expr(change out, "Print", span, value)
        ExpectStmt(value) -> one_expr(change out, "Expect", span, value)
        ExprStmt(value) -> one_expr(change out, "Expr", span, value)
        UnsafeStmt(body) ->
            leaf(change out, "Unsafe", span)
            out.count(body.len())
            out.depth += 1
            stmts(change out, body)
            out.depth -= 1
        BreakStmt -> leaf(change out, "Break", span)
        ContinueStmt -> leaf(change out, "Continue", span)
        PlaceholderStmt -> leaf(change out, "Placeholder", span)
        AssignStmt(target, op, value) ->
            leaf(change out, "Assign", span)
            out.atom(op)
            out.depth += 1
            expr(change out, target)
            expr(change out, value)
            out.depth -= 1

task type_body(change out: Out, body: ast.TypeBody)
    match body
        AliasBody(ty) ->
            out.line("Alias")
            out.depth += 1
            ty_node(change out, ty)
            out.depth -= 1
        FieldsBody(fields) ->
            out.line("Fields")
            out.count(fields.len())
            out.depth += 1
            for field in fields
                out.line("Field")
                out.name(field.name)
                out.depth += 1
                ty_node(change out, field.ty)
                maybe_expr(change out, field.default)
                out.depth -= 1
            out.depth -= 1

task leaf(change out: Out, head: text, span: diag.Span)
    out.line(head)
    out.span(span)

task one_expr(change out: Out, head: text, span: diag.Span, value: ast.Expr)
    leaf(change out, head, span)
    out.depth += 1
    expr(change out, value)
    out.depth -= 1

task sig(change out: Out, sig: ast.TaskSig)
    out.line("Sig")
    out.name(sig.name)
    out.count(sig.type_params.len())
    out.count(sig.params.len())
    out.depth += 1
    for p in sig.type_params
        type_param(change out, p)
    for p in sig.params
        param(change out, p)
    maybe_ty(change out, sig.returns)
    out.depth -= 1

task type_param(change out: Out, item: ast.TypeParam)
    out.line("TypeParam")
    out.name(item.name)
    out.count(item.bounds.len())
    out.depth += 1
    for ty in item.bounds
        ty_node(change out, ty)
    out.depth -= 1

task param(change out: Out, item: ast.Param)
    out.line("Param")
    out.atom(item.mode)
    out.name(item.name)
    out.depth += 1
    maybe_ty(change out, item.ty)
    maybe_expr(change out, item.default)
    out.depth -= 1

task maybe_ty(change out: Out, ty: ast.Type?)
    if ty is none
        out.absent()
    else
        ty_node(change out, ty)

task ty_node(change out: Out, ty: ast.Type)
    let span = ty.span
    match ty.kind
        NamedType(path, args) ->
            leaf(change out, "Named", span)
            out.count(path.len())
            for name in path
                out.name(name)
            out.count(args.len())
            out.depth += 1
            for arg in args
                ty_node(change out, arg)
            out.depth -= 1
        NoneType -> leaf(change out, "None", span)
        TaskType(params, returns) ->
            leaf(change out, "Task", span)
            out.count(params.len())
            out.depth += 1
            for p in params
                ty_node(change out, p)
            maybe_ty(change out, returns)
            out.depth -= 1
        UnionType(members) ->
            leaf(change out, "Union", span)
            out.count(members.len())
            out.depth += 1
            for member in members
                ty_node(change out, member)
            out.depth -= 1
        OptionalType(inner) -> wrapped(change out, "Optional", span, inner)
        SharedType(inner) -> wrapped(change out, "Shared", span, inner)
        WeakType(inner) -> wrapped(change out, "Weak", span, inner)
        AnyType(inner) -> wrapped(change out, "Any", span, inner)

task wrapped(change out: Out, head: text, span: diag.Span, inner: ast.Type)
    leaf(change out, head, span)
    out.depth += 1
    ty_node(change out, inner)
    out.depth -= 1

task maybe_expr(change out: Out, value: ast.Expr?)
    if value is none
        out.absent()
    else
        expr(change out, value)

task is_kind(target: ast.IsTarget) -> text
    return match target
        IsNone -> "None"
        IsEmpty -> "Empty"
        IsType(_) -> "Type"

task is_target(change out: Out, target: ast.IsTarget)
    match target
        IsType(ty) -> ty_node(change out, ty)
        _ -> return

task expr(change out: Out, value: ast.Expr)
    let span = value.span
    match value.kind
        NameExpr(name) ->
            leaf(change out, "Name", span)
            out.text(name)
        SelfExpr -> leaf(change out, "SelfValue", span)
        NoneExpr -> leaf(change out, "None", span)
        BoolExpr(flag) ->
            leaf(change out, "Bool", span)
            out.flag(flag)
        IntExpr(digits) ->
            leaf(change out, "Int", span)
            out.text(digits)
        FloatExpr(digits) ->
            leaf(change out, "Float", span)
            out.text(digits)
        TextExpr(parts) ->
            leaf(change out, "Text", span)
            out.count(parts.len())
            out.depth += 1
            for part in parts
                match part
                    LiteralText(literal) ->
                        out.line("Literal")
                        out.text(literal)
                    ExprText(inner) -> expr(change out, inner)
            out.depth -= 1
        ListExpr(items) ->
            leaf(change out, "List", span)
            out.count(items.len())
            out.depth += 1
            for item in items
                expr(change out, item)
            out.depth -= 1
        MapExpr(entries) ->
            leaf(change out, "Map", span)
            out.count(entries.len())
            out.depth += 1
            for entry in entries
                out.line("Entry")
                out.depth += 1
                expr(change out, entry.key)
                expr(change out, entry.value)
                out.depth -= 1
            out.depth -= 1
        UnaryExpr(op, inner) ->
            leaf(change out, "Unary", span)
            out.atom(op)
            out.depth += 1
            expr(change out, inner)
            out.depth -= 1
        BinaryExpr(op, left, right) ->
            leaf(change out, "Binary", span)
            out.atom(op)
            out.depth += 1
            expr(change out, left)
            expr(change out, right)
            out.depth -= 1
        IsExpr(inner, negated, target) ->
            leaf(change out, "Is", span)
            out.flag(negated)
            out.atom(is_kind(target))
            out.depth += 1
            expr(change out, inner)
            is_target(change out, target)
            out.depth -= 1
        IfExpr(condition, yes, otherwise) ->
            leaf(change out, "If", span)
            out.depth += 1
            expr(change out, condition)
            expr(change out, yes)
            expr(change out, otherwise)
            out.depth -= 1
        LambdaExpr(params, body) ->
            leaf(change out, "Lambda", span)
            out.count(params.len())
            for name in params
                out.name(name)
            out.depth += 1
            expr(change out, body)
            out.depth -= 1
        CallExpr(callee, args) ->
            leaf(change out, "Call", span)
            out.count(args.len())
            out.depth += 1
            expr(change out, callee)
            for arg in args
                call_arg(change out, arg)
            out.depth -= 1
        IndexExpr(base, indices) ->
            leaf(change out, "Index", span)
            out.count(indices.len())
            out.depth += 1
            expr(change out, base)
            for index in indices
                expr(change out, index)
            out.depth -= 1
        FieldExpr(base, name) ->
            leaf(change out, "Field", span)
            out.name(name)
            out.depth += 1
            expr(change out, base)
            out.depth -= 1
        OptionalExpr(inner) ->
            leaf(change out, "Optional", span)
            out.depth += 1
            expr(change out, inner)
            out.depth -= 1
        TypeExpr(ty) ->
            leaf(change out, "Type", span)
            out.depth += 1
            ty_node(change out, ty)
            out.depth -= 1
        MatchExpr(subject, arms) ->
            leaf(change out, "Match", span)
            out.count(arms.len())
            out.depth += 1
            expr(change out, subject)
            for a in arms
                arm(change out, a)
            out.depth -= 1

task call_arg(change out: Out, arg: ast.Arg)
    out.line("Arg")
    let name = arg.name
    if name is none
        out.atom("-")
    else
        out.name(name)
    out.flag(arg.changes)
    out.depth += 1
    expr(change out, arg.value)
    out.depth -= 1

task arm(change out: Out, item: ast.Arm)
    out.line("Arm")
    match item.body
        ArmExpr(_) -> out.atom("Expr")
        ArmStmt(_) -> out.atom("Stmt")
        ArmBlock(body) ->
            out.atom("Block")
            out.count(body.len())
    out.depth += 1
    pattern(change out, item.pattern)
    match item.body
        ArmExpr(value) -> expr(change out, value)
        ArmStmt(body) -> stmt(change out, body)
        ArmBlock(body) -> stmts(change out, body)
    out.depth -= 1

task pattern(change out: Out, item: ast.Pattern)
    let span = item.span
    match item.kind
        WildcardPattern -> leaf(change out, "Wildcard", span)
        NonePattern -> leaf(change out, "None", span)
        LiteralPattern(value) ->
            leaf(change out, "Literal", span)
            out.depth += 1
            expr(change out, value)
            out.depth -= 1
        NamePattern(name) ->
            leaf(change out, "Name", span)
            out.name(name)
        VariantPattern(name, bindings) ->
            leaf(change out, "Variant", span)
            out.name(name)
            out.count(bindings.len())
            for binding in bindings
                out.name(binding)
        TypedPattern(name, ty) ->
            leaf(change out, "Typed", span)
            out.name(name)
            out.depth += 1
            ty_node(change out, ty)
            out.depth -= 1

# A type as atoms in prefix form.
task ty(change self: Out, ty: mir.Ty)
    match ty
        ListTy(item) ->
            self.atom("list")
            self.ty(item)
        MapTy(key, value) ->
            self.atom("map")
            self.ty(key)
            self.ty(value)
        SetTy(item) ->
            self.atom("set")
            self.ty(item)
        SpawnedTy(item) ->
            self.atom("spawned")
            self.ty(item)
        ChannelTy(item) ->
            self.atom("channel")
            self.ty(item)
        LockTy(item) ->
            self.atom("lock")
            self.ty(item)
        DataTy(name, id, args) ->
            self.atom("data")
            self.text(name)
            self.count(id)
            self.tys(args)
        UnionTy(members) ->
            self.atom("union")
            self.tys(members)
        AnyTy(name) ->
            self.atom("any")
            self.text(name)
        TaskTy(params, returns) ->
            self.atom("task")
            self.tys(params)
            self.ty(returns)
        ParamTy(name, at) ->
            self.atom("param")
            self.text(name)
            # The open parameter, which Rust numbers `usize::MAX`.
            self.atom(if at < 0 then "18446744073709551615" else "{at}")
        ErrorTy -> self.atom("error")
        PointerTy -> self.atom("pointer")
        _ -> self.atom(ty.name())

task tys(change self: Out, tys: list[mir.Ty])
    self.count(tys.len())
    for item in tys
        self.ty(item)

task ints(change self: Out, values: list[int])
    self.count(values.len())
    for value in values
        self.count(value)

## The program that the checker gives, or the monomorphizer.
public task program(p: mir.Program) -> text
    var out = new_out()
    out.line("Program")
    out.count(p.datas.len())
    out.count(p.tasks.len())
    out.count(p.tests.len())
    out.tys(p.types.ids)
    out.depth += 1
    for shape in p.datas
        out.line("Shape")
        out.flag(shape.is_choice)
        out.count(shape.variants.len())
        out.depth += 1
        for variant in shape.variants
            out.line("Variant")
            out.text(variant.name)
            out.count(variant.fields.len())
            for field in variant.fields
                out.text(field.name)
                out.ty(field.ty)
            out.depth += 1
            for default in variant.defaults
                out.maybe_value(default)
            out.depth -= 1
        out.depth -= 1
    for t in p.tasks
        out.mir_task(t)
    out.mir_task(p.main)
    for case in p.tests
        out.line("Test")
        out.text(case.name)
        out.count(case.id)
        out.span(case.span)
    out.depth -= 1
    return out.finish()

task mir_task(change self: Out, t: mir.Task)
    self.line("Task")
    self.text(t.name)
    self.span(t.span)
    self.count(t.params)
    self.count(t.type_params)
    self.ty(t.returns)
    self.tys(t.locals)
    self.tys(t.captures)
    self.ints(t.changes)
    self.ints(t.takes)
    self.ints(t.borrowed)
    self.count(t.body.len())
    self.mir_body(t.body)

# Statements one level deeper.
task mir_body(change self: Out, body: list[mir.Stmt])
    self.depth += 1
    for item in body
        self.mir_stmt(item)
    self.depth -= 1

# A value one level deeper.
task nested(change self: Out, value: mir.Expr)
    self.depth += 1
    self.value_node(value)
    self.depth -= 1

task mir_stmt(change self: Out, item: mir.Stmt)
    match item
        SetStmt(local, value) ->
            self.line("Set")
            self.count(local)
            self.nested(value)
        BindStmt(local, value) ->
            self.line("Bind")
            self.count(local)
            self.nested(value)
        UpdateStmt(local, op, args, span) ->
            self.line("Update")
            self.count(local)
            self.atom(op)
            self.span(span)
            self.count(args.len())
            self.values(args)
        ClearStmt(local) ->
            self.line("Clear")
            self.count(local)
        BlockStmt(body) ->
            self.line("Block")
            self.count(body.len())
            self.mir_body(body)
        IfStmt(branches, otherwise) ->
            self.line("If")
            self.count(branches.len())
            self.count(otherwise.len())
            self.depth += 1
            for branch in branches
                self.line("Branch")
                self.count(branch.body.len())
                self.depth += 1
                self.value_node(branch.condition)
                for s in branch.body
                    self.mir_stmt(s)
                self.depth -= 1
            for s in otherwise
                self.mir_stmt(s)
            self.depth -= 1
        WhileStmt(condition, body) ->
            self.line("While")
            self.count(body.len())
            self.depth += 1
            self.value_node(condition)
            for s in body
                self.mir_stmt(s)
            self.depth -= 1
        ForStmt(local, start, end, inclusive, body) ->
            self.line("For")
            self.count(local)
            self.flag(inclusive)
            self.count(body.len())
            self.depth += 1
            self.value_node(start)
            self.value_node(end)
            for s in body
                self.mir_stmt(s)
            self.depth -= 1
        ReturnStmt(value) ->
            self.line("Return")
            self.nested(value)
        ExitStmt(value) ->
            self.line("Exit")
            self.nested(value)
        PrintStmt(value) ->
            self.line("Print")
            self.nested(value)
        ExprStmt(value) ->
            self.line("Expr")
            self.nested(value)
        FailStmt(value, span) ->
            self.line("Fail")
            self.span(span)
            self.nested(value)
        BreakStmt -> self.line("Break")
        ContinueStmt -> self.line("Continue")
        UnreachableStmt -> self.line("Unreachable")
        PrintTextStmt(value) ->
            self.line("PrintText")
            self.text(value)
        PlaceholderStmt(span) ->
            self.line("Placeholder")
            self.span(span)
        TrapStmt(message, span) ->
            self.line("Trap")
            self.text(message)
            self.span(span)

task maybe_value(change self: Out, value: mir.Expr?)
    match value
        found: mir.Expr -> self.value_node(found)
        none -> self.absent()

task key_tasks(change self: Out, keys: mir.KeyTasks?)
    match keys
        found: mir.KeyTasks ->
            self.count(found.hash)
            self.count(found.equal)
        none -> self.atom("-")

task slots(change self: Out, fields: list[mir.Slot])
    self.depth += 1
    for field in fields
        self.line("Slot")
        self.count(field.slot)
        self.nested(field.value)
    self.depth -= 1

task head(change self: Out, name: text, value: mir.Expr)
    self.line(name)
    self.ty(value.ty)
    self.span(value.span)

task values(change self: Out, values: list[mir.Expr])
    self.depth += 1
    for value in values
        self.value_node(value)
    self.depth -= 1

task one(change self: Out, name: text, value: mir.Expr, a: mir.Expr)
    self.head(name, value)
    self.nested(a)

task two(change self: Out, name: text, value: mir.Expr, a: mir.Expr, b: mir.Expr)
    self.head(name, value)
    self.values([a, b])

task three(change self: Out, name: text, value: mir.Expr, a: mir.Expr, b: mir.Expr, c: mir.Expr)
    self.head(name, value)
    self.values([a, b, c])

task value_node(change self: Out, v: mir.Expr)
    match v.kind
        IntExpr(n) ->
            self.head("Int", v)
            self.count(n)
        FloatExpr(x) ->
            self.head("Float", v)
            self.atom("{x}")
        BoolExpr(b) ->
            self.head("Bool", v)
            self.flag(b)
        NoneExpr -> self.head("None", v)
        LocalExpr(local) ->
            self.head("Local", v)
            self.count(local)
        ChangeExpr(local) ->
            self.head("Change", v)
            self.count(local)
        CaptureExpr(at) ->
            self.head("Capture", v)
            self.count(at)
        MoveExpr(local) ->
            self.head("Move", v)
            self.count(local)
        TextExpr(value) ->
            self.head("Text", v)
            self.text(value)
        CallExpr(id, args, values) ->
            self.head("Call", v)
            self.count(id)
            self.tys(args)
            self.count(values.len())
            self.values(values)
        CallValueExpr(callee, values) ->
            self.head("CallValue", v)
            self.count(values.len())
            self.depth += 1
            self.value_node(callee)
            for value in values
                self.value_node(value)
            self.depth -= 1
        ClosureExpr(id, args, counted, fields) ->
            self.head("Closure", v)
            self.count(id)
            self.tys(args)
            self.count(counted)
            self.count(fields.len())
            self.slots(fields)
        NewExpr(tag, counted, fields) ->
            self.head("New", v)
            self.count(tag)
            self.count(counted)
            self.count(fields.len())
            self.slots(fields)
        JoinExpr(values) ->
            self.head("Join", v)
            self.count(values.len())
            self.values(values)
        ListOfExpr(values) ->
            self.head("ListOf", v)
            self.count(values.len())
            self.values(values)
        ForeignExpr(symbol, values) ->
            self.head("Foreign", v)
            self.text(symbol)
            self.count(values.len())
            self.values(values)
        MethodExpr(name, values) ->
            self.head("Method", v)
            self.text(name)
            self.count(values.len())
            self.values(values)
        MapOfExpr(entries, keys) ->
            self.head("MapOf", v)
            self.count(entries.len())
            self.key_tasks(keys)
            self.depth += 1
            for entry in entries
                self.line("Entry")
                self.values([entry.key, entry.value])
            self.depth -= 1
        SetOfExpr(inner, keys) ->
            self.head("SetOf", v)
            self.key_tasks(keys)
            self.nested(inner)
        FieldExpr(inner, slot) ->
            self.head("Field", v)
            self.count(slot)
            self.nested(inner)
        TagInExpr(inner, tags) ->
            self.head("TagIn", v)
            self.ints(tags)
            self.nested(inner)
        MemberExpr(inner, variant, field) ->
            self.head("Member", v)
            self.count(variant)
            self.count(field)
            self.nested(inner)
        HoldsExpr(inner, tys) ->
            self.head("Holds", v)
            self.tys(tys)
            self.nested(inner)
        TempExpr(local, inner) ->
            self.head("Temp", v)
            self.count(local)
            self.nested(inner)
        BinaryExpr(op, left, right) ->
            self.head("Binary", v)
            self.atom(op)
            self.values([left, right])
        WrappingExpr(op, left, right) ->
            self.head("Wrapping", v)
            self.atom(op)
            self.values([left, right])
        HashExpr(op, left, right) ->
            self.head("Hash", v)
            self.atom(op)
            self.values([left, right])
        SeqExpr(setup, inner) ->
            self.head("Seq", v)
            self.count(setup.len())
            self.depth += 1
            for s in setup
                self.mir_stmt(s)
            self.value_node(inner)
            self.depth -= 1
        NegExpr(a) -> self.one("Neg", v, a)
        SqrtExpr(a) -> self.one("Sqrt", v, a)
        NotExpr(a) -> self.one("Not", v, a)
        ConvertExpr(a) -> self.one("Convert", v, a)
        ToTextExpr(a) -> self.one("ToText", v, a)
        TextQuoteExpr(a) -> self.one("TextQuote", v, a)
        TextLenExpr(a) -> self.one("TextLen", v, a)
        ListPointerExpr(a) -> self.one("ListPointer", v, a)
        TextIsEmptyExpr(a) -> self.one("TextIsEmpty", v, a)
        TextByteLenExpr(a) -> self.one("TextByteLen", v, a)
        TextBytesExpr(a) -> self.one("TextBytes", v, a)
        LenExpr(a) -> self.one("Len", v, a)
        TagExpr(a) -> self.one("Tag", v, a)
        WrapExpr(a) -> self.one("Wrap", v, a)
        ViewExpr(a) -> self.one("View", v, a)
        RetainExpr(a) -> self.one("Retain", v, a)
        TextCharAtExpr(a, b) -> self.two("TextCharAt", v, a, b)
        ListGetExpr(a, b) -> self.two("ListGet", v, a, b)
        ListHasExpr(a, b) -> self.two("ListHas", v, a, b)
        MapGetExpr(a, b) -> self.two("MapGet", v, a, b)
        MapHasExpr(a, b) -> self.two("MapHas", v, a, b)
        MapNextExpr(a, b) -> self.two("MapNext", v, a, b)
        MapKeyExpr(a, b) -> self.two("MapKey", v, a, b)
        MapValueExpr(a, b) -> self.two("MapValue", v, a, b)
        MapFindExpr(a, b) -> self.two("MapFind", v, a, b)
        IfExpr(a, b, c) -> self.three("If", v, a, b, c)
        TextSliceExpr(a, b, c) -> self.three("TextSlice", v, a, b, c)
        ListSliceExpr(a, b, c) -> self.three("ListSlice", v, a, b, c)
