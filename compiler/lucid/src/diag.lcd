# Diagnostics, in the shape defined in docs/agents.md. Ports diag.rs.

## Byte range in the source. `end` is exclusive.
public type Span
    start: int
    end: int

## Edits to make together: each replaces a span with text.
public type Fix
    description: text
    edits: list[Edit]

public type Edit
    span: Span
    text: text

public type Diagnostic
    code: text
    message: text
    span: Span
    notes: list[text] = []
    # Changes that remove the error with near certainty.
    fixes: list[Fix] = []

public task span(start: int, end: int) -> Span
    return Span(start: start, end: end)

public task new(code: text, message: text, span: Span) -> Diagnostic
    return Diagnostic(code: code, message: message, span: span)

## Adds a fix of one edit.
public task fix(change self: Diagnostic, description: text, span: Span, text: text)
    self.fixes.push(Fix(description: description, edits: [Edit(span: span, text: text)]))

## The same diagnostic, fixes too, in a file that starts at `base`.
public task shifted(self: Diagnostic, base: int) -> Diagnostic
    var out = self
    out.span = span(self.span.start + base, self.span.end + base)
    for change fix in out.fixes
        for change edit in fix.edits
            edit.span = span(edit.span.start + base, edit.span.end + base)
    return out

## One file in a `Source`.
public type SourceFile
    path: text
    start: int

## Every file of a program, end to end, so that a span alone gives its file.
public type Source
    bytes: list[byte]
    files: list[SourceFile]

## A source of one file.
public task one(path: text, bytes: list[byte]) -> Source
    var source = Source(bytes: [], files: [])
    let start = source.add_file(path, bytes)
    return source

## Adds a file, and returns where it starts. A line break follows it, so the
## next file starts on a line of its own, and the offset of this file's end
## still falls in this file.
public task add_file(change self: Source, path: text, bytes: list[byte]) -> int
    let start = self.bytes.len()
    self.files.push(SourceFile(path: path, start: start))
    for b in bytes
        self.bytes.push(b)
    self.bytes.push(10)
    return start

## The position in `files` of the file that holds a byte offset.
public task file_index(files: list[SourceFile], offset: int) -> int
    var low = 0
    var high = files.len()
    while low < high
        let middle = (low + high) // 2
        if files[middle].start <= offset
            low = middle + 1
        else
            high = middle
    return if low > 0 then low - 1 else 0

## Maps byte offsets to 1-based lines and columns. Columns count characters.
public type Lines
    source: Source
    starts: list[int]

public task lines(source: Source) -> Lines
    var starts = [0]
    let bytes = source.bytes
    for i in 0..bytes.len()
        if bytes[i].to_int() == 10
            starts.push(i + 1)
    return Lines(source: source, starts: starts)

## The file, line, and column of a byte offset.
public type Place
    file: text
    line: int
    column: int

# The number of line starts before `offset`, or at it with `at`.
task starts_before(starts: list[int], offset: int, at: bool) -> int
    var low = 0
    var high = starts.len()
    while low < high
        let middle = (low + high) // 2
        let start = starts[middle]
        if start < offset or (at and start == offset)
            low = middle + 1
        else
            high = middle
    return low

public task place(self: Lines, offset: int) -> Place
    let file = self.source.files[file_index(self.source.files, offset)]
    let line = starts_before(self.starts, offset, true)
    let start = self.starts[line - 1]
    let local = line - starts_before(self.starts, file.start, false)
    let bytes = self.source.bytes
    var column = 1
    for i in start..offset
        # Each byte that does not continue a character starts one.
        let b = bytes[i].to_int()
        if b < 128 or b >= 192
            column += 1
    if local == 1 and offset >= start + 3
        if bytes[start].to_int() == 239 and bytes[start + 1].to_int() == 187
            if bytes[start + 2].to_int() == 191
                column -= 1
    return Place(file: file.path, line: local, column: column)

## Text with each module name of a package as its user writes it: `@a.lib.b`
## is `a.b`, and `@a.c.b` is `a.c.b`. The resolver adds the `@`, and no
## written name has one.
public task plain(value: text) -> text
    if not value.contains("@")
        return value
    let parts = value.split("@")
    var out = parts[0]
    for i in 1..parts.len()
        let part = parts[i]
        var length = 0
        for c in part
            if not is_name_char(c)
                break
            length += 1
        let package = part[0..length]
        let rest = part[length..part.len()]
        if package is empty or not rest.starts_with(".")
            out = "{out}@{part}"
        else if rest.starts_with(".lib.")
            out = "{out}{package}{rest[4..rest.len()]}"
        else
            out = "{out}{package}{rest}"
    return out

# True if a character is alphanumeric, as Rust's `char::is_alphanumeric`
# reads it, or `_`.
# ponytail: ASCII letters and digits only, and any non-ASCII character. A
# package name is ASCII, so only odd text after an `@` can differ.
task is_name_char(c: text) -> bool
    let b = c.bytes()[0].to_int()
    let letter = (b >= 97 and b <= 122) or (b >= 65 and b <= 90)
    return letter or (b >= 48 and b <= 57) or b == 95 or b >= 128

## Merges parser diagnostics into `diags`, except on lines that already have
## one. The lexer's recovery often causes a second, misleading parse error.
public task add_unless_same_line(source: Source, change diags: list[Diagnostic], more: list[Diagnostic])
    let lines = lines(source)
    var taken: set[int] = set([])
    for d in diags
        taken.add(lines.place(d.span.start).line)
    for d in more
        if lines.place(d.span.start).line not in taken
            diags.push(d)

# Diagnostics print in a stable order: by position, then as found.
task sorted(diags: list[Diagnostic]) -> list[Diagnostic]
    var out = diags
    for i in 1..out.len()
        var j = i
        while j > 0 and out[j - 1].span.start > out[j].span.start
            out.swap(j - 1, j)
            j -= 1
    return out

public task render_text(source: Source, diags: list[Diagnostic]) -> text
    let lines = lines(source)
    var out = ""
    for d in sorted(diags)
        let at = lines.place(d.span.start)
        out = "{out}{at.file}:{at.line}:{at.column}: error {d.code}: {plain(d.message)}\n"
        for note in d.notes
            out = "{out}  note: {plain(note)}\n"
        for fix in d.fixes
            out = "{out}  fix: {plain(fix.description)}\n"
    return out

public task render_json(source: Source, diags: list[Diagnostic]) -> text
    let lines = lines(source)
    var out = "["
    var first = true
    for d in sorted(diags)
        let at = lines.place(d.span.start)
        let end = lines.place(d.span.end)
        var notes = ""
        for note in d.notes
            let comma = if notes is empty then "" else ","
            notes = "{notes}{comma}{json_string(plain(note))}"
        var fixes = ""
        for fix in d.fixes
            let comma = if fixes is empty then "" else ","
            fixes = "{fixes}{comma}{fix_json(lines, fix)}"
        let comma = if first then "" else ","
        first = false
        out = "{out}{comma}{{\"code\":{json_string(d.code)},\"severity\":\"error\",\"message\":{json_string(plain(d.message))},\"file\":{json_string(at.file)},\"line\":{at.line},\"column\":{at.column},\"end_line\":{end.line},\"end_column\":{end.column},\"notes\":[{notes}],\"fixes\":[{fixes}]}}"
    return "{out}]\n"

task fix_json(lines: Lines, fix: Fix) -> text
    var edits = ""
    for edit in fix.edits
        let at = lines.place(edit.span.start)
        let end = lines.place(edit.span.end)
        let comma = if edits is empty then "" else ","
        edits = "{edits}{comma}{{\"line\":{at.line},\"column\":{at.column},\"end_line\":{end.line},\"end_column\":{end.column},\"text\":{json_string(edit.text)}}}"
    return "{{\"description\":{json_string(plain(fix.description))},\"edits\":[{edits}]}}"

## A JSON string, escaped as diag.rs escapes it.
public task json_string(value: text) -> text
    if not needs_escape(value, false)
        return "\"{value}\""
    var out = "\""
    for c in value
        if c == "\""
            out = "{out}\\\""
        else if c == "\\"
            out = "{out}\\\\"
        else if c == "\n"
            out = "{out}\\n"
        else if c == "\r"
            out = "{out}\\r"
        else if c == "\t"
            out = "{out}\\t"
        else if c < " "
            let code = hex(c.bytes()[0].to_int())
            let pad = if code.len() == 1 then "000" else "00"
            out = "{out}\\u{pad}{code}"
        else
            out = "{out}{c}"
    return "{out}\""

## True if `value` holds `"`, `\`, a control character, or with `delete`, the
## character 127.
public task needs_escape(value: text, delete: bool) -> bool
    for b in value.bytes()
        let n = b.to_int()
        if n < 32 or n == 34 or n == 92 or (delete and n == 127)
            return true
    return false

## A number in lowercase hexadecimal.
public task hex(n: int) -> text
    let digits = "0123456789abcdef"
    if n < 16
        return digits[n..n + 1]
    return "{hex(n // 16)}{digits[n % 16..n % 16 + 1]}"
