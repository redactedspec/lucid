type P
    a: text
    b: int
choice C
    X(p: P, n: int, t: text)
    Y
task f(c: C) -> text
    return match c
        X(p, n, t) -> "{p.a} {n} {t}"
        Y -> "y"
var p = P(b: 1, a: "s")
var c = X(t: "t", n: 2, p: p)
p.a = "changed"
print f(c)
print f(Y)
var q = [p, p]
q[0].a = "z"
print q[1].a
print q[0].a
for r in q
    print r.a
    q[1].b += 1
print q[1].b
var m = {"k": q}
m["k"][1].a = "deep"
print m["k"][1].a
print q[1].a
let z = if p.b == 1 then p else P(a: "o", b: 0)
print z.a
task loop(n: int) -> int
    var total = 0
    for i in 0..n
        total += match i % 3
            0 -> 1
            _ -> 2
    return total
