---
interface Props {
  lines: { cmd?: string; out?: string }[];
  title?: string;
}
const { lines, title } = Astro.props;
---
<figure class="term panel">
  {title && <figcaption>{title}</figcaption>}
  <pre><code>{lines.map((line) => line.cmd !== undefined
    ? <span class="line"><span class="prompt" aria-hidden="true">$ </span><span class="cmd">{line.cmd}</span>{'\n'}</span>
    : <span class="line out">{line.out}{'\n'}</span>)}</code></pre>
</figure>

<style>
  .term { margin: 0; background: var(--color-paper-3); }
  figcaption { padding: var(--space-sm) var(--space-md); border-bottom: var(--rule-hair) solid var(--color-rule); font-size: var(--text-sm); color: var(--color-muted); background: var(--color-paper-2); }
  pre { margin: 0; padding: var(--space-md) var(--space-lg); overflow-x: auto; font-size: var(--text-sm); line-height: 1.7; }
  .prompt { color: var(--color-accent); user-select: none; }
  .cmd { color: var(--color-ink); }
  .out { color: var(--color-cool); }
</style>
