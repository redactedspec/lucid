---
import { Code } from 'astro:components';
import lucid from '../lucid.tmLanguage.json';
import theme from '../lucid-dark.theme.json';

interface Props {
  code: string;
  title: string;
  lang?: 'lucid' | 'sh' | 'toml' | 'json';
}

const { code, title, lang = 'lucid' } = Astro.props;
const language = lang === 'lucid' ? ({ ...lucid } as any) : lang;
---
<figure class="code panel">
  <figcaption>
    <span class="file">{title}</span>
    <button type="button" class="copy" data-copy={code} aria-label={`Copy ${title}`}>
      <span class="label">Copy</span>
    </button>
  </figcaption>
  <Code code={code.trimEnd()} lang={language} theme={theme as any} />
</figure>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    button.addEventListener('click', async () => {
      const label = button.querySelector('.label');
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        if (label) label.textContent = 'Copied';
      } catch {
        if (label) label.textContent = 'Copy failed';
      }
      setTimeout(() => { if (label) label.textContent = 'Copy'; }, 1600);
    });
  }
</script>

<style>
  .code { margin: 0; }
  figcaption {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-md);
    padding: var(--space-2xs) var(--space-2xs) var(--space-2xs) var(--space-md); border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .file { font: 400 var(--text-sm)/1.2 var(--font-outlier); color: var(--color-ink-2); }
  .copy {
    font: 500 var(--text-sm)/1 var(--font-body); color: var(--color-muted); background: transparent;
    border: 0; border-radius: var(--radius-pill); padding: var(--space-sm) var(--space-md); cursor: pointer; min-height: 44px;
    transition: color var(--dur-short) var(--ease-out), background-color var(--dur-short) var(--ease-out);
  }
  .copy:hover { color: var(--color-ink); background: var(--color-rule); }
  .copy:active { background: var(--color-paper-3); }
  .copy:disabled { opacity: 0.55; cursor: not-allowed; }
  .label { display: inline-block; min-width: 4.5em; }
  .code :global(pre) {
    margin: 0; padding: var(--space-md) var(--space-lg); overflow-x: auto;
    font-size: var(--text-sm); line-height: 1.7; background: var(--color-paper-3) !important;
  }
</style>
