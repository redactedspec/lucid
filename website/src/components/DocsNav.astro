---
// Replaces Starlight's social icons with links back to the rest of the site.
const links = [
  { href: '/learn/', label: 'Learn' },
  { href: '/features/', label: 'Features' },
  { href: '/roadmap/', label: 'Roadmap' },
  { href: '/downloads/', label: 'Downloads' },
];
---
<nav aria-label="Site" class="docs-nav">
  {links.map((l) => <a href={l.href}>{l.label}</a>)}
</nav>

<style>
  .docs-nav { display: flex; gap: 1.1rem; }
  a { color: var(--sl-color-gray-2); text-decoration: none; font-size: var(--sl-text-sm); }
  a:hover { color: var(--sl-color-white); }
</style>
