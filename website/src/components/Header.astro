---
import Wordmark from './Wordmark.astro';

const nav = [
  { href: '/docs/', label: 'Docs' },
  { href: '/learn/', label: 'Learn' },
  { href: '/features/', label: 'Features' },
  { href: '/roadmap/', label: 'Roadmap' },
  { href: '/downloads/', label: 'Downloads' },
];

const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="home" aria-label="Lucid home"><Wordmark /></a>

    <nav aria-label="Main" class="desktop">
      <ul>
        {nav.map((item) => <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>
    <a href="/downloads/" class="status desktop">1.0.0, from source</a>

    <details class="mobile">
      <summary aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" /></svg>
      </summary>
      <nav aria-label="Main">
        <ul>
          {nav.map((item) => <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>)}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: var(--z-sticky-nav);
    background: var(--color-paper);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .bar { display: flex; align-items: center; gap: var(--space-xl); height: var(--nav-h); }
  .home { display: inline-flex; text-decoration: none; padding-block: var(--space-xs); }
  ul { display: flex; gap: var(--space-2xs); list-style: none; margin: 0; padding: 0; }
  nav a {
    display: block; padding: var(--space-xs) var(--space-sm); border-radius: var(--radius-pill);
    color: var(--color-muted); text-decoration: none; font-weight: 500;
    transition: color var(--dur-short) var(--ease-out), background-color var(--dur-short) var(--ease-out);
  }
  nav a:hover { color: var(--color-ink); background: var(--color-paper-2); }
  nav a:active { background: var(--color-paper-3); }
  nav a[aria-current='page'] { color: var(--color-ink); background: var(--color-paper-2); }
  .status {
    margin-left: auto; font-size: var(--text-sm); color: var(--color-muted);
    text-decoration-line: underline; text-decoration-color: var(--color-rule-2); text-underline-offset: 0.2em;
    transition: color var(--dur-short) var(--ease-out);
  }
  .status:hover { color: var(--color-accent); text-decoration-color: var(--color-accent); }
  .status:active { color: var(--color-ink-2); }

  .mobile { display: none; position: relative; margin-left: auto; }
  summary {
    list-style: none; cursor: pointer; display: grid; place-items: center;
    width: 44px; height: 44px; border: var(--rule-hair) solid var(--color-rule-2); border-radius: var(--radius-pill); color: var(--color-ink);
  }
  summary:hover { background: var(--color-paper-2); }
  summary::-webkit-details-marker { display: none; }
  .mobile nav {
    position: absolute; right: 0; top: calc(100% + var(--space-xs)); min-width: 13rem; z-index: var(--z-dropdown);
    background: var(--color-paper-2); border: var(--rule-hair) solid var(--color-rule-2); border-radius: var(--radius-card); padding: var(--space-2xs);
  }
  .mobile ul { flex-direction: column; }
  .mobile nav a { padding: var(--space-sm); font-size: var(--text-lead); }

  @media (max-width: 56rem) {
    .desktop { display: none; }
    .mobile { display: block; }
  }
</style>
