---
import Wordmark from './Wordmark.astro';

const groups = [
  {
    title: 'Docs',
    links: [
      { href: '/docs/', label: 'Getting started' },
      { href: '/docs/syntax/', label: 'Language' },
      { href: '/docs/cli/', label: 'CLI reference' },
      { href: '/docs/diagnostics/', label: 'Diagnostics' },
    ],
  },
  {
    title: 'Project',
    links: [
      { href: '/features/', label: 'Features' },
      { href: '/roadmap/', label: 'Roadmap' },
      { href: '/downloads/', label: 'Downloads' },
      { href: '/learn/', label: 'Learn' },
    ],
  },
  {
    title: 'For agents',
    links: [
      { href: '/docs/ai-agents/', label: 'Writing Lucid with agents' },
      { href: '/agent-guide.md', label: 'agent-guide.md' },
    ],
  },
];
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="brand">
      <Wordmark />
      <p>A readable, memory-safe, compiled language. In development: no public release yet.</p>
      <p class="fine">Compiler under GPL-3.0-or-later. Runtime and standard library add a linking exception, so built programs may use any license.</p>
    </div>
    {groups.map((group) => (
      <nav aria-label={group.title}>
        <h2>{group.title}</h2>
        <ul>{group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <div class="wrap base">
    <span>lucidlang.dev</span>
    <span>Files end in <code>.lcd</code></span>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); padding-top: 3.5rem; margin-top: 2rem; }
  .grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 2.5rem; }
  .brand { display: grid; gap: 1rem; align-content: start; max-width: 22rem; }
  .brand p { color: var(--text-muted); font-size: 0.9375rem; }
  .brand .fine { color: var(--text-faint); font-size: 0.8125rem; }
  h2 { font: 500 0.75rem/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 1rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  a { color: var(--text-muted); text-decoration: none; font-size: 0.9375rem; }
  a:hover { color: var(--text); }
  .base {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    margin-top: 3.5rem; padding-block: 1.5rem; border-top: 1px solid var(--line);
    color: var(--text-faint); font: 400 0.8125rem/1.4 var(--mono);
  }
  @media (max-width: 52rem) {
    .grid { grid-template-columns: 1fr 1fr; }
    .brand { grid-column: 1 / -1; }
  }
</style>
