---
import Wordmark from './Wordmark.astro';

const groups = [
  {
    title: 'Docs',
    links: [
      { href: '/docs/', label: 'Getting started' },
      { href: '/docs/syntax/', label: 'Language' },
      { href: '/docs/cli/', label: 'CLI reference' },
      { href: '/docs/diagnostics/', label: 'Diagnostics' },
    ],
  },
  {
    title: 'Project',
    links: [
      { href: '/features/', label: 'Features' },
      { href: '/roadmap/', label: 'Roadmap' },
      { href: '/downloads/', label: 'Downloads' },
      { href: '/learn/', label: 'Learn' },
      { href: 'https://github.com/redactedspec/lucid', label: 'Source on GitHub' },
    ],
  },
  {
    title: 'For agents',
    links: [
      { href: '/docs/ai-agents/', label: 'Writing Lucid with agents' },
      { href: '/agent-guide.md', label: 'agent-guide.md' },
    ],
  },
];
---
<footer class="site-footer">
  <div class="container grid">
    <div class="brand">
      <Wordmark size={32} />
      <p>A readable, memory-safe, compiled language. Version 1.0.0, open source under MIT or Apache-2.0.</p>
    </div>
    {groups.map((group) => (
      <nav aria-label={group.title}>
        <h2>{group.title}</h2>
        <ul>{group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <div class="container base">
    <p>Licensed under MIT or Apache-2.0, at your option. Built programs may use any license.</p>
  </div>
</footer>

<style>
  .site-footer { border-top: var(--rule-hair) solid var(--color-rule); padding-top: var(--space-2xl); background: var(--color-paper-3); }
  .grid { display: grid; grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr)); gap: var(--gap-columns); }
  .brand { display: grid; gap: var(--space-md); align-content: start; }
  .brand p { color: var(--color-muted); max-width: 34ch; }
  h2 { font: 500 var(--text-sm)/1.2 var(--font-body); letter-spacing: 0; text-wrap: balance; color: var(--color-muted); margin-bottom: var(--space-md); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-xs); }
  a { color: var(--color-ink-2); text-decoration: none; transition: color var(--dur-short) var(--ease-out); }
  a:hover { color: var(--color-accent); }
  a:active { color: var(--color-ink); }
  .base { margin-top: var(--space-2xl); padding-block: var(--space-lg); border-top: var(--rule-hair) solid var(--color-rule); }
  .base p { color: var(--color-muted); font-size: var(--text-sm); max-width: 75ch; }
  @media (max-width: 56rem) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .brand { grid-column: 1 / -1; }
  }
</style>
