---
interface Props { size?: number }
const { size = 24 } = Astro.props;
---
<span class="wordmark">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path d="M10.5 6v18.5h13" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="square" />
    <rect x="19" y="6" width="4" height="10" class="cursor" />
  </svg>
  <span class="name">lucid</span>
</span>

<style>
  .wordmark { display: inline-flex; align-items: center; gap: var(--space-xs); color: var(--color-ink); }
  .cursor { fill: var(--color-accent); }
  .name { font: 600 1.25rem/1 var(--font-display); letter-spacing: -0.03em; }
</style>
