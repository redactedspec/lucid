---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist." noindex>
  <div class="container">
    <header class="page-head lost">
      <h1>No such page.</h1>
      <p>The address may be wrong, or the page may have moved.</p>
      <div class="actions">
        <a href="/" class="btn btn--primary">Home</a>
        <a href="/docs/" class="btn">Documentation</a>
      </div>
    </header>
  </div>
</Base>

<style>
  .lost { border-bottom: 0; padding-block: var(--section-gap) var(--section-gap-l); }
  .actions { display: flex; gap: var(--space-sm); flex-wrap: wrap; }
</style>
