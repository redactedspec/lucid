---
import Base from '../layouts/Base.astro';
import CodeWindow from '../components/CodeWindow.astro';
import Terminal from '../components/Terminal.astro';
import { features } from '../data/features';
import { inline } from '../lib/inline';
---
<Base
  title="Features"
  description="What Lucid does today: readable syntax, inferred ownership, memory safety without a garbage collector, Cranelift native code, WebAssembly, explicit errors, and tools for AI agents."
>
  <div class="container">
    <header class="page-head">
      <h1>What Lucid does, and what it costs.</h1>
      <p>Every capability here runs in the compiler today, and each one lists its limits.</p>
      <nav aria-label="On this page" class="toc">
        <ol>{features.map((f) => <li><a href={`#${f.id}`}>{f.title}</a></li>)}</ol>
      </nav>
    </header>

    <ol class="stack">
      {features.map((f) => (
        <li id={f.id} class="feature">
          <div class="text">
            <h2>{f.title}</h2>
            <div class="prose">
              {f.body.map((p) => <p set:html={inline(p)} />)}
            </div>
            {f.limits && (
              <dl class="limits">
                <dt>Limits</dt>
                <dd set:html={inline(f.limits)} />
              </dl>
            )}
            <a href={f.docs.href} class="link">{f.docs.label} docs</a>
          </div>
          <div class="demo">
            {f.code && <CodeWindow code={f.code.source} title={f.code.file} />}
            {f.terminal && <Terminal lines={f.terminal} />}
          </div>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .toc ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .toc a {
    display: inline-flex; align-items: center; min-height: 44px; padding-inline: var(--space-md);
    border: var(--rule-hair) solid var(--color-rule); border-radius: var(--radius-pill);
    color: var(--color-ink-2); text-decoration: none; font-size: var(--text-sm); font-weight: 500;
    transition: color var(--dur-short) var(--ease-out), border-color var(--dur-short) var(--ease-out);
  }
  .toc a:hover { color: var(--color-accent); border-color: var(--color-accent); }
  .toc a:active { color: var(--color-ink); }
  .toc a { white-space: nowrap; }
  @media (max-width: 40rem) {
    .toc ol { flex-wrap: nowrap; overflow-x: auto; padding-bottom: var(--space-xs); scroll-snap-type: x proximity; }
    .toc li { scroll-snap-align: start; }
  }

  .stack { list-style: none; margin: 0; padding: 0; }
  .feature {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-3xl); align-items: start;
    padding-block: var(--space-3xl); border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .feature:nth-child(even) { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); }
  .feature:last-child { border-bottom: 0; padding-bottom: var(--section-gap-s); }
  .text { display: grid; gap: var(--space-lg); justify-items: start; position: sticky; top: calc(var(--nav-h) + var(--space-xl)); }
  .text h2 { font-size: var(--text-2xl); max-width: 20ch; }
  .limits { margin: 0; padding: var(--space-md) var(--space-lg); background: var(--color-paper-2); border-radius: var(--radius-card); display: grid; gap: var(--space-2xs); }
  .limits dt { font-weight: 500; color: var(--color-ink); }
  .limits dd { margin: 0; color: var(--color-muted); max-width: 60ch; }
  .demo { display: grid; gap: var(--space-md); min-width: 0; }

  @media (max-width: 60rem) {
    .feature, .feature:nth-child(even) { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); padding-block: var(--space-2xl); }
    .text { position: static; }
  }
</style>
