---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';

const platforms = [
  { name: 'Windows x86-64', state: 'Works in development', tag: 'done', detail: '`lucid run`, `test`, `check`, `build` to `.exe`, and `build --target web`.' },
  { name: 'Linux x86-64', state: 'Works in development', tag: 'done', detail: '`run`, `test`, and `build`, checked under WSL.' },
  { name: 'Browser and Node', state: 'Works as an output target', tag: 'done', detail: '`lucid build --target web` writes a `.js` file that runs anywhere WebAssembly does.' },
  { name: 'macOS', state: 'Deferred', tag: 'planned', detail: 'No milestone yet.' },
];
const code = (s: string) => s.replace(/`([^`]+)`/g, '<code>$1</code>');
---
<Base
  title="Downloads"
  description="Lucid 1.0.0 builds from source. Supported platforms, what works today, and how the installers will work once binaries are published."
>
  <div class="container">
    <header class="page-head">
      <h1>Build 1.0.0 from source.</h1>
      <p>Version 1.0.0 is tagged, and the <a class="link" href="https://github.com/redactedspec/lucid">source is on GitHub</a>. There are no published binaries yet, so for now you build it with <code>cargo</code>, as <a class="link" href="/docs/installation/">Installation</a> shows.</p>
    </header>

    <section class="block" aria-labelledby="platforms-title">
      <h2 id="platforms-title">Where it runs today</h2>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th scope="col">Platform</th><th scope="col">State</th><th scope="col">What works</th></tr></thead>
          <tbody>
            {platforms.map((p) => (
              <tr>
                <th scope="row">{p.name}</th>
                <td><span class={`state state--${p.tag}`}>{p.state}</span></td>
                <td set:html={code(p.detail)} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="block split" aria-labelledby="install-title">
      <div class="prose">
        <h2 id="install-title">Installers, once there are binaries</h2>
        <p>These two commands are reserved. Today each script prints that no binaries are published and stops with an error. It downloads nothing.</p>
        <p>The real installers will:</p>
        <ul>
          <li>read the release list published on <code>lucidlang.dev</code>, with no hard-coded download URL,</li>
          <li>download over HTTPS only, and check the SHA-256 of each archive before using it,</li>
          <li>stop with a clear message on an unsupported system, a failed download, or a bad checksum,</li>
          <li>install into your user directory, with no administrator rights,</li>
          <li>run nothing they download, and change no shell profile without asking,</li>
          <li>update in place when run again, and do nothing when already current.</li>
        </ul>
      </div>
      <div class="terms">
        <Terminal title="Windows, PowerShell" lines={[{ cmd: 'irm https://lucidlang.dev/install.ps1 | iex' }, { out: 'Lucid has no published binaries yet.' }]} />
        <Terminal title="Linux, sh" lines={[{ cmd: 'curl -fsSL https://lucidlang.dev/install.sh | sh' }, { out: 'Lucid has no published binaries yet.' }]} />
      </div>
    </section>

    <section class="block until" aria-labelledby="follow-title">
      <h2 id="follow-title">Until then</h2>
      <p>Build from source, read the <a class="link" href="/docs/">documentation</a>, or follow the <a class="link" href="/roadmap/">roadmap</a>.</p>
    </section>
  </div>
</Base>

<style>
  .block { padding-block: var(--space-3xl); border-bottom: var(--rule-hair) solid var(--color-rule); }
  .block:last-child { border-bottom: 0; padding-bottom: var(--section-gap-s); }
  h2 { font-size: var(--text-2xl); margin-bottom: var(--space-xl); text-wrap: balance; }
  .prose h2 { margin-bottom: var(--space-xs); }
  .table { min-width: 40rem; }
  .table tbody th { white-space: nowrap; }
  .split { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: var(--space-3xl); align-items: start; }
  .prose ul { margin: 0; padding-left: var(--space-lg); display: grid; gap: var(--space-xs); }
  .terms { display: grid; gap: var(--space-md); min-width: 0; }
  .until p { color: var(--color-muted); font-size: var(--text-lead); max-width: 52ch; }
  .until h2 { margin-bottom: var(--space-md); }
  @media (max-width: 60rem) { .split { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); } }
</style>
