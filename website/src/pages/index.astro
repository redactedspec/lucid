---
import Base from '../layouts/Base.astro';
import Diagnostic from '../components/Diagnostic.astro';
import { features } from '../data/features';
import { milestones } from '../data/roadmap';

// One line of real Lucid per feature, taken from the examples on /features.
const inCode: Record<string, string> = {
  readable: 'task is_adult(self: User) -> bool',
  values: 'var b = a',
  safety: 'if index is not none',
  native: 'lucid build hello.lcd',
  web: 'lucid build --target web hello.lcd',
  explicit: 'bump(change total, 3)',
  agents: 'lucid check --json main.lcd',
};

const current = milestones.find((m) => m.status === 'active') ?? milestones.at(-1)!;
const stepsDone = current.steps!.filter((s) => s.done).length;
const label = { done: 'Done', active: 'In progress', planned: 'Planned' } as const;

const commands = [
  { cmd: 'lucid run hello.lcd', does: 'Compiles with a JIT and runs it.' },
  { cmd: 'lucid check hello.lcd', does: 'Reports errors, and prints nothing when there are none.' },
  { cmd: 'lucid test hello.lcd', does: 'Runs the file’s tests.' },
  { cmd: 'lucid build hello.lcd', does: 'Writes a standalone executable.' },
  { cmd: 'lucid build --target web hello.lcd', does: 'Writes one .js file for a browser or Node.' },
  { cmd: 'lucid explain E0316', does: 'Explains a diagnostic code.' },
];
---
<Base
  title="Lucid"
  description="Lucid is a readable, memory-safe programming language that compiles to native code with Cranelift and to WebAssembly. Inferred ownership, explicit errors, and machine-readable diagnostics for people and AI agents."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="copy">
        <h1>Clarity, compiled.</h1>
        <p class="lead">A readable language that compiles to native code and WebAssembly.</p>
        <div class="actions">
          <a href="/docs/" class="btn btn--primary">Read the docs</a>
          <a href="/learn/" class="btn">Take the tour</a>
        </div>
      </div>
      <Diagnostic />
    </div>
  </section>

  <section class="section--wide" aria-labelledby="features-title">
    <div class="container">
      <div class="head head--split">
        <h2 id="features-title">Explicit where it matters.</h2>
        <p>Signatures say what changes, what fails, and what runs on another thread. The compiler infers the rest.</p>
      </div>
      <div class="table-wrap">
        <table class="table features">
          <thead><tr><th scope="col">What it does</th><th scope="col">What you write</th></tr></thead>
          <tbody>
            {features.map((f) => (
              <tr>
                <th scope="row"><a href={`/features/#${f.id}`}>{f.title}</a></th>
                <td><code>{inCode[f.id]}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <a href="/features/" class="link more">All features, with examples and limits</a>
    </div>
  </section>

  <section class="section status" aria-labelledby="status-title">
    <div class="container status-grid">
      <div class="reading">
        <h2 id="status-title">Ten milestones done. Release is next.</h2>
        <p class="figure"><span class="measured big">{stepsDone}/{current.steps!.length}</span></p>
        <p class="caption">{current.id} steps done. {current.id} readies version 1.0.0 for release.</p>
        <a href="/roadmap/" class="link">Read the roadmap</a>
      </div>
      <ol class="trail">
        {milestones.map((m) => (
          <li class={m.status}>
            <span class="measured id">{m.id}</span>
            <span class="title">{m.title}</span>
            <span class={`state state--${m.status}`}>{label[m.status]}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section band" aria-labelledby="start-title">
    <div class="container start">
      <div class="head">
        <h2 id="start-title">A handful of commands.</h2>
        <p>Every command also speaks JSON with <code>--json</code>. Binaries are not published yet, and the source repository is not public.</p>
      </div>
      <div class="table-wrap">
        <table class="table commands">
          <thead><tr><th scope="col">Command</th><th scope="col">What it does</th></tr></thead>
          <tbody>
            {commands.map((c) => (
              <tr><td><code class="cmd">{c.cmd}</code></td><td>{c.does}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <a href="/docs/installation/" class="link">What a build from source needs</a>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: var(--space-4xl); min-height: 44rem; display: grid; align-items: center; }
  .hero :global(.src pre) { font-size: var(--text-md); padding-block: var(--space-lg); }
  .hero :global(.out) { font-size: var(--text-md); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--space-2xl); align-items: center; }
  .copy { display: grid; gap: var(--space-lg); justify-items: start; }
  .copy .lead { color: var(--color-ink-2); max-width: 30ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-xs); }

  .features th, .features td { padding-block: var(--space-lg); }
  .features th { font-size: var(--text-title); font-weight: 500; letter-spacing: -0.015em; line-height: 1.2; width: 50%; }
  .features thead th { font-size: var(--text-sm); letter-spacing: 0; }
  .features th a { color: var(--color-ink); text-decoration: none; transition: color var(--dur-short) var(--ease-out); }
  .features th a:hover { color: var(--color-accent); }
  .features td { vertical-align: middle; }
  .more { display: inline-block; margin-top: var(--space-xl); }
  .features code { font-size: var(--text-md); border: 0; background: none; padding: 0; color: var(--color-cool); }

  .status-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-3xl); align-items: start; }
  .reading { display: grid; gap: var(--space-lg); justify-items: start; position: sticky; top: calc(var(--nav-h) + var(--space-xl)); }
  .figure { margin-top: var(--space-md); }
  .big { font-size: clamp(5rem, 9vw, 9rem); line-height: 0.9; letter-spacing: -0.04em; color: var(--color-ink); }
  .caption { color: var(--color-muted); max-width: 36ch; }
  .trail { list-style: none; margin: 0; padding: 0; border-left: var(--rule-hair) solid var(--color-rule-2); }
  .trail li {
    display: grid; grid-template-columns: 4ch minmax(0, 1fr) auto; gap: var(--space-md); align-items: baseline;
    padding: var(--space-md) var(--space-md) var(--space-md) var(--space-lg); border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .trail .id { color: var(--color-muted); }
  .trail .title { color: var(--color-ink-2); font-size: var(--text-lg); }
  .trail .active { background: var(--color-accent-soft); box-shadow: inset 2px 0 0 var(--color-accent); }
  .trail .active .title, .trail .active .id { color: var(--color-ink); }

  .start { display: grid; gap: var(--space-xl); justify-items: start; }
  .start .head { margin-bottom: 0; }
  .start .table-wrap { width: 100%; }
  .commands td:first-child { width: 50%; }
  .commands .cmd { border: 0; background: none; padding: 0; color: var(--color-ink); font-size: var(--text-md); white-space: nowrap; }

  @media (max-width: 60rem) {
    .hero { min-height: 0; padding-block: var(--space-2xl); }
    .hero-grid, .status-grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
    .reading { position: static; }
    .features th { width: auto; }
  }
  @media (max-width: 40rem) {
    .features thead, .commands thead { display: none; }
    .features tr, .commands tr { display: grid; gap: var(--space-xs); padding-block: var(--space-md); border-bottom: var(--rule-hair) solid var(--color-rule); }
    .features th, .features td, .commands td { padding: 0; border: 0; width: auto; }
    .commands .cmd { white-space: normal; overflow-wrap: normal; }
  }
</style>
