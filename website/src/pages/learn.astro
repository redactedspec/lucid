---
import Base from '../layouts/Base.astro';
import CodeWindow from '../components/CodeWindow.astro';
import { repoFile } from '../lib/inline';

const path = [
  { href: '/docs/', title: 'Getting started', text: 'Write, run, check, and test a first program.' },
  { href: '/docs/syntax/', title: 'Syntax', text: 'Indentation, statements, comments, and names.' },
  { href: '/docs/variables-and-types/', title: 'Variables and types', text: '`let`, `var`, numbers, text, and why there are no implicit conversions.' },
  { href: '/docs/control-flow/', title: 'Control flow', text: '`if`, `while`, `for`, ranges, and `then` expressions.' },
  { href: '/docs/tasks/', title: 'Tasks', text: 'Functions, defaults, lambdas, and parameter modes.' },
  { href: '/docs/collections/', title: 'Collections', text: 'Lists, maps, and sets as values.' },
  { href: '/docs/types-and-choices/', title: 'Types, choices, and unions', text: 'Records, closed sets of variants, `match`, and narrowing.' },
  { href: '/docs/errors/', title: 'Error handling', text: 'Errors as values, `try`, `else`, and traps.' },
  { href: '/docs/ownership/', title: 'Ownership and memory', text: 'Value semantics, `change`, `take`, and what copies cost.' },
  { href: '/docs/concurrency/', title: 'Concurrency', text: 'Threads, channels, and locks.' },
];

const examples = [
  { file: 'examples/hello.lcd', about: 'Tasks, lists, a loop, `is empty`, and interpolation.' },
  { file: 'examples/todo.lcd', about: 'A command-line to-do list that saves JSON to a file, with `std.args`, `std.fs`, and `std.json`.' },
  { file: 'examples/workers.lcd', about: 'Threads that share work through a channel and a lock.' },
  { file: 'examples/website.lcd', about: 'An HTTP server with a page and a JSON endpoint, from `std.http` and `std.html`.' },
].map((e) => ({ ...e, source: repoFile(e.file), name: e.file.split('/').pop()! }));

const code = (s: string) => s.replace(/`([^`]+)`/g, '<code>$1</code>');
---
<Base
  title="Learn"
  description="Learn Lucid: a guided path through the language docs, and complete example programs that run with the current compiler."
>
  <div class="container">
    <header class="page-head">
      <h1>Learn Lucid in an afternoon.</h1>
      <p>The whole reference fits in one sitting. Follow the path in order, then read the example programs.</p>
    </header>

    <section aria-labelledby="path-title" class="block">
      <h2 id="path-title" class="sr-only">The path, in order</h2>
      <ol class="path">
        {path.map((step) => (
          <li>
            <a href={step.href}>
              <span class="title">{step.title}</span>
              <span class="text" set:html={code(step.text)} />
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="examples-title" class="block">
      <div class="head head--split">
        <h2 id="examples-title">Four whole programs.</h2>
        <p>These are the example programs from the Lucid repository. The compiler’s test suite runs them, so they stay current.</p>
      </div>
      <div class="examples">
        {examples.map((e) => (
          <article>
            <p set:html={code(e.about)} />
            <CodeWindow code={e.source} title={e.name} />
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="agents-title" class="block agents">
      <div class="agents-text">
        <h2 id="agents-title">Teaching an agent</h2>
        <p>One file holds everything that runs today, sized for an agent’s context window. Give it to the agent with the task, and let it read diagnostics with <code>--json</code>.</p>
      </div>
      <div class="actions">
        <a class="btn btn--primary" href="/agent-guide.md">Open agent-guide.md</a>
        <a class="link" href="/docs/ai-agents/">Writing Lucid with agents</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .block { padding-block: var(--space-3xl); border-bottom: var(--rule-hair) solid var(--color-rule); }
  .block:last-child { border-bottom: 0; padding-bottom: var(--section-gap-s); }
  .path { list-style: none; margin: 0; padding: 0; counter-reset: step; }
  .path li { counter-increment: step; border-bottom: var(--rule-hair) solid var(--color-rule); }
  .path li:first-child { border-top: var(--rule-hair) solid var(--color-rule); }
  .path a {
    display: grid; grid-template-columns: 4ch minmax(0, 5fr) minmax(0, 7fr); gap: var(--gap-columns); align-items: baseline;
    padding-block: var(--space-lg); text-decoration: none;
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .path a::before { content: counter(step); font: 400 var(--text-sm)/1 var(--font-outlier); color: var(--color-muted); font-variant-numeric: tabular-nums; text-align: right; }
  .path a:hover { background: var(--color-paper-2); }
  .path a:hover .title { color: var(--color-accent); }
  .path a:active { background: var(--color-paper-3); }
  .title { font-size: var(--text-title); font-weight: 500; letter-spacing: -0.015em; color: var(--color-ink); transition: color var(--dur-short) var(--ease-out); }
  .text { color: var(--color-muted); }
  .examples { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2xl) var(--gap-columns); }
  article { display: grid; gap: var(--space-md); align-content: start; min-width: 0; }
  article p { color: var(--color-muted); max-width: 52ch; }
  .agents { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--gap-columns); align-items: end; }
  .agents-text { display: grid; gap: var(--space-md); }
  .agents h2 { font-size: var(--text-section); }
  .agents-text p { color: var(--color-muted); font-size: var(--text-lead); line-height: 1.45; max-width: 46ch; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-lg); justify-content: end; }
  @media (max-width: 60rem) {
    .examples, .agents { grid-template-columns: minmax(0, 1fr); }
    .path a { grid-template-columns: 3ch minmax(0, 1fr); row-gap: var(--space-2xs); }
    .path .text { grid-column: 2; }
    .actions { justify-content: start; }
  }
</style>
