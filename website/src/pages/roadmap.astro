---
import Base from '../layouts/Base.astro';
import { milestones, later } from '../data/roadmap';
import { inline } from '../lib/inline';

const label = { done: 'Done', active: 'In progress', planned: 'Planned' } as const;
---
<Base
  title="Roadmap"
  description="Lucid's development milestones: M0 to M9 are done, with the 1.0 stability promise and a self-hosted front end."
>
  <div class="container">
    <header class="page-head">
      <h1>One runnable result per milestone.</h1>
      <p>Each milestone ends with an exit test that must pass before the next starts. The 1.0 stability promise holds from the end of M8.</p>
    </header>

    <ol class="trail">
      {milestones.map((m) => (
        <li class={m.status}>
          <div class="side">
            <span class="measured id">{m.id}</span>
            <span class={`state state--${m.status}`}>{label[m.status]}</span>
          </div>
          <div class="body">
            <h2>{m.title}</h2>
            <p set:html={inline(m.summary)} />
            {m.steps && (
              <ul class="steps">
                {m.steps.map((s) => (
                  <li class={s.done ? 'step done' : 'step'}>
                    <span class="mark" aria-hidden="true">{s.done ? 'Done' : 'To do'}</span>
                    <span class="sr-only">{s.done ? 'Done:' : 'To do:'}</span>
                    <span set:html={inline(s.text)} />
                  </li>
                ))}
              </ul>
            )}
            <dl class="exit"><dt>Exit test</dt><dd set:html={inline(m.exit)} /></dl>
          </div>
        </li>
      ))}
    </ol>
    <p class="later">{later}</p>
  </div>
</Base>

<style>
  .trail { list-style: none; margin: 0; padding: 0; }
  .trail > li {
    display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: var(--gap-columns);
    padding-block: var(--space-xl); border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .trail > li.active { background: var(--color-paper-2); box-shadow: inset 2px 0 0 var(--color-accent); padding-inline: var(--space-lg); border-radius: 0 var(--radius-card) var(--radius-card) 0; }
  .side { display: grid; gap: var(--space-xs); align-content: start; justify-items: start; }
  .id { font-size: var(--text-xl); color: var(--color-ink); }
  .body { display: grid; gap: var(--space-sm); max-width: 50rem; }
  .body h2 { font-size: var(--text-xl); }
  .body > p { color: var(--color-muted); }
  .steps { list-style: none; margin: var(--space-xs) 0; padding: 0; display: grid; gap: var(--space-xs); }
  .step { display: grid; grid-template-columns: 6ch minmax(0, 1fr); gap: var(--space-sm); color: var(--color-muted); }
  .step.done { color: var(--color-ink-2); }
  .mark { font-size: var(--text-sm); font-weight: 500; color: var(--color-muted); padding-top: var(--space-3xs); }
  .done .mark { color: var(--color-ok); }
  .exit { margin: 0; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-sm); font-size: var(--text-sm); }
  .exit dt { font-weight: 500; color: var(--color-ink); }
  .exit dd { margin: 0; color: var(--color-muted); }
  .later { color: var(--color-muted); padding-block: var(--space-xl) var(--section-gap-s); max-width: 65ch; }

  @media (max-width: 48rem) {
    .trail > li { grid-template-columns: minmax(0, 1fr); gap: var(--space-sm); }
    .side { grid-auto-flow: column; justify-content: start; align-items: baseline; gap: var(--space-md); }
    .exit { grid-template-columns: minmax(0, 1fr); gap: var(--space-2xs); }
  }
</style>
