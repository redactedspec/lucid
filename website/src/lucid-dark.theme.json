{
  "name": "lucid-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#06080b",
    "editor.foreground": "#c3c8cc",
    "editorLineNumber.foreground": "#484e54"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#9da2a8" } },
    { "scope": ["keyword", "storage", "keyword.declaration"], "settings": { "foreground": "#6ebcfc" } },
    { "scope": ["keyword.operator.word", "keyword.other.mode"], "settings": { "foreground": "#6ebcfc" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#9da2a8" } },
    { "scope": ["string"], "settings": { "foreground": "#e9d1a0" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#f7b83d" } },
    { "scope": ["punctuation.section.interpolation"], "settings": { "foreground": "#f7b83d" } },
    { "scope": ["source.lucid.embedded"], "settings": { "foreground": "#c3c8cc" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#f7b83d" } },
    { "scope": ["entity.name.type", "support.type"], "settings": { "foreground": "#eceff2" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#eceff2" } },
    { "scope": ["support.function.builtin"], "settings": { "foreground": "#6ebcfc" } },
    { "scope": ["entity.name.function.call"], "settings": { "foreground": "#eceff2" } },
    { "scope": ["string.quoted.double.toml", "string.quoted.single.toml"], "settings": { "foreground": "#e9d1a0" } },
    { "scope": ["entity.name.tag.toml", "support.type.property-name"], "settings": { "foreground": "#6ebcfc" } },
    { "scope": ["variable.parameter", "variable.other"], "settings": { "foreground": "#c3c8cc" } }
  ]
}
