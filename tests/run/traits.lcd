trait Describe
    task describe(self) -> text

trait Sized
    task area(self, scale: float) -> float

type Dog
    name: text

type Cat
    lives: int

choice Shape
    Circle(radius: float)
    Square(side: float)

task describe(self: Dog) -> text
    return "dog {self.name}"

task describe(self: Cat) -> text
    return "cat with {self.lives} lives"

task describe(self: list[int]) -> text
    return "{self.len()} numbers"

task describe[T: Describe](self: Maybe[T]) -> text
    return match self
        Has(value) -> "has {value.describe()}"
        Nothing -> "nothing"

choice Maybe[T]
    Has(value: T)
    Nothing

task area(self: Shape, scale: float) -> float
    let base = match self
        Circle(radius) -> 3.0 * radius * radius
        Square(side) -> side * side
    return base * scale

task is_empty(self: Cat) -> bool
    return self.lives == 0

task older(self: Cat, by: int = 1) -> Cat
    return Cat(lives: self.lives + by)

task show_all[T: Describe](items: list[T])
    for item in items
        print item.describe()

task total[T: Sized](items: list[T], scale: float) -> float
    var sum = 0.0
    for item in items
        sum += item.area(scale)
    return sum

task largest[T: Order](items: list[T]) -> T?
    var best: T? = none
    for item in items
        if best is none
            best = item
            continue
        let held = best
        if item > held
            best = item
    return best

task unique[T: Hash](items: list[T]) -> int
    return set(items).len()

task contains[T: Equal](items: list[T], value: T) -> bool
    return value in items

task same[T: Equal](a: T, b: T) -> bool
    return a == b and not (a != b)

task sum[T: Add](a: T, b: T) -> T
    return a + b

task ratio[T: Div](a: T, b: T) -> T
    return a / b

task both[T: Show and Equal](a: T, b: T) -> text
    if a == b
        return "same {a}"
    return "{a} and {b}"

show_all([Dog(name: "Rex"), Dog(name: "Fido")])
show_all([Cat(lives: 9)])
show_all([[1, 2]])
show_all([Has(value: Dog(name: "Max")), Nothing])
print Has(value: Has(value: Cat(lives: 1))).describe()

print total([Circle(radius: 1.0), Square(side: 2.0)], 2.0)

let c = Cat(lives: 9)
print c.older().lives
print c.older(by: 3).older().lives
print c.is_empty()
print c is empty
print Cat(lives: 0) is empty
print [Cat(lives: 1)][0].older().describe()

print largest([3, 9, 2])
print largest(["a", "c", "b"])
print largest([[1, 2], [1, 3]])
let no_items: list[int] = []
print largest(no_items)

print unique([1, 1, 2])
print unique(["a", "a"])
print contains([1.5], 1.5)
print contains([[1]], [2])
print same(1, 1)
print same("a", "b")
print same(none, none)
print same[int?](1, none)
print same([1], [1])
print sum(1, 2)
print sum(1.5, 2.0)
print ratio(1.0, 4.0)
print both(1, 1)
print both("a", "b")
print both([1], [2])

type Money
    cents: int

task add(self: Money, other: Money) -> Money
    return Money(cents: self.cents + other.cents)

task sub(self: Money, other: Money) -> Money
    return Money(cents: self.cents - other.cents)

task mul(self: Money, other: Money) -> Money
    return Money(cents: self.cents * other.cents)

task div(self: Money, other: Money) -> Money
    return Money(cents: self.cents // other.cents)

task show(self: Money) -> text
    return "${self.cents // 100}.{self.cents % 100}"

task equal(self: Money, other: Money) -> bool
    return self.cents // 100 == other.cents // 100

task compare(self: Money, other: Money) -> int
    return other.cents - self.cents

let m = Money(cents: 150)
print m
print "{m}"
print [m]
print m + m
print m - Money(cents: 50)
print m * Money(cents: 2)
print m / Money(cents: 2)
var p = m
p += m
print p
print sum(m, m)
print m == Money(cents: 199)
print m == Money(cents: 200)
print m != Money(cents: 200)
print [m] == [Money(cents: 101)]
print m < Money(cents: 1)
print [m] < [Money(cents: 1)]
print m in [Money(cents: 100)]
print largest([Money(cents: 300), Money(cents: 100)])

type Wrapper[T]
    value: T

task show[T: Show](self: Wrapper[T]) -> text
    return "<{self.value}>"

print Wrapper(value: 1)
print [Wrapper(value: "a")]
