type User
    name: text
    age: int = 0

type Empty
    items: list[int]

choice Shape
    Circle(radius: float)
    Rect(w: float, h: float)
    Point

choice Chain
    Link(value: int, next: Chain)
    End

type Pair[A, B]
    left: A
    right: B

let ada = User(name: "Ada", age: 36)
print ada
print "{ada}!"
print [1, 2, 3]
print ["a", "b\n\"{{"]
print [[1], []]
print {"x": 1, "y": 2}
print set([3, 1, 3])
let none_map: map[int, int] = {}
print none_map
let none_set: set[int] = set([])
print none_set
print Circle(radius: 1.5)
print Rect(h: 2.0, w: 1.0)
print Point
print [Point, Circle(radius: 0.5)]
print Link(value: 1, next: Link(value: 2, next: End))
print Pair(left: 1, right: [Pair(left: "x", right: none)])
print Empty(items: [])

let some: int? = 1
let nothing: int? = none
print some
print nothing
print "{some} {nothing}"
let word: text? = "hi"
print word
print "{word}"
print [word]
print [some, nothing]

print [1, 2] == [1, 2]
print [1, 2] == [1, 3]
print [1, 2] != [1, 2, 3]
print ["a"] == ["a"]
print {"a": 1, "b": 2} == {"b": 2, "a": 1}
print {"a": 1} == {"a": 2}
print {"a": 1} == {"b": 1}
print set([1, 2]) == set([2, 1])
print set([1]) == set([2])
print ada == User(name: "Ada", age: 36)
print ada != User(name: "Ada")
print Point == Point
print Circle(radius: 1.0) == Point
print Circle(radius: 1.0) == Circle(radius: 1.0)
print Link(value: 1, next: End) == Link(value: 1, next: End)
print some == some
print some == nothing
print nothing == nothing
print [some] == [some]
print [0.0 / 0.0] == [0.0 / 0.0]

print [1, 2] < [1, 3]
print [1, 2] < [1, 2, 3]
print [2] > [1, 9]
print [1] <= [1]
print ["a"] >= ["b"]
print ada < User(name: "Ada", age: 37)
print User(name: "B") > ada
print Circle(radius: 9.0) < Rect(w: 0.0, h: 0.0)
print Point > Rect(w: 0.0, h: 0.0)
print Rect(w: 1.0, h: 2.0) < Rect(w: 1.0, h: 3.0)
print Link(value: 1, next: End) < Link(value: 1, next: Link(value: 0, next: End))
print Pair(left: 1, right: "a") < Pair(left: 1, right: "b")

print [1] in [[1], [2]]
print [3] not in [[1], [2]]
print ada in [ada]
print 1.5 in [1.5]
print 0.0 / 0.0 in [0.0 / 0.0]
print some in [some, nothing]
print 1 in [some]
print Point in [Point]

task once() -> text?
    print "ran"
    return "x"
print once()
print "{once()}"
