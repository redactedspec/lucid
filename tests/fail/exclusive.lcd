task bump(change n: int)
    n += 1

task twice(change a: int, change b: int)
    a += b

task share(change a: list[int], b: list[int])
    a.push(b.len())

task add(change a: list[int]) -> int
    a.push(1)
    return a.len()

task grow(change self: list[int])
    self.push(1)

