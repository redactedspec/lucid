# A small website with a page and a JSON endpoint.
use std.http
use std.html as h

type Status
    ok: bool
    version: text

task home(request: http.Request) -> http.Response
    return http.page(h.h1("Hello from Lucid"))

task status(request: http.Request) -> http.Response
    return http.json(Status(ok: true, version: "0.1.0"))

var app = http.App()
app.get("/", home)
app.get("/status", status)
app.serve(port: 8080)
