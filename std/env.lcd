# Environment variables.

unsafe extern task lucid_env_has(name: text) -> bool
unsafe extern task lucid_env_get(name: text) -> text

## The value of a variable, if it is set.
public task get(name: text) -> text?
    # The runtime only reads `name`, and builds a new text.
    unsafe
        if not lucid_env_has(name)
            return none
        return lucid_env_get(name)
