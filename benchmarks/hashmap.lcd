# Insert, find, and remove, with int keys and text keys.
let size = 1000000
var numbers: map[int, int] = {}
for i in 0..size
    numbers[i * 7] = i
var found = 0
for i in 0..size * 2
    if i in numbers
        found += numbers[i]
for i in 0..size
    if i % 2 == 0
        numbers.remove(i * 7)
print found
print numbers.len()

var words: map[text, int] = {}
for i in 0..size // 4
    words["key{i % 5000}"] = i
var hits = 0
for i in 0..size
    let word = "key{i % 10000}"
    if word in words
        hits += 1
print hits
